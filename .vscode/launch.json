{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SplitScript Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/editors/vscode/dist/**/*.js"
      ],
      "preLaunchTask": "build SplitScript extension"
    },
    {
      "name": "Run SplitScript Web Extension",
      "type": "pwa-extensionHost",
      "debugWebWorkerHost": true,
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "--extensionDevelopmentKind=web",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/editors/vscode/dist/web/**/*.js"
      ],
      "preLaunchTask": "build SplitScript extension"
    }
  ]
}
