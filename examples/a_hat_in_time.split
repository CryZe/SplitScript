fn riftCheckpointEnabled(rift: Rift) -> bool {
    if !riftEnabled(rift) {
        return false
    }
    return match rift {
        Rift.PurpleMafiaOfCooks => settings.manySplits_riftPurple_moc_cp,
        Rift.PurpleDeadBirdStudio => settings.manySplits_riftPurple_dbs_cp,
        Rift.PurpleSleepySubcon => settings.manySplits_riftPurple_sleepy_cp,
        Rift.PurpleAlpineSkyline => settings.manySplits_riftPurple_alpine_cp,
        Rift.PurpleDeepSea => settings.manySplits_riftPurple_deepSea_cp,
        Rift.PurpleRumbiFactory => settings.manySplits_riftPurple_rumbi_cp,
        Rift.PurpleTour => settings.manySplits_riftPurple_tour_cp,
        _ => false,
    }
}

fn ilModeEnabled() -> bool {
    return settings.settingsRoot && settings.settings_ILMode
}

fn newFileStartEnabled() -> bool {
    return settings.settingsRoot && settings.settings_newFileStart
}

fn acquiredNewTimePiece(currentCount: i32, oldCount: i32) -> bool {
    return currentCount == oldCount + 1
}

fn acquiredAnyTimePiece(currentFlag: i32, oldFlag: i32) -> bool {
    return currentFlag == 1 && oldFlag == 0
}

fn splitLockElapsed(milliseconds: i64) -> bool {
    let splitAt = lastSplitAt else return true
    return splitAt.hasElapsed(Duration.fromWholeMilliseconds(milliseconds))
}

fn detailedChapterEnabled(chapter: i32) -> bool {
    if !settings.manySplits {
        return false
    }
    return match chapter {
        1 => settings.manySplits_1,
        2 => settings.manySplits_2,
        3 => settings.manySplits_3,
        4 => settings.manySplits_4,
        5 => settings.manySplits_5,
        6 => settings.manySplits_6,
        7 => settings.manySplits_7,
        _ => false,
    }
}

fn detailedActEnabled(chapter: i32, act: i32) -> bool {
    if !detailedChapterEnabled(chapter) {
        return false
    }
    return match chapter * 100 + act {
        101 => settings.manySplits_1_1,
        102 => settings.manySplits_1_2,
        103 => settings.manySplits_1_3,
        104 => settings.manySplits_1_4,
        105 => settings.manySplits_1_5,
        106 => settings.manySplits_1_6,
        107 => settings.manySplits_1_7,
        201 => settings.manySplits_2_1,
        202 => settings.manySplits_2_2,
        203 => settings.manySplits_2_3,
        204 => settings.manySplits_2_4,
        205 => settings.manySplits_2_5,
        206 => settings.manySplits_2_6,
        301 => settings.manySplits_3_1,
        302 => settings.manySplits_3_2,
        303 => settings.manySplits_3_3,
        304 => settings.manySplits_3_4,
        305 => settings.manySplits_3_5,
        306 => settings.manySplits_3_6,
        601 => settings.manySplits_6_1,
        602 => settings.manySplits_6_2,
        603 => settings.manySplits_6_3,
        _ => chapter == 4 || chapter == 5 || chapter == 7,
    }
}

fn detailedTimePieceEnabled(chapter: i32, act: i32) -> bool {
    if !detailedActEnabled(chapter, act) {
        return false
    }
    return match chapter * 100 + act {
        101 => settings.manySplits_1_1_tp,
        102 => settings.manySplits_1_2_tp,
        103 => settings.manySplits_1_3_tp,
        104 => settings.manySplits_1_4_tp,
        105 => settings.manySplits_1_5_tp,
        106 => settings.manySplits_1_6_tp,
        107 => settings.manySplits_1_7_tp,
        201 => settings.manySplits_2_1_tp,
        202 => settings.manySplits_2_2_tp,
        203 => settings.manySplits_2_3_tp,
        204 => settings.manySplits_2_4_tp,
        205 => settings.manySplits_2_5_tp,
        206 => settings.manySplits_2_6_tp,
        301 => settings.manySplits_3_1_tp,
        302 => settings.manySplits_3_2_tp,
        303 => settings.manySplits_3_3_tp,
        304 => settings.manySplits_3_4_tp,
        305 => settings.manySplits_3_5_tp,
        306 => settings.manySplits_3_6_tp,
        601 => settings.manySplits_6_1_tp,
        602 => settings.manySplits_6_2_tp,
        603 => settings.manySplits_6_3_tp,
        _ => match chapter {
            4 => settings.manySplits_4_tp,
            5 => settings.manySplits_5_tp,
            7 => settings.manySplits_7_tp,
            _ => false,
        },
    }
}

