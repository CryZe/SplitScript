        Rift.BlueOwlExpress => settings.manySplits_riftBlue_owlExpress_tp,
        Rift.BlueMoon => settings.manySplits_riftBlue_moon_tp,
        Rift.BlueVillage => settings.manySplits_riftBlue_village_tp,
        Rift.BluePipe => settings.manySplits_riftBlue_pipe_tp,
        Rift.BlueTwilightBell => settings.manySplits_riftBlue_twilight_tp,
        Rift.BlueCurlyTailTrail => settings.manySplits_riftBlue_curly_tp,
        Rift.BlueBalcony => settings.manySplits_riftBlue_balcony_tp,
        Rift.BlueLab => settings.manySplits_riftBlue_lab_tp,
        Rift.BlueGallery => settings.manySplits_riftBlue_gallery_tp,
