        104 => settings.manySplits_1_4_tpDelayed,
        105 => settings.manySplits_1_5_tpDelayed,
        106 => settings.manySplits_1_6_tpDelayed,
        107 => settings.manySplits_1_7_tpDelayed,
        201 => settings.manySplits_2_1_tpDelayed,
        202 => settings.manySplits_2_2_tpDelayed,
        203 => settings.manySplits_2_3_tpDelayed,
        204 => settings.manySplits_2_4_tpDelayed,
        205 => settings.manySplits_2_5_tpDelayed,
        206 => settings.manySplits_2_6_tpDelayed,
        301 => settings.manySplits_3_1_tpDelayed,
        302 => settings.manySplits_3_2_tpDelayed,
        303 => settings.manySplits_3_3_tpDelayed,
        304 => settings.manySplits_3_4_tpDelayed,
