fn resolvePath(path: MemoryPath?) -> address! {
    let initialized = path else return Err("path not initialized")
    return initialized.resolve()
}

fn Bounds.containsWithIgnoredAxes(x: f32, y: f32, z: f32) -> bool {
    return(self.minX == -2.0 || x > self.minX)
        && (self.maxX == -2.0 || x < self.maxX)
        && (self.minY == -2.0 || y > self.minY)
        && (self.maxY == -2.0 || y < self.maxY)
        && (self.minZ == -2.0 || z > self.minZ)
        && (self.maxZ == -2.0 || z < self.maxZ)
}

fn positionTarget(key: i32) -> Bounds? {
    for target in positionTargets {
        if target.key == key {
            return target.bounds
        }
    }
    return None
}

fn positionSettingEnabled(key: i32) -> bool {
    if !detailedChapterEnabled(if key == 5 {
            5
    } else {
            4
    })
    {
        return false
    }
    return match key {
        5 => settings.manySplits_pos_5,
        40 => settings.manySplits_pos_40,
        41 => settings.manySplits_pos_41,
        42 => settings.manySplits_pos_42,
        43 => settings.manySplits_pos_43,
        44 => settings.manySplits_pos_44,
        45 => settings.manySplits_pos_45,
        _ => false,
    }
}

fn shouldSplitAtPosition(key: i32, x: f32, y: f32, z: f32) -> bool {
    if key == 0 || !positionSettingEnabled(key) {
        return false
    }
    let target = positionTarget(key) else return false
    return target.containsWithIgnoredAxes(x, y, z)
}

fn pausePositionEnabled(kind: PausePosition) -> bool {
    return match kind {
        PausePosition.MafiaHeadquarters => settings.manySplits_1
        && settings.manySplits_1_4
        && settings.manySplits_1_4_cp0_pause_pos,
        PausePosition.BasementBoss => settings.manySplits_2
        && settings.manySplits_2_6
        && settings.manySplits_2_6_cp0_pause_pos,
        PausePosition.SubconWell => settings.manySplits_3
        && settings.manySplits_3_2
        && settings.manySplits_3_2_cp0_pause_pos,
        PausePosition.VanessaManor => settings.manySplits_3
        && settings.manySplits_3_4
        && settings.manySplits_3_4_cp0_pause_pos,
        PausePosition.AlpineIntro => settings.manySplits_4
        && settings.manySplits_4_99_cp0_pause_pos,
    }
}

fn shouldSplitAtPausePosition(chapter: i32, x: f32, y: f32, z: f32) -> bool {
    for location in pauseLocations {
        if location.chapter == chapter
            && pausePositionEnabled(location.kind)
            && location.bounds.containsWithIgnoredAxes(x, y, z)
        {
            return true
        }
    }
    return false
}

fn detectRift(chapter: i32, x: f32, y: f32, z: f32) -> Rift {
    for location in riftLocations {
        if (location.chapter == 0 || location.chapter == chapter)
            && location.bounds.containsWithIgnoredAxes(x, y, z)
        {
            return location.rift
        }
    }
    return Rift.None
}

fn isBackAtHub(chapter: i32, x: f32, y: f32, z: f32) -> bool {
    for location in hubLocations {
        if (location.chapter == 0 || location.chapter == chapter)
            && location.bounds.containsWithIgnoredAxes(x, y, z)
        {
            return true
        }
    }
    return false
}

fn riftEnabled(rift: Rift) -> bool {
    if !settings.manySplits {
        return false
    }
    return match rift {
        Rift.None => false,
        Rift.PurpleMafiaOfCooks => settings.manySplits_riftPurple
        && settings.manySplits_riftPurple_moc,
        Rift.PurpleDeadBirdStudio => settings.manySplits_riftPurple
        && settings.manySplits_riftPurple_dbs,
        Rift.PurpleSleepySubcon => settings.manySplits_riftPurple
        && settings.manySplits_riftPurple_sleepy,
        Rift.PurpleAlpineSkyline => settings.manySplits_riftPurple
        && settings.manySplits_riftPurple_alpine,
        Rift.PurpleDeepSea => settings.manySplits_riftPurple
        && settings.manySplits_riftPurple_deepSea,
        Rift.PurpleRumbiFactory => settings.manySplits_riftPurple
        && settings.manySplits_riftPurple_rumbi,
        Rift.PurpleTour => settings.manySplits_riftPurple
        && settings.manySplits_riftPurple_tour,
        Rift.BlueSewers => settings.manySplits_riftBlue
        && settings.manySplits_riftBlue_sewers,
        Rift.BlueBazaar => settings.manySplits_riftBlue
        && settings.manySplits_riftBlue_bazaar,
        Rift.BlueOwlExpress => settings.manySplits_riftBlue
        && settings.manySplits_riftBlue_owlExpress,
        Rift.BlueMoon => settings.manySplits_riftBlue
        && settings.manySplits_riftBlue_moon,
        Rift.BlueVillage => settings.manySplits_riftBlue
        && settings.manySplits_riftBlue_village,
        Rift.BluePipe => settings.manySplits_riftBlue
        && settings.manySplits_riftBlue_pipe,
        Rift.BlueTwilightBell => settings.manySplits_riftBlue
        && settings.manySplits_riftBlue_twilight,
        Rift.BlueCurlyTailTrail => settings.manySplits_riftBlue
        && settings.manySplits_riftBlue_curly,
        Rift.BlueBalcony => settings.manySplits_riftBlue
        && settings.manySplits_riftBlue_balcony,
        Rift.BlueLab => settings.manySplits_riftBlue
        && settings.manySplits_riftBlue_lab,
        Rift.BlueGallery => settings.manySplits_riftBlue
        && settings.manySplits_riftBlue_gallery,
    }
}

fn riftTimePieceEnabled(rift: Rift) -> bool {
    if !riftEnabled(rift) {
        return false
    }
    return match rift {
        Rift.None => false,
        Rift.PurpleMafiaOfCooks => settings.manySplits_riftPurple_moc_tp,
        Rift.PurpleDeadBirdStudio => settings.manySplits_riftPurple_dbs_tp,
