}

fn riftEntryEnabled(rift: Rift) -> bool {
    if !riftEnabled(rift) {
        return false
    }
    return match rift {
        Rift.None => false,
        Rift.PurpleMafiaOfCooks => settings.manySplits_riftPurple_moc_entry,
        Rift.PurpleDeadBirdStudio => settings.manySplits_riftPurple_dbs_entry,
        Rift.PurpleSleepySubcon => settings.manySplits_riftPurple_sleepy_entry,
        Rift.PurpleAlpineSkyline => settings.manySplits_riftPurple_alpine_entry,
        Rift.PurpleDeepSea => settings.manySplits_riftPurple_deepSea_entry,
        Rift.PurpleRumbiFactory => settings.manySplits_riftPurple_rumbi_entry,
        Rift.PurpleTour => settings.manySplits_riftPurple_tour_entry,
