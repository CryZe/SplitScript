fn detailedCheckpointEnabled(chapter: i32, act: i32, checkpoint: i32) -> bool {
    if !detailedActEnabled(chapter, act) {
        return false
    }
    return match chapter * 10000 + act * 100 + checkpoint {
        10101 => settings.manySplits_1_1_cp1,
        10201 => settings.manySplits_1_2_cp1,
        10301 => settings.manySplits_1_3_cp1,
        10401 => settings.manySplits_1_4_cp1,
        10402 => settings.manySplits_1_4_cp2,
        20105 => settings.manySplits_2_1_cp5,
        20401 => settings.manySplits_2_4_cp1,
        20404 => settings.manySplits_2_4_cp4,
        20501 => settings.manySplits_2_5_cp1,
        20502 => settings.manySplits_2_5_cp2,
        20503 => settings.manySplits_2_5_cp3,
        30301 => settings.manySplits_3_3_cp1,
        30601 => settings.manySplits_3_6_cp1,
        50101 => settings.manySplits_5_1_cp1,
        50102 => settings.manySplits_5_1_cp2,
        50103 => settings.manySplits_5_1_cp3,
        50110 => settings.manySplits_5_1_cp10,
        60103 => settings.manySplits_6_1_cp3,
        60201 => settings.manySplits_6_2_cp1,
        60301 => settings.manySplits_6_3_cp1,
        60302 => settings.manySplits_6_3_cp2,
        60303 => settings.manySplits_6_3_cp3,
        _ => false,
    }
}

fn detailedPauseCheckpointEnabled(chapter: i32, act: i32, checkpoint: i32) -> bool {
    return detailedActEnabled(chapter, act)
        && chapter == 1
        && act == 6
        && checkpoint == 59
        && settings.manySplits_1_6_cp59_pause
}

fn shouldDetailedSplit(currentState, oldState) -> bool {
    if !settings.manySplits {
        return false
    }

    let gotTimePiece = acquiredNewTimePiece(
        currentState.timePieceCount,
        oldState.timePieceCount,
    ) || acquiredAnyTimePiece(currentState.justGotTimePiece, oldState.justGotTimePiece)

    if currentRift == Rift.None {
        return gotTimePiece
            && detailedTimePieceEnabled(currentState.chapter, currentState.act)
            || currentState.checkpoint != oldState.checkpoint
            && detailedCheckpointEnabled(
            currentState.chapter,
            currentState.act,
            currentState.checkpoint,
        )
            || shouldSplitAtPosition(
            positionSplitKey,
            currentState.x,
            currentState.y,
            currentState.z,
        )
            || splitInLoadScreen
            && currentState.gameTimerIsPaused == 1
            && oldState.gameTimerIsPaused == 0
            || currentState.actTimerIsVisible == 1
            && oldState.actTimerIsVisible == 0
            && !ilModeEnabled()
            && detailedEntryEnabled(currentState.chapter, currentState.act)
            || currentState.gameTimerIsPaused == 1
            && oldState.gameTimerIsPaused == 0
            && detailedPauseCheckpointEnabled(
            currentState.chapter,
            currentState.act,
            currentState.checkpoint,
        )
            || currentState.gameTimerIsPaused != oldState.gameTimerIsPaused
            && shouldSplitAtPausePosition(
            currentState.chapter,
            currentState.x,
            currentState.y,
            currentState.z,
        )
    }

    return gotTimePiece && riftTimePieceEnabled(currentRift)
        || currentState.checkpoint > oldState.checkpoint
        && riftCheckpointEnabled(currentRift)
        || justEnteredRift
        && riftEntryEnabled(currentRift)
        && !ilModeEnabled()
        && splitLockElapsed(3000)
}

onAttach {
    timerBase = await process.scanMemory(
        sig"54 49 4D 52 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 45 4E 44 20"
    )

    let saveData = await process.scanMemoryAny([
        sig"48 8B 1D ?? ?? ?? ?? 48 85 DB 74 ?? 48 8B 5B ?? 48 85 DB 74 ??",
        sig"48 8B 05 ?? ?? ?? ?? 48 8B 74 24 ?? 48 83 C4 50",
        sig"48 8B 05 ?? ?? ?? ?? 48 8B D9 48 85 C0 75 ?? 48 89 7C 24 ??",
        sig"48 8B 05 ?? ?? ?? ?? 48 8B 7C 24 ?? 48 83 C4 40",
    ])
    saveDataLayout = match saveData.index {
        0 => SaveDataLayout.DLC,
        1 => SaveDataLayout.DLC,
        2 => SaveDataLayout.Modding,
        _ => SaveDataLayout.Release,
    }
    let saveDataRoot = retry process.readRelative32(saveData.address + 3)

    let actorsSignature = await process.scanMemory(
        sig"48 8B 05 ?? ?? ?? ?? 81 88 ?? ?? ?? ?? 00 00 80 00"
    )
    let actorsRoot = retry process.readRelative32(actorsSignature + 3)
    let coordinatesSignature = await process.scanMemory(
        sig"48 8B 81 ?? ?? ?? ?? 4C 8D 80 ?? ?? ?? ??"
    )
    let hatKidOffset = retry process.read<u32>(coordinatesSignature + 3) as u64

    while true {
        let saveDataPointer = retry process.read<address>(saveDataRoot)
        let actorsPointer = retry process.read<address>(actorsRoot)
        if saveDataPointer != 0 && actorsPointer != 0 {
            break
        }
        await nextTick()
    }

    let offsets = saveDataOffsets(saveDataLayout)
    yarnPath = saveDataRoot.memoryPath([offsets.root], offsets.yarn, PointerSize.Bit64)
    chapterPath = saveDataRoot.memoryPath([offsets.root], offsets.chapter, PointerSize.Bit64)
    actPath = saveDataRoot.memoryPath([offsets.root], offsets.act, PointerSize.Bit64)
    checkpointPath = saveDataRoot.memoryPath(
        [offsets.root],
        offsets.checkpoint,
        PointerSize.Bit64,
    )
    xPath = actorsRoot.memoryPath([0x6dc, 0, 0x68, hatKidOffset], 0x80, PointerSize.Bit64)
    yPath = actorsRoot.memoryPath([0x6dc, 0, 0x68, hatKidOffset], 0x84, PointerSize.Bit64)
    zPath = actorsRoot.memoryPath([0x6dc, 0, 0x68, hatKidOffset], 0x88, PointerSize.Bit64)

    observedSplitIndex = timer.currentSplitIndex()
    lastSplitAt = Instant.now()
}

whileAttached {
    let splitIndex = timer.currentSplitIndex()
    if observedSplitIndex >= 0 && splitIndex > observedSplitIndex {
        lastSplitAt = Instant.now()
        positionSplitKey = 0
    }
    observedSplitIndex = splitIndex

    if current.chapter != old.chapter {
        lastChapter = old.chapter
    }

    gameTimeFinal = current.realGameTime

    if current.actTimerIsVisible == 1 && old.actTimerIsVisible == 0 {
        savedGameTime = current.gameTime
    }

    if acquiredNewTimePiece(current.timePieceCount, old.timePieceCount)
        || acquiredAnyTimePiece(current.justGotTimePiece, old.justGotTimePiece)
    {
        if detailedDelayedTimePieceEnabled(current.chapter, current.act) {
            splitInLoadScreen = true
        }

        let preciseGameTime = savedGameTime + current.realActTime
        if preciseGameTime > current.realGameTime - 0.1
            && preciseGameTime < current.realGameTime + 0.1
        {
            gameTimeFinal = preciseGameTime
        }
    }

    if current.gameTimerIsPaused == 0 && old.gameTimerIsPaused == 1 {
        splitInLoadScreen = false
        positionSplitKey = 0
        if isBackAtHub(current.chapter, current.x, current.y, current.z) {
            currentRift = Rift.None
        }
    }

    if current.timerState == 0 && currentRift != Rift.None {
        currentRift = Rift.None
    }

    if justEnteredRift {
        justEnteredRift = false
    }

    if current.gameTimerIsPaused != old.gameTimerIsPaused
        && currentRift == Rift.None
        && settings.manySplits
    {
        currentRift = detectRift(current.chapter, current.x, current.y, current.z)
        if currentRift != Rift.None {
            justEnteredRift = true
        }
    }

    if current.chapter == 4 || current.chapter == 5 {
        for location in positionKeyLocations {
            if location.chapter == current.chapter
                && location.bounds.containsWithIgnoredAxes(current.x, current.y, current.z)
            {
                positionSplitKey = location.key
            }
        }
    }
}

start {
    return newFileStartEnabled()
        && current.timerState == 1
        && old.timerState == 0
        && (current.timePieceCount == 0 || current.timePieceCount == -1)
        || !newFileStartEnabled()
        && current.timerState == 1
        && old.timerState == 0
        || ilModeEnabled()
        && current.actTimerIsVisible == 1
        && current.realActTime == 0.0
}

split {
    if !splitLockElapsed(1000) || current.timerState == 0 {
        return false
    }

    if settings.splits {
        if acquiredNewTimePiece(current.timePieceCount, old.timePieceCount)
            && settings.splits_tp
            && settings.splits_tp_new
        {
            return true
        }
        if acquiredAnyTimePiece(current.justGotTimePiece, old.justGotTimePiece)
            && settings.splits_tp
            && settings.splits_tp_any
        {
            return true
        }
        if current.actTimerIsVisible == 1
            && old.actTimerIsVisible == 0
            && currentRift == Rift.None
            && settings.splits_actEntry
            && !ilModeEnabled()
        {
            return true
        }
        if acquiredAnyTimePiece(current.justGotTimePiece, old.justGotTimePiece)
            && current.chapter == 3
            && lastChapter == 5
            && settings.splits_tp
            && settings.splits_tp_std
        {
            return true
        }
        if current.chapter == 97
            && old.chapter != 97
            && settings.splits_dwbth
            && (!settings.splits_dwbth_doubleSplitNo || splitLockElapsed(9000))
        {
            return true
        }
        if current.yarn == old.yarn + 1 && settings.splits_yarn {
            return true
        }
        if current.checkpoint != old.checkpoint
            && current.checkpoint != 0
            && settings.splits_checkpoint
        {
            return true
        }
    }

    return shouldDetailedSplit(current, old)
}

reset {
    return current.timerState == 0 && old.timerState == 1
        || ilModeEnabled()
        && (current.actTimerIsVisible == 0 && old.actTimerIsVisible == 1
        || current.realActTime < old.realActTime && current.realActTime == 0.0)
}

isLoading {
    return true
}

gameTime {
    return Duration.fromSeconds(
        if ilModeEnabled() {
            current.realActTime
        } else {
            gameTimeFinal
        }
    )
}
