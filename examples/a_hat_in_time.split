fn detailedEntryEnabled(chapter: i32, act: i32) -> bool {
    if !detailedActEnabled(chapter, act) {
        return false
    }
    return match chapter * 100 + act {
        101 => settings.manySplits_1_1_entry,
        102 => settings.manySplits_1_2_entry,
        103 => settings.manySplits_1_3_entry,
        104 => settings.manySplits_1_4_entry,
        105 => settings.manySplits_1_5_entry,
        106 => settings.manySplits_1_6_entry,
        107 => settings.manySplits_1_7_entry,
        201 => settings.manySplits_2_1_entry,
        202 => settings.manySplits_2_2_entry,
        203 => settings.manySplits_2_3_entry,
        204 => settings.manySplits_2_4_entry,
        205 => settings.manySplits_2_5_entry,
        206 => settings.manySplits_2_6_entry,
        301 => settings.manySplits_3_1_entry,
        302 => settings.manySplits_3_2_entry,
        303 => settings.manySplits_3_3_entry,
        304 => settings.manySplits_3_4_entry,
        305 => settings.manySplits_3_5_entry,
        306 => settings.manySplits_3_6_entry,
        499 => settings.manySplits_4_99_entry,
        601 => settings.manySplits_6_1_entry,
        602 => settings.manySplits_6_2_entry,
        603 => settings.manySplits_6_3_entry,
