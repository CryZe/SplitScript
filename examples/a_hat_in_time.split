fn saveDataOffsets(layout) {
    return match layout {
        SaveDataLayout.DLC => SaveDataOffsets {
            root: 0x68,
            yarn: 0xf0,
            chapter: 0x108,
            act: 0x10c,
            checkpoint: 0x110,
        },
        SaveDataLayout.Modding => SaveDataOffsets {
            root: 0x64,
            yarn: 0xe0,
            chapter: 0xf8,
            act: 0xfc,
            checkpoint: 0x100,
        },
        SaveDataLayout.Release => SaveDataOffsets {
            root: 0x64,
            yarn: 0xe0,
            chapter: 0xf4,
            act: 0xf8,
            checkpoint: 0xfc,
        },
    }
}

state "HatinTimeGame" {
    timerState: i32 = process.read(timerBase + 0x04)?;
    unpauseTime: f64 = process.read(timerBase + 0x08)?;
    gameTimerIsPaused: i32 = process.read(timerBase + 0x10)?;
    actTimerIsPaused: i32 = process.read(timerBase + 0x14)?;
    actTimerIsVisible: i32 = process.read(timerBase + 0x18)?;
    unpauseTimeIsDirty: i32 = process.read(timerBase + 0x1c)?;
    justGotTimePiece: i32 = process.read(timerBase + 0x20)?;
    gameTime: f64 = process.read(timerBase + 0x24)?;
    actTime: f64 = process.read(timerBase + 0x2c)?;
    realGameTime: f64 = process.read(timerBase + 0x34)?;
    realActTime: f64 = process.read(timerBase + 0x3c)?;
    timePieceCount: i32 = process.read(timerBase + 0x44)?;
    yarn: i32 = process.read(resolvePath(yarnPath)?)?;
    chapter: i32 = process.read(resolvePath(chapterPath)?)?;
    act: i32 = process.read(resolvePath(actPath)?)?;
    checkpoint: i32 = process.read(resolvePath(checkpointPath)?)?;
    x: f32 = process.read(resolvePath(xPath)?)?;
    y: f32 = process.read(resolvePath(yPath)?)?;
    z: f32 = process.read(resolvePath(zPath)?)?;
}

