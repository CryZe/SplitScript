/// Save-data layouts selected by runtime signature discovery.
enum SaveDataLayout {
    DLC,
    Modding,
    Release,
}

/// Time rift currently occupied by Hat Kid.
enum Rift {
    None,
    PurpleMafiaOfCooks,
    PurpleDeadBirdStudio,
    PurpleSleepySubcon,
    PurpleAlpineSkyline,
    PurpleDeepSea,
    PurpleRumbiFactory,
    PurpleTour,
    BlueSewers,
    BlueBazaar,
    BlueOwlExpress,
    BlueMoon,
    BlueVillage,
    BluePipe,
    BlueTwilightBell,
    BlueCurlyTailTrail,
    BlueBalcony,
    BlueLab,
    BlueGallery,
}

/// Patch-dependent offsets below the discovered save-data pointer.
record SaveDataOffsets {
    root: u64,
    yarn: u64,
    chapter: u64,
    act: u64,
    checkpoint: u64,
}

/// Axis-aligned world-space trigger volume.
record Bounds {
    minX: f32,
    maxX: f32,
    minY: f32,
    maxY: f32,
    minZ: f32,
    maxZ: f32,
}

/// Volume that arms a later position split.
record PositionKeyLocation {
    chapter: i32,
    key: i32,
    bounds: Bounds,
}

/// Destination volume associated with an armed position split.
record PositionTarget {
    key: i32,
    bounds: Bounds,
}

/// Rift identity and one of the world-space volumes that identifies it.
record RiftLocation {
    /// Zero means the location is valid in every chapter.
    chapter: i32,
    rift: Rift,
    bounds: Bounds,
}

/// Chapter-qualified world-space location, with zero meaning every chapter.
record ChapterLocation {
    chapter: i32,
    bounds: Bounds,
}

/// Pause transition whose position can produce a detailed split.
enum PausePosition {
    MafiaHeadquarters,
    BasementBoss,
    SubconWell,
    VanessaManor,
    AlpineIntro,
}

/// Chapter-specific pause transition volume.
record PauseLocation {
    chapter: i32,
    kind: PausePosition,
    bounds: Bounds,
}

