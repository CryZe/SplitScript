/// Checks one mission endpoint against the player's rounded position.
fn atMissionPoint(point: MissionPoint, y: f64, z: f64, x: f64) -> bool {
    return y ==(point.y as f64).roundTo(3)
        && z ==(point.z as f64).roundTo(3)
        && x ==(point.x as f64).roundTo(3)
}

/// Finds an enabled mission endpoint at the current rounded position.
fn matchesMission(points: [MissionPoint], y: f64, z: f64, x: f64) -> bool {
    for point in points {
        if settings.enabled(point.settingKey) && atMissionPoint(point, y, z, x) {
            return true
        }
    }
    return false
}

split {
    // ASL's Math.Round promotes the memory-facing f32 values to f64.
    let y =(current.positionY as f64).roundTo(3)
    let z =(current.positionZ as f64).roundTo(3)
    let x =(current.positionX as f64).roundTo(3)

    if settings.mission0
        && current.missionCounter == 0
        && current.mapNumber == 3
        && old.mapNumber == 25
    {
        return true
    }

    if settings.mission500
        && current.mapNumber == 1
        &&(current.trainEnd == 223 || current.trainEnd == 151)
        && current.missionCounter == 0
    {
        return true
    }

    let missionCompleted = current.missionCounter != old.missionCounter
    if missionCompleted {
        if settings.chapter1 && matchesMission(chapter1Points, y, z, x) {
            return true
        }
        if settings.chapter2
            &&(matchesMission(chapter2Points, y, z, x)
            || matchesMission(chapter2ZenyaPoints, y, z, x))
        {
            return true
        }
        if settings.chapter3Shizuku
            && matchesMission(chapter3ShizukuPoints, y, z, x)
        {
            return true
        }
        if settings.chapter3Tohko && matchesMission(chapter3TohkoPoints, y, z, x) {
            return true
        }
        if settings.chapter3Rin && matchesMission(chapter3RinPoints, y, z, x) {
            return true
        }
        if settings.chapter3Shion {
            if matchesMission(chapter3ShionPoints, y, z, x) {
                return true
            }
            if settings.mission424
                && current.mapNumber == 13
                && y >= 1.0 && y <= 2.0
                && z >= 60.0 && z <= 61.0
                && x >= 46.0 && x <= 47.0
            {
                return true
            }
            if settings.mission429
                && current.mapNumber == 16
                && y >= -1.0 && y <= 1.0
                && z >= 2.0 && z <= 4.0
                && x >= -11.0 && x <= -9.0
            {
                return true
            }
            if settings.mission430
                && current.mapNumber == 5
                && y >= 1.0 && y <= 3.0
                && z >= 14.0 && z <= 20.0
                && x >= -165.0 && x <= -155.0
            {
                return true
            }
            if settings.mission431
                && current.mapNumber == 3
                && y >= 1.0 && y <= 3.0
                && z >= -20.0 && z <= -5.0
                && x >= 6.0 && x <= 12.0
            {
                return true
            }
        }
    }

    if settings.endings
        &&(settings.mission28 || settings.mission432)
        && y == 1.0
        && z == 0.0
        && x == 0.0
        && current.creditsStart == 111
    {
        return current.creditsStart != old.creditsStart
    }
}
