// ARTIFICIAL stores its autosplitter values in one managed static class. The
// Unity schema binds its fields once and exposes fallible typed reads.
image "Assembly-CSharp" {
    class AutoSplitterData {
        static f64 inGameTime;
        static i32 levelId from "levelID";
        static bool isRunning;
    }
}

state Unity.mono(MonoVersion.V2) ["ARTIFICIAL.exe"] {
    /// Total in-game time reported by the game.
    inGameTime: f64 = AutoSplitterData.inGameTime?;
    /// Identifier of the currently active level.
    levelId: i32 = AutoSplitterData.levelId?;
    /// Whether an active run is in progress.
    isRunning: bool = AutoSplitterData.isRunning?;
}

start {
    return !old.isRunning && current.isRunning
}

split {
    return old.levelId < current.levelId && current.isRunning
}

reset {
    return old.isRunning && !current.isRunning
}

gameTime {
    return Duration.fromSeconds(current.inGameTime)
}

isLoading {
    return true
}
