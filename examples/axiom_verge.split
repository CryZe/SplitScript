/// Resolves a layout path after attachment has initialized it.
fn resolvePath(path: MemoryPath) -> address! {
    return path.resolve()
}

/// Returns the layout selected during attachment.
fn selectedLayout() -> AxiomVergeLayout! {
    let initialized = layout else return Err("Axiom Verge layout is not initialized")
    return initialized
}

/// Applies the recursive parent-setting behavior used by legacy ASL.
fn eventEnabled(key: String) -> bool {
    if bossSettingKeys.contains(key) {
        return settings.bosses && settings.enabled(key)
    }
    if weaponSettingKeys.contains(key) {
        return settings.weapons && settings.enabled(key)
    }
    if toolSettingKeys.contains(key) {
        return settings.tools && settings.enabled(key)
    }
    if key.startsWith("HealthNode") {
        return settings.healthNodes && settings.enabled(key)
    }
    if key.startsWith("PowerNode") {
        return settings.powerNodes && settings.enabled(key)
    }
    if key.startsWith("SizeNode") {
        return settings.sizeNodes && settings.enabled(key)
    }
    if key.startsWith("RangeNode") {
        return settings.rangeNodes && settings.enabled(key)
    }
    if key.startsWith("Note") {
        return settings.notes && settings.enabled(key)
    }
    return settings.enabled(key)
}

/// Reads a UTF-16 checkpoint identifier by its zero-based index.
fn readCheckpoint(index: i32) -> String! {
    let indexOffset = (index * 4 + 8) as i64
    let lengthPath = gameRoot.memoryPath(
        [0xe0, 0x48, 0x4, indexOffset, 0xc],
        0x4,
        PointerSize.Bit32,
    )
    let length = process.read<i32>(lengthPath.resolve()?)?
    if length < 0 {
        return Err("checkpoint identifier has a negative length")
    }
    let textPath = gameRoot.memoryPath(
        [0xe0, 0x48, 0x4, indexOffset, 0xc],
        0x8,
        PointerSize.Bit32,
    )
    return process.readUtf16Le(textPath.resolve()?, length as u32)
}

/// Reads a UTF-16 collected-item identifier by its zero-based index.
fn readItem(index: i32) -> String! {
    let indexOffset = (index * 4 + 8) as i64
    let lengthPath = gameRoot.memoryPath(
        [0xe0, 0x30, 0x4, indexOffset, 0x4],
        0x4,
        PointerSize.Bit32,
    )
    let length = process.read<i32>(lengthPath.resolve()?)?
    if length < 0 {
        return Err("item identifier has a negative length")
    }
    let textPath = gameRoot.memoryPath(
        [0xe0, 0x30, 0x4, indexOffset, 0x4],
        0x8,
        PointerSize.Bit32,
    )
    return process.readUtf16Le(textPath.resolve()?, length as u32)
}

/// Reads a validated UTF-16 key-point identifier by its zero-based index.
fn readKeyPoint(index: i32) -> String! {
    let indexOffset = (index * 4 + 8) as i64
    let lengthPath = gameRoot.memoryPath(
        [0xe0, 0x34, 0x4, indexOffset],
        0x4,
        PointerSize.Bit32,
    )
    let length = process.read<i32>(lengthPath.resolve()?)?
    if length < 4 || length > 50 {
        return Err(`invalid key-point identifier length {length}`)
    }
    let textPath = gameRoot.memoryPath(
        [0xe0, 0x34, 0x4, indexOffset],
        0x8,
        PointerSize.Bit32,
    )
    return process.readUtf16Le(textPath.resolve()?, length as u32)
}

onAttach {
    print("Axiom Verge auto splitter 0.3")

    let steam = match process.loadedModule("steam_api.dll") {
        Some(_) => true,
        None => false,
    }
    let distribution = if steam {
        "Steam"
    } else {
        "Epic"
    }
    print(`{process.name()} ({distribution} version)`)

    let axiomClass = (await process.scanMemory(
        sig"?? ?? ?? ?? 04 00 00 00 00 00 00 00 00 00 00 00 ?? ?? ?? ?? F8 07 00 00"
    )).offset(4)
    print(`Found static Game members at {axiomClass}`)

    let vanilla = process.name() == "AxiomVerge.exe"
    let platformOffset = if vanilla {
        if steam {
            0x144
        } else {
            0xb0
        }
    } else if steam {
        0x50
    } else {
        0x24
    }
    gameRoot = axiomClass.offset(platformOffset)
    layout = AxiomVergeLayout {
        maxHealth: gameRoot.memoryPath([0xe0], 0xb4, PointerSize.Bit32),
        ticks: gameRoot.memoryPath([0xe0], 0xc, PointerSize.Bit32),
        checkpointCount: gameRoot.memoryPath([0xe0, 0x48], 0xc, PointerSize.Bit32),
        itemCount: gameRoot.memoryPath([0xe0, 0x30], 0xc, PointerSize.Bit32),
        keyPointCount: gameRoot.memoryPath([0xe0, 0x34], 0xc, PointerSize.Bit32),
    }
}

onDetach {
    layout = None
    gameRoot = 0x0
    lastTimerState = TimerState.NotRunning
}

whileAttached {
    let timerState = timer.state()
    if lastTimerState == TimerState.NotRunning && timerState != TimerState.NotRunning {
        print("--Start--")
        lastCheckpoint = 0
        lastItem = 0
        lastKeyPoint = 0
        resetRequested = false
    }
    lastTimerState = timerState
}

gameTime {
    return Duration.fromSeconds(current.ticks / 60.0)
}

start {
    return current.ticks < 60.0 && current.ticks > 1.0 && current.itemCount == 0
}

reset {
    return resetRequested
}

split {
    if current.checkpointCount > lastCheckpoint {
        let checkpoint = readCheckpoint(lastCheckpoint) else ""
        if !checkpoint.isEmpty() && settings.contains(checkpoint) {
            print(`Checkpoint: {checkpoint}`)
            lastCheckpoint += 1
            return eventEnabled(checkpoint)
        }
    }

    if current.itemCount > lastItem {
        let item = readItem(lastItem) else ""
        if !item.isEmpty() && settings.contains(item) {
            print(`Item: {item}`)
            lastItem += 1
            return eventEnabled(item)
        }
    }

    if current.keyPointCount > lastKeyPoint {
        let keyPoint = readKeyPoint(lastKeyPoint) else ""
        if !keyPoint.isEmpty() && keyPoint != "Sentinel" {
            print(`Key point: {keyPoint}`)
            lastKeyPoint += 1
            if settings.contains(keyPoint) {
                return eventEnabled(keyPoint)
            }
            if keyPoint == "FirstDeath" && settings.resetOnDeath {
                resetRequested = true
            }
        }
    }

    return false
}
