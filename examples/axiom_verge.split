/// Describes the memory paths discovered for the active executable build.
record AxiomVergeLayout {
    /// The player's maximum-health value.
    maxHealth: MemoryPath,
    /// The game's sixty-hertz elapsed tick counter.
    ticks: MemoryPath,
    /// The number of checkpoint identifiers recorded by the game.
    checkpointCount: MemoryPath,
    /// The number of collected item identifiers recorded by the game.
    itemCount: MemoryPath,
    /// The number of key-point identifiers recorded by the game.
    keyPointCount: MemoryPath,
}

state ["AxiomVerge.exe", "RandomAV.exe"] {
    /// The player's current maximum health.
    _maxHealth: i32 = process.read(resolvePath(selectedLayout()?.maxHealth)?)?;
    /// The game's elapsed time measured in sixty-hertz ticks.
    ticks: f64 = process.read(resolvePath(selectedLayout()?.ticks)?)?;
    /// The number of checkpoint identifiers currently stored by the game.
    checkpointCount: i32 = process.read(resolvePath(selectedLayout()?.checkpointCount)?)?;
    /// The number of collected item identifiers currently stored by the game.
    itemCount: i32 = process.read(resolvePath(selectedLayout()?.itemCount)?)?;
    /// The number of key-point identifiers currently stored by the game.
    keyPointCount: i32 = process.read(resolvePath(selectedLayout()?.keyPointCount)?)?;
}

