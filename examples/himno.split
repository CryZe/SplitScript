// Himno stores a static pointer to its current PlayerStats object. Keeping that
// pointer as a MemoryPath makes every poll follow the current object instead of
// caching an instance that the game may replace.
state "Himno.exe" {
    /// Current district in the active run.
    district: i32 = process.read<i32>(resolvePath(districtPath)?)?;
    /// Whether the player is currently in a run.
    inRun: bool = process.read<bool>(resolvePath(inRunPath)?)?;
}

let districtPath: MemoryPath? = None
let inRunPath: MemoryPath? = None

/// Resolves a path initialized during attachment.
fn resolvePath(path: MemoryPath?) -> address! {
    let initialized = path else return Err("path not initialized")
    return initialized.resolve()
}

onAttach {
    let mono = await Unity.mono(MonoVersion.V2)
    let image = await mono.image("Assembly-CSharp")
    let playerStats = await image.class("PlayerStats")
    let script = await playerStats.staticFieldPath("script")

    let districtOffset = await playerStats.field("currDistrict")
    districtPath = script.dereference(districtOffset as i64)
    let inRunOffset = await playerStats.field("inRun")
    inRunPath = script.dereference(inRunOffset as i64)
}

start {
    return !old.inRun && current.inRun && current.district == 1
}

split {
    return old.district == 11 && current.district == 12
}

reset {
    return old.inRun && !current.inRun && current.district == 1
}
