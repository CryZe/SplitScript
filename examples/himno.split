// Himno stores a static pointer to its current PlayerStats object. The managed
// schema follows that live reference on every poll.
image "Assembly-CSharp" {
    class PlayerStats {
        static PlayerStats script;
        i32 currDistrict;
        bool inRun;
    }
}

state Unity.mono(MonoVersion.V2) ["Himno.exe"] {
    /// Current district in the active run.
    district: i32 = PlayerStats.script?.currDistrict?;
    /// Whether the player is currently in a run.
    inRun: bool = PlayerStats.script?.inRun?;
}

start {
    return !old.inRun && current.inRun && current.district == 1
}

split {
    return old.district == 11 && current.district == 12
}

reset {
    return old.inRun && !current.inRun && current.district == 1
}
