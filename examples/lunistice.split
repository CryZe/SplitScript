/// The attached Lunistice edition selected from its managed metadata shape.
enum Edition {
    /// The original game, whose level is stored as a numeric index.
    BaseGame,
    /// The DLC demo, whose current scene is stored as a managed string.
    DlcDemo,
}

record LevelTimeParts {
    minutes: f32,
    seconds: f32,
    hundredths: f32,
}

/// Managed gameplay state shared by the original game and DLC demo.
image "Assembly-CSharp" {
    class GameManager {
        /// The live game-manager singleton.
        static GameManager instance from "Instance";
        /// The current high-level game state.
        i32 gameState from ["gameState", "<GameState>k__BackingField"];
        /// Points collected in this run.
        u32 points from "_points";
        /// Deaths accumulated in this run.
        u32 deaths from "_deaths";

        if layout.edition == Edition.BaseGame {
            /// The original game's numeric level index.
            i32 level from "currentLevel";
        } else {
            /// Address of the DLC demo's current managed scene string.
            address scene from "_currentScene";
        }
    }

    class Timer {
        /// The live timer singleton across known game versions.
        static Timer instance from ["Instance", "_instance"];
        /// Elapsed time in the current level.
        f32 levelTime from "currentLevelTime";
        /// Display digits maintained by the game's timer UI.
        LevelTimeParts levelTimeParts from "currentLevelTimeVector";
        /// Whether the in-game timer is stopped.
        bool stopped from "timerStopped";
        /// The currently selected playable character.
        u32 character;
    }
}

state Unity.il2cpp(2020) ["Lunistice.exe", "Lunistice-Demo.exe"] {
    layout {
        edition: Edition,
    }

    gameState: i32 = GameManager.instance?.gameState?;
    points: u32 = GameManager.instance?.points?;
    deaths: u32 = GameManager.instance?.deaths?;
    if layout.edition == Edition.BaseGame {
        level: i32 = GameManager.instance?.level?;
    } else {
        scene: String = process.readManagedString(GameManager.instance?.scene?, 16)?;
    }
    levelTime: f32 = Timer.instance?.levelTime?;
    levelTimeParts: LevelTimeParts = Timer.instance?.levelTimeParts?;
    timerStopped: bool = Timer.instance?.stopped?;
    character: u32 = Timer.instance?.character?;
}

let runTimeSeconds = 0.0
let beyondFirstLevel = false

fn twoDigits(value) {
    if value < 10 {
        return `0{value}`
    }
    return value as String
}

fn LevelTimeParts.toString() {
    return `{self.minutes as u32}:{twoDigits(self.seconds as u32)}.{twoDigits(self.hundredths as u32)}`
}

fn levelText(level) {
    let uncappedStage = level / 2 + 1
    let stage = uncappedStage.min(7)
    let act = if level == 14 {
        "X"
    } else if level & 1 == 0 {
        "1"
    } else {
        "2"
    }
    return `{stage}-{act}`
}

fn characterName(character, dlcDemo) {
    return match character {
        0 => "Hana",
        1 => "Toree",
        2 => "Toukie",
        3 if dlcDemo => "Accel",
        3 => "Erika",
        4 if dlcDemo => "Five",
        4 => "Lea",
        5 if !dlcDemo => "Null",
        6 if dlcDemo => "Cres",
        7 if dlcDemo => "BoxBuddy",
        _ => "Unknown",
    }
}

fn resetRunTracking() {
    runTimeSeconds = 0
    beyondFirstLevel = false
}

onStart {
    resetRunTracking()
}

onReset {
    resetRunTracking()
}

whileAttached {
    setVariable("Points", current.points)
    setVariable("Resets", current.deaths)
    setVariable("Level Time", current.levelTimeParts)
    if layout.edition == Edition.BaseGame {
        setVariable("Level", levelText(current.level))
    } else {
        setVariable("Scene", current.scene)
    }
    setVariable(
        "Character",
        characterName(current.character, layout.edition == Edition.DlcDemo),
    )

    if current.levelTime < old.levelTime && beyondFirstLevel {
        runTimeSeconds += old.levelTime
    }
}

start {
    let isFirstLevel = if layout.edition == Edition.BaseGame {
        current.level == 0
    } else {
        current.scene == "Shrine01"
    }
    if old.timerStopped != current.timerStopped && !current.timerStopped && isFirstLevel {
        return true
    }
}

reset {
    if current.levelTime < old.levelTime && !beyondFirstLevel {
        return true
    }
}

split {
    let enteredResults = old.gameState != 6 && current.gameState == 6
    let creditsTransition = layout.edition == Edition.BaseGame
        && old.level >= 13
        && current.level == 2

    if enteredResults || creditsTransition {
        beyondFirstLevel = true
        return true
    }
}

// ASR pauses game time once the run starts and supplies the accumulated game
// time explicitly. Returning true keeps LiveSplit's game-time clock paused.
isLoading {
    return true
}

gameTime {
    return Duration.fromSeconds(runTimeSeconds + current.levelTime)
}
