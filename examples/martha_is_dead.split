// Port of the compact, versioned Martha Is Dead ASL load remover. The three
// supported releases share one typed state interface while using different
// pointer paths.
enum MarthaBuild { Demo, V427, V1040101 }
let build: MarthaBuild

state "MID-Win64-Shipping.exe" {
    if build is MarthaBuild.Demo {
        /// Demo loading state.
        loader: i32 at "MID-Win64-Shipping.exe", 0x04a693d8, 0x4e0;
    } else if build is MarthaBuild.V427 {
        /// Unreal Engine 4.27 loading state.
        loader: i32 at "MID-Win64-Shipping.exe", 0x05cd4600, 0x4f8;
    } else {
        /// Version 1.0401.01 loading state.
        loader: i32 at "MID-Win64-Shipping.exe", 0x05ce0a38, 0x4e0;
    }
}

onAttach {
    let executable = await process.mainModule()
    if executable.size == 84_725_760 {
        build = MarthaBuild.Demo
        return
    } else if executable.size == 104_284_160 {
        build = MarthaBuild.V427
        return
    } else if executable.size == 104_288_256 {
        build = MarthaBuild.V1040101
        return
    }

    print(`unsupported Martha Is Dead module size {executable.size}`)
    await process.closed()
}

isLoading {
    return current.loader == 0
}
