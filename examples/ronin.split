// Port of the compact Ronin autosplitter. Its two supported executable
// versions share the loading field, while the bike field genuinely changes
// signedness between versions.
enum RoninBuild { V8, V9 }
let build: RoninBuild

state "Ronin.exe" {
    if build is RoninBuild.V8 {
        /// Version 8 loading flag.
        loading: i32 at "Ronin.exe", 0x002f01cc, 0x7dc, 0xc0;
        /// Version 8 signed bike value.
        bike: i16 at "Ronin.exe", 0x561758, 0x140;
    } else {
        /// Version 9 loading flag.
        loading: i32 at "Ronin.exe", 0x002f7228, 0x5c, 0x418, 0x5c, 0xb4;
        /// Version 9 unsigned bike value.
        bike: u16 at "Ronin.exe", 0x56a758, 0xe4;
    }
}

let doubleTap: u32 = 0

onAttach {
    let executable = await process.mainModule()
    if executable.size == 5_705_728 {
        build = RoninBuild.V9
        return
    }
    if executable.size == 5_668_864 {
        build = RoninBuild.V8
        return
    }

    print(`unsupported Ronin module size {executable.size}`)
    await process.closed()
}

start {
    if old.loading == 0 && current.loading == 1 {
        timer.pauseGameTime()
        return true
    }
}

isLoading {
    return current.loading == 1
}

split {
    if doubleTap != 0 {
        return false
    }

    let acquiredBike = match build {
        RoninBuild.V8 => old.bike != 21_368 && current.bike == 21_368,
        RoninBuild.V9 => old.bike != 52_688 && current.bike == 52_688,
    }
    if acquiredBike {
        doubleTap = 500
        return true
    }
}

whileAttached {
    if doubleTap != 0 {
        doubleTap -= 1
    }
}
