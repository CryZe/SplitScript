enum Build {
    Steam,
    GOG,
}

let build: Build

state "LayoutGame.exe" {
    if build is Build.Steam {
        /// Value stored at the Steam address.
        value: u32 at 0x1000;
        /// Steam's byte-sized checkpoint.
        checkpoint: u8 at 0x1100;
    } else {
        /// Value stored at the GOG address.
        value: u32 at 0x2000;
        /// GOG's word-sized checkpoint.
        checkpoint: u16 at 0x2100;
    }
}

onAttach {
    let module = await process.mainModule()
    if module.size == 0x1000 {
        build = Build.Steam
        return
    }
    if module.size == 0x2000 {
        build = Build.GOG
        return
    }
    await process.closed()
}

whileAttached {
    setVariable("Layout", match build {
        Build.Steam => "Steam",
        Build.GOG => "GOG",
    })
    setVariable("Checkpoint", match build {
        Build.Steam => current.checkpoint as u16,
        Build.GOG => current.checkpoint,
    })
}

split {
    return old.value == 0 && current.value == 1
}
