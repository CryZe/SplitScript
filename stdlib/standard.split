/// Attaches to one of the native processes named by the state declaration.
///
/// The read-only `process` value is a typed handle to the attached game process.
///
/// # Example
///
/// Read native process memory
///
/// ```splitscript
/// state "game.exe" {}
/// whileAttached {
///     let health = process.read<i32>(0x1234) else 0
/// }
/// ```
@processType(Process)
@processes(source)
@attachment(identity)
@directRead(ProcessRead)
stateProvider Native as process {}

/// Attaches to a supported Game Boy Advance emulator.
///
/// The provider discovers emulated EWRAM and IWRAM and exposes original GBA hardware addresses through its read-only `gba` value.
///
/// # Example
///
/// Read GBA work RAM
///
/// ```splitscript
/// state GBA {
///     room: u8 at 0x03000010
/// }
/// ```
@processType(GbaEmulator)
@attachment(GbaEmulatorDiscover)
@directRead(GbaEmulatorRead)
stateProvider GBA as gba {
    "visualboyadvance-m.exe",
    "VisualBoyAdvance.exe",
    "mGBA.exe",
    "mGBA",
    "NO$GBA.EXE",
    "retroarch.exe",
    "EmuHawk.exe",
    "mednafen.exe",
}

root {
    /// Prints a diagnostic message.
    ///
    /// The message is forwarded to the autosplitting runtime.
    ///
    /// # Example
    ///
    /// Write to the runtime log
    ///
    /// ```splitscript
    /// print(42)
    /// ```
    @intrinsic(Print)
    fn print<T: Display>(
        /// The value to write to the runtime log.
        message: T,
    ) -> None;

    /// Sets a LiveSplit custom variable.
    ///
    /// The value is visible to layouts that display autosplitter variables.
    ///
    /// # Example
    ///
    /// Expose a layout variable
    ///
    /// ```splitscript
    /// setVariable("Points", 42)
    /// ```
    @intrinsic(TimerSetVariable)
    fn setVariable<T: Display>(
        /// The variable name.
        name: String,
        /// The displayed value. It is converted to text using the same rules
        /// as string interpolation.
        value: T,
    ) -> None;

    /// Changes the autosplitter tick rate.
    ///
    /// The value is a frequency in updates per second. It takes effect for the
    /// wait after the current update and remains active until another call;
    /// detaching from a process does not reset it. Establish and restore the
    /// detached baseline in `onDetached`, which also runs once initially.
    ///
    /// # Example
    ///
    /// Poll more frequently
    ///
    /// ```splitscript
    /// setTickRate(120.0)
    /// ```
    @intrinsic(RuntimeSetTickRate)
    fn setTickRate(
        /// The positive, finite number of requested updates per second.
        hz: f64,
    ) -> None;

    /// Continues attachment on the next runtime update.
    ///
    /// Always suspends once. The continuation resumes on the following attached-process tick and is cancelled if that process closes first.
    ///
    /// # Example
    ///
    /// Resume on the next update
    ///
    /// ```splitscript
    /// await nextTick()
    /// ```
    @intrinsic(NextTick)
    fn nextTick() -> None;
}

/// Reads metadata about the autosplitting runtime host.
///
/// These values describe the system running LiveSplit, not necessarily the
/// architecture of the attached game process.
///
/// # Example
///
/// Inspect the host platform
///
/// ```splitscript
/// let hostOs = runtime.operatingSystem() else "unknown"
/// let hostArchitecture = runtime.architecture() else "unknown"
/// print(`Running on {hostOs} ({hostArchitecture})`)
/// ```
namespace runtime {
    /// Returns the runtime host's operating-system name.
    ///
    /// Common values are `windows`, `linux`, and `macos`. The result remains a
    /// string so new host operating systems do not require a language update.
    ///
    /// # Example
    ///
    /// Select platform-specific metadata handling
    ///
    /// ```splitscript
    /// let hostOs = runtime.operatingSystem() else "unknown"
    /// ```
    @intrinsic(RuntimeOperatingSystem)
    fn operatingSystem() -> String!;

    /// Returns the runtime host's architecture name.
    ///
    /// Common values include `x86`, `x86_64`, `arm`, and `aarch64`. This is the
    /// runtime architecture rather than a guarantee about the attached process.
    ///
    /// # Example
    ///
    /// Report the host architecture
    ///
    /// ```splitscript
    /// let hostArchitecture = runtime.architecture() else "unknown"
    /// ```
    @intrinsic(RuntimeArchitecture)
    fn architecture() -> String!;
}

/// Selects either the current or previous values of the script's declared settings.
///
/// The compiler supplies `settings` and `oldSettings`; copying either value is
/// allocation-free because the value only identifies one of the two snapshots.
///
/// # Example
///
/// Look up a boolean setting by its stable host key
///
/// ```splitscript
/// if settings.enabled("split-boss") {
///     print("Boss splitting is enabled")
/// }
/// ```
@representation(scalar, i32)
@valueUsage(localVariable, globalVariable)
intrinsic type SettingsView {
    /// Returns a declared boolean setting selected by its stable host-map key.
    ///
    /// Unknown keys and keys belonging to non-boolean settings return false.
    /// The lookup reads the already-refreshed settings snapshot and does not
    /// query the host or allocate.
    ///
    /// # Example
    ///
    /// Select a data-driven split
    ///
    /// ```splitscript
    /// let missionKey = "42"
    /// let shouldSplit = settings.enabled(missionKey)
    /// ```
    @intrinsic(SettingsEnabled)
    fn enabled(
        /// The exact string key declared with `key "..."`, or the setting's
        /// source identifier when it has no explicit key.
        key: String,
    ) -> bool;
}

/// Accesses the attached game process.
///
/// Process operations discover modules, read memory, follow pointers, and scan signatures.
///
/// # Example
///
/// Read the matched process identity
///
/// ```splitscript
/// let executableName = process.name()
/// ```
@representation(scalar, i64)
@valueUsage(localVariable, globalVariable)
intrinsic type Process {
    /// Returns the configured process name that matched during attachment.
    ///
    /// This is the exact candidate written in the state declaration, not a
    /// filesystem path. It lets attachment discovery distinguish executable
    /// variants without granting file access.
    ///
    /// # Example
    ///
    /// Distinguish executable variants
    ///
    /// ```splitscript
    /// let executable = process.name()
    /// ```
    @intrinsic(ProcessName)
    fn name() -> String;

    /// Returns the executable's host-provided filesystem path.
    ///
    /// The runtime uses a portable WASI spelling, such as `/mnt/c/game.exe`
    /// for a Windows path. The path is metadata only; obtaining it does not
    /// grant unrestricted host filesystem access.
    ///
    /// # Example
    ///
    /// Inspect the attached executable path
    ///
    /// ```splitscript
    /// let executablePath = process.path() else "Unavailable"
    /// ```
    @intrinsic(ProcessPath)
    fn path() -> String!;

    /// Waits for the main executable module.
    ///
    /// The module name comes from the exact process candidate that matched
    /// during attachment. This is useful for version probes based on the main
    /// module's address or mapped size without repeating executable names.
    ///
    /// # Example
    ///
    /// Inspect the main module
    ///
    /// ```splitscript
    /// let executable = await process.mainModule()
    /// ```
    @intrinsic(ProcessMainModule)
    fn mainModule() -> Module;

    /// Ignores the current attachment until the process closes.
    ///
    /// This suspension never closes or detaches the process itself and never
    /// completes normally. When the process closes, the automatic process
    /// lifetime boundary cancels `onAttach` before it can resume.
    ///
    /// # Example
    ///
    /// Ignore an unsupported build
    ///
    /// ```splitscript
    /// if unsupported {
    ///     await process.closed()
    /// }
    /// ```
    @intrinsic(ProcessClosed)
    fn closed() -> None;

    /// Waits for a process module.
    ///
    /// Suspends attachment until both module address and size are available.
    ///
    /// # Example
    ///
    /// Wait for a module
    ///
    /// ```splitscript
    /// let gameAssembly = await process.module("GameAssembly.dll")
    /// ```
    @intrinsic(ProcessModule)
    fn module(
        /// The exact module name.
        @literal(string)
        name: String,
    ) -> Module;

    /// Searches mapped memory ranges cooperatively.
    ///
    /// At most one host memory-range entry is inspected per update. The
    /// operation completes with `None` after one full traversal when no range
    /// has the requested size and permissions.
    ///
    /// # Example
    ///
    /// Find a readable and writable emulator mapping
    ///
    /// ```splitscript
    /// let mapping = await process.findMemoryRange(0x48000, MemoryRangeAccess.ReadWrite)
    /// ```
    @intrinsic(ProcessFindMemoryRange)
    fn findMemoryRange(
        /// The exact mapped byte length.
        size: u64,
        /// Permissions that the range must provide.
        access: MemoryRangeAccess,
    ) -> MemoryRange?;

    /// Reads a fixed-layout value from process memory.
    ///
    /// The expected MemoryReadable type selects a fixed-size primitive or record layout. A synchronous read returns T!; retry polls until a value is available and yields T. Use an explicit type argument such as process.read<i32> when context cannot determine the type.
    ///
    /// # Example
    ///
    /// Read a typed value
    ///
    /// ```splitscript
    /// let health = process.read<i32>(player.offset(0x20)) else 0
    /// ```
    @intrinsic(ProcessRead)
    fn read<T: MemoryReadable>(
        /// The target address to read.
        address: address,
    ) -> T!;

    /// Follows a pointer path.
    ///
    /// Each signed offset is applied with wrapping 64-bit address arithmetic
    /// before reading the next 64-bit target pointer. A failed or null pointer
    /// read returns an error; use retry in onAttach to wait for success.
    ///
    /// # Example
    ///
    /// Follow a pointer path
    ///
    /// ```splitscript
    /// let player = retry process.follow(module.address, [0x100, 0x20])
    /// ```
    @intrinsic(ProcessFollow)
    fn follow(
        /// The initial address.
        base: address,
        /// Signed pointer offsets to follow.
        offsets: [i64],
    ) -> address!;

    /// Scans a process-memory range.
    ///
    /// Suspends until the signature is found in the requested range. Large
    /// ranges are scanned cooperatively across ticks so the autosplitter keeps
    /// yielding to the host.
    ///
    /// # Example
    ///
    /// Scan a memory range
    ///
    /// ```splitscript
    /// let marker = await process.scan(module.address, module.size, sig"48 8B ?? 89")
    /// ```
    @intrinsic(ProcessScan)
    fn scan(
        /// The beginning of the range.
        address: address,
        /// The number of bytes to scan.
        size: u64,
        /// The compiled signature pattern.
        signature: Signature,
    ) -> address;

    /// Scans every readable mapped memory range in the process.
    ///
    /// Ranges are visited from the highest address to the lowest address and
    /// unreadable mappings are skipped. The operation suspends until a match
    /// exists and is cancelled automatically when the process closes. Prefer
    /// module or explicit-range scans when the target is known because they
    /// perform less work. Only a bounded window is inspected per tick, so even
    /// a large process-wide search keeps yielding to the host.
    ///
    /// # Example
    ///
    /// Discover a runtime-created marker outside known modules
    ///
    /// ```splitscript
    /// let timerData = await process.scanMemory(sig"54 49 4D 52 ?? ?? ?? ??")
    /// ```
    @intrinsic(ProcessScanMemory)
    fn scanMemory(
        /// The compiled signature pattern.
        signature: Signature,
    ) -> address;

    /// Scans for the first of several signatures across process memory.
    ///
    /// Signatures are tried in array order within each bounded memory window.
    /// The returned index identifies the matching array element. The operation
    /// remains cooperative and is cancelled when the process closes.
    ///
    /// # Example
    ///
    /// Discover one of several supported layouts
    ///
    /// ```splitscript
    /// let found = await process.scanMemoryAny([
    ///     sig"48 8B 05 ?? ?? ?? ??",
    ///     sig"48 8B 1D ?? ?? ?? ??",
    /// ])
    /// ```
    @intrinsic(ProcessScanMemoryAny)
    fn scanMemoryAny(
        /// Candidate patterns in priority order. The array must not be empty.
        signatures: [Signature],
    ) -> SignatureMatch;

    /// Resolves a 32-bit relative address.
    ///
    /// Reads a signed displacement and adds it to the address following the displacement. A failed or null target returns an error; use retry in onAttach to wait for success.
    ///
    /// # Example
    ///
    /// Resolve a relative target
    ///
    /// ```splitscript
    /// let target = retry process.readRelative32(instruction.offset(3))
    /// ```
    @intrinsic(ProcessReadRelative32)
    fn readRelative32(
        /// The address of a signed relative displacement.
        address: address,
    ) -> address!;
    /// Reads a bounded NUL-terminated UTF-8 string.
    ///
    /// At most `maxBytes` are read in one host operation. Decoding stops at
    /// the first NUL byte. Failed memory access, an excessive bound, or invalid
    /// UTF-8 returns an error. After decoding, the result is an ordinary
    /// garbage-collected `String`; the bound belongs to this read operation and
    /// is not part of the result's type.
    ///
    /// # Example
    ///
    /// Read a native map name
    ///
    /// ```splitscript
    /// let map = process.readUtf8(mapAddress, 32) else "Unknown"
    /// ```
    @intrinsic(ProcessReadUtf8)
    fn readUtf8(
        /// The address of the first UTF-8 byte.
        address: address,
        /// The maximum number of bytes to read, up to 4096.
        maxBytes: u32,
    ) -> String!;

    /// Reads a bounded NUL-terminated UTF-16LE string.
    ///
    /// At most `maxUtf16Units` little-endian UTF-16 code units are read in one
    /// host operation. Decoding stops at the first NUL code unit. Memory-access
    /// failure, a zero or excessive bound returns an error. Unpaired surrogate
    /// code units decode as the Unicode replacement character. The result is an
    /// ordinary immutable SplitScript `String`.
    ///
    /// # Example
    ///
    /// Read a native Windows string
    ///
    /// ```splitscript
    /// let chapter = process.readUtf16Le(chapterAddress, 64) else "Unknown"
    /// ```
    @intrinsic(ProcessReadUtf16Le)
    fn readUtf16Le(
        /// The address of the first little-endian UTF-16 code unit.
        address: address,
        /// The maximum number of UTF-16 code units to read, up to 2048.
        maxUtf16Units: u32,
    ) -> String!;

    /// Reads a Unity managed string.
    ///
    /// The address identifies a Unity managed string object rather than its text
    /// bytes. Its bounded UTF-16 payload is decoded into an ordinary immutable
    /// SplitScript `String`. Memory-access failure or an excessive bound returns
    /// an error; malformed surrogate sequences decode as the Unicode replacement
    /// character.
    ///
    /// # Example
    ///
    /// Read a Unity string
    ///
    /// ```splitscript
    /// let scene = process.readManagedString(sceneAddress, 64) else "Unknown"
    /// ```
    @intrinsic(ProcessReadManagedString)
    fn readManagedString(
        /// The managed string object address.
        address: address,
        /// The maximum UTF-16 code units to decode.
        maxUtf16Units: u32,
    ) -> String!;
}

/// Reads information from the LiveSplit timer.
///
/// Timer operations expose runtime state used by autosplitter decisions.
///
/// # Example
///
/// Inspect the timer through its namespace
///
/// ```splitscript
/// let currentTimerState = timer.state()
/// ```
namespace timer {
    /// Returns the current timer state.
    ///
    /// Host states are converted to NotRunning, Running, Paused, Ended, or Unknown at the ABI boundary.
    ///
    /// # Example
    ///
    /// Check whether the timer is running
    ///
    /// ```splitscript
    /// let isRunning = timer.state() == TimerState.Running
    /// ```
    @intrinsic(TimerState)
    fn state() -> TimerState;

    /// Returns the index of the split the current attempt is on.
    ///
    /// `None` means that no attempt is in progress. The signed host ABI uses a
    /// negative value for that state; all nonnegative values are exposed as
    /// `u64`. The index equals the segment count after the final split. An
    /// increased index means that the timer advanced, including through a skip.
    /// If an undo and another split both happen between updates, the unchanged
    /// index cannot reveal that sequence; an exact timer-event API would require
    /// additional host support.
    ///
    /// # Example
    ///
    /// Observe timer advancement
    ///
    /// ```splitscript
    /// let splitIndex = timer.currentSplitIndex() else return
    /// ```
    @intrinsic(TimerCurrentSplitIndex)
    fn currentSplitIndex() -> u64?;

    /// Reports how an earlier segment was advanced during this attempt.
    ///
    /// Returns `Some(true)` when the segment was split, `Some(false)` when it
    /// was skipped, and `None` when the index has not been reached in the
    /// current attempt. This is historical attempt data; the current and later
    /// segment indices therefore return `None`.
    ///
    /// # Example
    ///
    /// Check whether the first segment was split
    ///
    /// ```splitscript
    /// let firstSegmentWasSplit = timer.segmentWasSplit(0)
    /// ```
    @intrinsic(TimerSegmentWasSplit)
    fn segmentWasSplit(
        /// Zero-based segment index.
        index: u64,
    ) -> bool?;

    /// Skips the current split.
    ///
    /// This directly advances the timer without recording the current segment
    /// as split. Use it only when the autosplitter intentionally controls timer
    /// history rather than merely deciding whether its `split` block fires.
    ///
    /// # Example
    ///
    /// Skip a segment that does not exist in this route
    ///
    /// ```splitscript
    /// if routeOmitsCurrentSegment {
    ///     timer.skipSplit()
    /// }
    /// ```
    @intrinsic(TimerSkipSplit)
    fn skipSplit() -> None;

    /// Undoes the previous split.
    ///
    /// The timer moves back one segment when its current state permits it.
    /// This is an explicit timer mutation and is separate from autosplitter
    /// snapshot history.
    ///
    /// # Example
    ///
    /// Correct an automatically detected false positive
    ///
    /// ```splitscript
    /// if falsePositiveDetected {
    ///     timer.undoSplit()
    /// }
    /// ```
    @intrinsic(TimerUndoSplit)
    fn undoSplit() -> None;

    /// Pauses LiveSplit's game-time clock.
    ///
    /// `isLoading` should remain the normal way to remove loads. This explicit
    /// operation is intended for lifecycle transitions such as ensuring game
    /// time does not advance after the attached process closes.
    ///
    /// # Example
    ///
    /// Pause game time after detaching
    ///
    /// ```splitscript
    /// onDetached {
    ///     timer.pauseGameTime()
    /// }
    /// ```
    @intrinsic(TimerPauseGameTime)
    fn pauseGameTime() -> None;

    /// Resumes LiveSplit's game-time clock.
    ///
    /// Prefer returning `false` from `isLoading` for ordinary load removal.
    /// Use this operation only when lifecycle logic explicitly paused game
    /// time outside that action.
    ///
    /// # Example
    ///
    /// Resume game time after attaching
    ///
    /// ```splitscript
    /// onAttach {
    ///     timer.resumeGameTime()
    /// }
    /// ```
    @intrinsic(TimerResumeGameTime)
    fn resumeGameTime() -> None;

    /// Reports whether the LiveSplit timer is currently running.
    ///
    /// This is a convenience check over the exhaustive timer state.
    ///
    /// # Example
    ///
    /// Check whether a run is active
    ///
    /// ```splitscript
    /// if timer.isRunning() {
    ///     print("The timer is running")
    /// }
    /// ```
    fn isRunning() -> bool {
        return timer.state() == TimerState.Running
    }
}

/// Discovers and inspects Unity runtimes.
///
/// Unity operations attach to IL2CPP metadata and produce typed images, classes, and fields.
///
/// # Example
///
/// Enter Unity discovery through its namespace
///
/// ```splitscript
/// let runtime = await Unity.il2cpp(2020)
/// ```
namespace Unity {
    /// Discovers an IL2CPP runtime.
    ///
    /// Suspends until GameAssembly and the IL2CPP metadata structures are available.
    ///
    /// # Example
    ///
    /// Discover IL2CPP metadata
    ///
    /// ```splitscript
    /// let unity = await Unity.il2cpp(2020)
    /// ```
    fn il2cpp(
        /// The Unity metadata layout version.
        version: u32,
    ) -> UnityModule {
        if version != 0 && version != 2019 && version != 2020 && version != 2022 {
            await process.closed()
        }

        let gameAssembly = await process.module("GameAssembly.dll")
        let assembliesInstruction = await gameAssembly.scan(sig"75 ?? 48 8B 1D ?? ?? ?? ?? 48 3B 1D")
        let assemblies = retry process.readRelative32(assembliesInstruction.offset(5))
        let metadata = await gameAssembly.scan(sig"67 6C 6F 62 61 6C 2D 6D 65 74 61 64 61 74 61 2E 64 61 74 00")

        let metadataReference: address = 0
        let cursor = gameAssembly.address
        let end = gameAssembly.address.add(gameAssembly.size)
        while metadataReference == 0 {
            let instruction = await process.scan(
                cursor,
                (end as u64) - (cursor as u64),
                sig"48 8D 0D",
            )
            let displacement = instruction.offset(3)
            let target = match process.readRelative32(displacement) {
                Ok(address) => address,
                Err(_) => 0 as address,
            }
            if target == metadata {
                metadataReference = displacement
            } else {
                cursor = instruction.add(1)
            }
        }

        let shiftInstruction = await process.scan(
            metadataReference,
            0x200,
            sig"48 C1 E9",
        )
        let storeInstruction = await process.scan(
            shiftInstruction.offset(3),
            0x100,
            sig"48 89 05",
        )
        let typeInformation = retry process.readRelative32(storeInstruction.offset(3))

        return UnityModule {
            assemblies: assemblies,
            typeInfoTable: typeInformation,
            version: version,
            pointerSize: 8,
        }
    }
}

/// Supports ordered numeric operations.
///
/// Numeric values provide minimum, maximum, clamping, ordered comparisons, and
/// equality while preserving their inferred type. Integer arithmetic results
/// wrap to the declared integer width.
///
/// # Example
///
/// Keep an integer below a limit
///
/// ```splitscript
/// let cappedStage = 12.min(7)
/// ```
@behavior(declared)
capability Numeric<T: Equatable> {
    /// Adds another value of the same numeric type.
    ///
    /// This method is also the implementation of the `+` operator. Integer
    /// overflow wraps modulo the receiver's declared bit width.
    ///
    /// # Example
    ///
    /// Add two values
    ///
    /// ```splitscript
    /// let total = 20 + 22
    /// ```
    @intrinsic(NumericAdd)
    @operator(add)
    fn add(
        /// The value to add.
        other: T,
    ) -> T;

    /// Subtracts another value of the same numeric type.
    ///
    /// This method is also the implementation of the `-` operator. Integer
    /// overflow wraps modulo the receiver's declared bit width.
    ///
    /// # Example
    ///
    /// Subtract two values
    ///
    /// ```splitscript
    /// let difference = 50 - 8
    /// ```
    @intrinsic(NumericSubtract)
    @operator(subtract)
    fn subtract(
        /// The value to subtract.
        other: T,
    ) -> T;

    /// Multiplies by another value of the same numeric type.
    ///
    /// This method is also the implementation of the `*` operator. Integer
    /// overflow wraps modulo the receiver's declared bit width.
    ///
    /// # Example
    ///
    /// Convert a page count to bytes
    ///
    /// ```splitscript
    /// let byteCount = pageCount * 4096
    /// ```
    @intrinsic(NumericMultiply)
    @operator(multiply)
    fn multiply(
        /// The value to multiply by.
        other: T,
    ) -> T;

    /// Divides by another value of the same numeric type.
    ///
    /// This method is also the implementation of the `/` operator. Integer
    /// division truncates toward zero. Integer division by zero and the signed
    /// minimum divided by negative one trap, matching WebAssembly arithmetic;
    /// floating-point division follows IEEE 754.
    ///
    /// # Example
    ///
    /// Convert milliseconds to seconds
    ///
    /// ```splitscript
    /// let elapsedSeconds = elapsedMilliseconds / 1_000
    /// ```
    @intrinsic(NumericDivide)
    @operator(divide)
    fn divide(
        /// The divisor.
        other: T,
    ) -> T;

    /// Multiplies this value by itself.
    ///
    /// Integer multiplication wraps to the receiver's declared width.
    /// Floating-point multiplication rounds at the receiver's f32 or f64
    /// width and follows IEEE 754 for zero, infinity, and NaN.
    ///
    /// # Example
    ///
    /// Square a coordinate delta
    ///
    /// ```splitscript
    /// let squaredDistance = delta.squared()
    /// ```
    fn squared() -> T {
        return self * self
    }

    /// Returns the smaller of two numeric values.
    ///
    /// Both values have the same inferred numeric type and are evaluated once.
    /// For floating-point values, either NaN input produces NaN. If the values
    /// are positive and negative zero, negative zero is returned.
    ///
    /// # Example
    ///
    /// Keep the smaller value
    ///
    /// ```splitscript
    /// let visibleStage = stage.min(7)
    /// ```
    @intrinsic(NumericMin)
    fn min(
        /// The other value to compare with the receiver.
        other: T,
    ) -> T;

    /// Returns the larger of two numeric values.
    ///
    /// Both values have the same inferred numeric type and are evaluated once.
    /// For floating-point values, either NaN input produces NaN. If the values
    /// are positive and negative zero, positive zero is returned.
    ///
    /// # Example
    ///
    /// Keep the larger value
    ///
    /// ```splitscript
    /// let nonNegativeScore = score.max(0)
    /// ```
    @intrinsic(NumericMax)
    fn max(
        /// The other value to compare with the receiver.
        other: T,
    ) -> T;

    /// Restricts a numeric value to an inclusive range.
    ///
    /// The receiver and bounds have one inferred numeric type and are evaluated once.
    ///
    /// # Example
    ///
    /// Restrict a value to a range
    ///
    /// ```splitscript
    /// let visibleStage = stage.clamp(1, 7)
    /// ```
    fn clamp(
        /// The inclusive lower bound.
        minimum: T,
        /// The inclusive upper bound.
        maximum: T,
    ) -> T {
        let lowerBounded = self.max(minimum)
        return lowerBounded.min(maximum)
    }
}

/// Identifies integral numeric types.
///
/// Integer operations and inference constraints accept only whole-number
/// representations. Every integer is also numeric and displayable.
///
/// # Example
///
/// Preserve an exact integer width
///
/// ```splitscript
/// let inventoryMask: u8 = 1 << 2
/// ```
@behavior(declared)
capability Integer<T: Numeric + Display> {
    /// Returns the width-preserving bitwise complement of this integer.
    ///
    /// This method is also the integer implementation of the `!` operator.
    /// Every bit in the receiver's declared integer representation is flipped;
    /// for example, complementing a `u8` never affects bits outside that byte.
    /// Boolean `!` remains logical negation and is selected by type.
    ///
    /// # Example
    ///
    /// Invert an eight-bit mask
    ///
    /// ```splitscript
    /// let inverse: u8 = !0x0fu8
    /// ```
    @intrinsic(IntegerBitNot)
    @operator(not)
    fn bitNot() -> T;

    /// Returns the remainder after integer division.
    ///
    /// This method is also the implementation of the `%` operator. The result
    /// has the same sign as the receiver. A zero divisor traps, matching
    /// WebAssembly integer arithmetic.
    ///
    /// # Example
    ///
    /// Test a frame interval
    ///
    /// ```splitscript
    /// let isInterval = frameCount % 60 == 0
    /// ```
    @intrinsic(IntegerRemainder)
    @operator(remainder)
    fn remainder(
        /// The divisor.
        other: T,
    ) -> T;

    /// Combines two integers with a bitwise OR.
    ///
    /// This method is also the implementation of the `|` operator.
    ///
    /// # Example
    ///
    /// Add a flag to a mask
    ///
    /// ```splitscript
    /// let combined = flags | 0x20
    /// ```
    @intrinsic(IntegerBitOr)
    @operator(bitOr)
    fn bitOr(
        /// The other integer.
        other: T,
    ) -> T;

    /// Combines two integers with a bitwise exclusive OR.
    ///
    /// This method is also the implementation of the `^` operator.
    ///
    /// # Example
    ///
    /// Toggle a flag in a mask
    ///
    /// ```splitscript
    /// let toggled = flags ^ 0x20
    /// ```
    @intrinsic(IntegerBitXor)
    @operator(bitXor)
    fn bitXor(
        /// The other integer.
        other: T,
    ) -> T;

    /// Combines two integers with a bitwise AND.
    ///
    /// This method is also the implementation of the `&` operator.
    ///
    /// # Example
    ///
    /// Isolate one flag from a mask
    ///
    /// ```splitscript
    /// let selected = flags & 0x20
    /// ```
    @intrinsic(IntegerBitAnd)
    @operator(bitAnd)
    fn bitAnd(
        /// The other integer.
        other: T,
    ) -> T;

    /// Shifts bits to the left.
    ///
    /// This method is also the implementation of the `<<` operator. Only the
    /// low five bits of the shift count are used for values represented as
    /// i32, including 8- and 16-bit integers; i64, u64, and address values use
    /// the low six bits. Bits shifted out of the representation are discarded.
    ///
    /// # Example
    ///
    /// Construct a bit mask
    ///
    /// ```splitscript
    /// let mask = 1u32 << bitIndex
    /// ```
    @intrinsic(IntegerShiftLeft)
    @operator(shiftLeft)
    fn shiftLeft(
        /// The shift count, inferred as the receiver's integer type.
        count: T,
    ) -> T;

    /// Shifts bits to the right.
    ///
    /// This method is also the implementation of the `>>` operator. Signed
    /// values copy the sign bit; unsigned and address values shift in zeroes.
    /// Shift counts use the same low-five or low-six-bit rule as `shiftLeft`.
    ///
    /// # Example
    ///
    /// Extract a packed byte
    ///
    /// ```splitscript
    /// let highByte = packed >> 8
    /// ```
    @intrinsic(IntegerShiftRight)
    @operator(shiftRight)
    fn shiftRight(
        /// The shift count, inferred as the receiver's integer type.
        count: T,
    ) -> T;
}

/// Identifies signed numeric types.
///
/// Signed values can represent numbers below zero and support all numeric
/// operations.
///
/// # Example
///
/// Store a signed delta
///
/// ```splitscript
/// let levelDelta: i32 = -4
/// ```
@behavior(declared)
capability Signed<T: Numeric> {
    /// Returns this value with its sign inverted.
    ///
    /// This method is also the implementation of unary `-`. Integer minimum
    /// values wrap to themselves, matching WebAssembly integer subtraction;
    /// floating-point values toggle their sign bit, including zero and NaN.
    ///
    /// # Example
    ///
    /// Invert a signed offset
    ///
    /// ```splitscript
    /// let reverseOffset = -forwardOffset
    /// ```
    @intrinsic(SignedNegate)
    @operator(negate)
    fn negate() -> T;

    /// Returns this value without a negative sign.
    ///
    /// Floating-point negative zero becomes positive zero and NaN remains NaN.
    /// Signed-integer arithmetic follows the language's wrapping rule, so the
    /// minimum value of an integer type remains itself because its positive
    /// counterpart is not representable in that type.
    ///
    /// # Example
    ///
    /// Measure the magnitude of a signed delta
    ///
    /// ```splitscript
    /// let distance = delta.abs()
    /// ```
    fn abs() -> T {
        return self.max(-self)
    }
}

/// Identifies floating-point types.
///
/// Floating-point constraints accept f32 and f64 values and imply signed
/// numeric behavior.
///
/// # Example
///
/// Round a floating-point value
///
/// ```splitscript
/// let nearest = 2.5.round()
/// ```
@behavior(declared)
capability Float<T: Signed> {
    /// Returns the principal square root of this value.
    ///
    /// Positive finite values produce a non-negative result. Positive infinity
    /// remains infinity, signed zero preserves its sign, and a negative value
    /// other than negative zero produces NaN. Existing NaN values remain NaN.
    ///
    /// # Example
    ///
    /// Measure a two-dimensional distance
    ///
    /// ```splitscript
    /// let distance = (x * x + y * y).sqrt()
    /// ```
    @intrinsic(FloatSqrt)
    fn sqrt() -> T;

    /// Rounds this value toward zero to an integral value.
    ///
    /// Positive fractions round down and negative fractions round up. Signed
    /// zero preserves its sign. Infinity and NaN are returned unchanged.
    ///
    /// # Example
    ///
    /// Remove the fractional part of a measured time
    ///
    /// ```splitscript
    /// let wholeSeconds = seconds.truncate()
    /// ```
    @intrinsic(FloatTruncate)
    fn truncate() -> T;

    /// Rounds down to the nearest integral value.
    ///
    /// Finite fractional values move toward negative infinity. Infinity and
    /// NaN are returned unchanged.
    ///
    /// # Example
    ///
    /// Round a timer down
    ///
    /// ```splitscript
    /// let wholeSeconds = seconds.floor()
    /// ```
    @intrinsic(FloatFloor)
    fn floor() -> T;

    /// Rounds up to the nearest integral value.
    ///
    /// Finite fractional values move toward positive infinity. Infinity and
    /// NaN are returned unchanged.
    ///
    /// # Example
    ///
    /// Round a counter up
    ///
    /// ```splitscript
    /// let requiredPages = pages.ceil()
    /// ```
    @intrinsic(FloatCeil)
    fn ceil() -> T;

    /// Rounds to the nearest integral value, with halfway values rounded to even.
    ///
    /// Ties choose the even neighboring integer, avoiding a systematic upward
    /// or downward bias. Infinity and NaN are returned unchanged.
    ///
    /// # Example
    ///
    /// Round a displayed measurement
    ///
    /// ```splitscript
    /// let visibleDistance = distance.round()
    /// ```
    @intrinsic(FloatRound)
    fn round() -> T;

    /// Rounds to a requested number of digits after the decimal point.
    ///
    /// Halfway values are rounded to even. If the decimal scale or scaled value
    /// cannot be represented finitely, the receiver is returned unchanged.
    ///
    /// # Example
    ///
    /// Keep two decimal places
    ///
    /// ```splitscript
    /// let percentage = ratio.roundTo(2)
    /// ```
    fn roundTo(
        /// The number of digits to preserve after the decimal point.
        decimalPlaces: u32,
    ) -> T {
        let scale = 1
        let remaining = decimalPlaces
        while remaining > 0 {
            let next = scale * 10
            if !next.isFinite() {
                return self
            }
            scale = next
            remaining -= 1
        }
        let scaled = self * scale
        if !scaled.isFinite() {
            return self
        }
        return scaled.round() / scale
    }

    /// Returns whether the receiver is the floating-point not-a-number value.
    ///
    /// NaN is the only floating-point value that does not compare equal to itself.
    ///
    /// # Example
    ///
    /// Reject an invalid measurement
    ///
    /// ```splitscript
    /// if measurement.isNaN() {
    ///     print("invalid measurement")
    /// }
    /// ```
    fn isNaN() -> bool {
        return self != self
    }

    /// Returns whether the receiver is neither infinity nor NaN.
    ///
    /// Both positive and negative finite values, including signed zero, return true.
    ///
    /// # Example
    ///
    /// Use a finite measurement
    ///
    /// ```splitscript
    /// if measurement.isFinite() {
    ///     let magnitude = measurement.abs()
    /// }
    /// ```
    fn isFinite() -> bool {
        return self - self == 0
    }
}

extend f32 {
    /// Constructs a 32-bit float from its exact IEEE-754 bit pattern.
    ///
    /// Every bit pattern is accepted, including signed zero, infinities, and
    /// NaN payloads. This is a reinterpretation and performs no numeric
    /// conversion.
    ///
    /// # Example
    ///
    /// Construct the smallest positive 32-bit subnormal
    ///
    /// ```splitscript
    /// let smallest = f32.fromBits(0x00000001)
    /// ```
    @mustUse("The constructed floating-point value must be used.")
    @intrinsic(F32FromBits)
    static fn fromBits(
        /// The exact IEEE-754 binary32 representation.
        bits: u32,
    ) -> f32;

    /// Returns this float's exact IEEE-754 bit pattern.
    ///
    /// Signed zero and NaN payload bits are preserved. This is a
    /// reinterpretation and performs no numeric conversion.
    ///
    /// # Example
    ///
    /// Inspect a 32-bit float
    ///
    /// ```splitscript
    /// let bits = (-0.0 as f32).toBits()
    /// ```
    @mustUse("The returned bit pattern must be used.")
    @intrinsic(F32ToBits)
    fn toBits() -> u32;
}

extend f64 {
    /// Constructs a 64-bit float from its exact IEEE-754 bit pattern.
    ///
    /// Every bit pattern is accepted, including signed zero, infinities, and
    /// NaN payloads. This is a reinterpretation and performs no numeric
    /// conversion.
    ///
    /// # Example
    ///
    /// Construct the smallest positive 64-bit subnormal
    ///
    /// ```splitscript
    /// let smallest = f64.fromBits(0x0000000000000001u64)
    /// ```
    @mustUse("The constructed floating-point value must be used.")
    @intrinsic(F64FromBits)
    static fn fromBits(
        /// The exact IEEE-754 binary64 representation.
        bits: u64,
    ) -> f64;

    /// Returns this float's exact IEEE-754 bit pattern.
    ///
    /// Signed zero and NaN payload bits are preserved. This is a
    /// reinterpretation and performs no numeric conversion.
    ///
    /// # Example
    ///
    /// Inspect a 64-bit float
    ///
    /// ```splitscript
    /// let bits = (-0.0 as f64).toBits()
    /// ```
    @mustUse("The returned bit pattern must be used.")
    @intrinsic(F64ToBits)
    fn toBits() -> u64;
}

extend bool {
    /// Inverts a boolean value.
    ///
    /// This method is also the implementation of the `!` operator.
    ///
    /// # Example
    ///
    /// Invert a loading flag
    ///
    /// ```splitscript
    /// let isPlaying = !isLoading
    /// ```
    @intrinsic(BoolNot)
    @operator(not)
    fn not() -> bool;
}

/// Supports equality comparison.
///
/// Equality is available for values whose representation can be compared safely.
///
/// # Example
///
/// Compare two values
///
/// ```splitscript
/// let sameRoom = 4 == 4
/// ```
@behavior(structuralEquality)
capability Equatable<T> {
    /// Reports whether this value and another value are equal.
    ///
    /// This method is also the implementation of the `==` operator. Records,
    /// enums, options, and results compare their complete structure; strings
    /// compare UTF-8 contents. Floating-point equality follows IEEE 754, so
    /// NaN is not equal to itself.
    ///
    /// # Example
    ///
    /// Compare two state values
    ///
    /// ```splitscript
    /// let unchanged = oldRoom == currentRoom
    /// ```
    @intrinsic(EquatableEquals)
    @operator(equal)
    fn equals(
        /// The other value of the same type.
        other: T,
    ) -> bool;

    /// Reports whether this value and another value differ.
    ///
    /// This method is also the implementation of the `!=` operator and is the
    /// logical inverse of `equals` for every Equatable type.
    ///
    /// # Example
    ///
    /// Detect a state transition
    ///
    /// ```splitscript
    /// let changed = oldRoom != currentRoom
    /// ```
    @intrinsic(EquatableNotEquals)
    @operator(notEqual)
    fn notEquals(
        /// The other value of the same type.
        other: T,
    ) -> bool;
}

/// Supports conversion to a user-facing textual representation.
///
/// An `as String` cast, string interpolation, `print`, and `setVariable` all
/// display values through this single capability.
///
/// # Example
///
/// Display a value without an explicit string conversion
///
/// ```splitscript
/// let scoreText = `Score: {42}`
/// ```
@behavior(declared)
capability Display<T> {}

/// Supports deserialization from process memory.
///
/// Primitive and record layouts with this capability can be selected by `process.read`.
///
/// # Example
///
/// Infer a readable memory type
///
/// ```splitscript
/// let health = process.read<i32>(0x1234) else 0
/// ```
@behavior(structuralMemoryLayout)
capability MemoryReadable<T> {}

/// Stores an indexed sequence of values.
///
/// `[T]` accepts any length, while `[T; N]` carries an exact length and can
/// provide a fixed process-memory layout. Both forms use WebAssembly GC storage
/// and expose the same generic length, access, and mutation operations.
///
/// # Example
///
/// Store a typed sequence
///
/// ```splitscript
/// let inventory: [u8] = [1, 2, 3]
/// ```
typeConstructor Array<T> {
    /// Returns the number of array elements.
    ///
    /// The result is the WebAssembly GC array length.
    ///
    /// # Example
    ///
    /// Count array elements
    ///
    /// ```splitscript
    /// let fieldCount = fieldNames.length()
    /// ```
    @intrinsic(ArrayLength)
    fn length() -> u32;

    /// Reports whether the array contains no elements.
    ///
    /// This is ordinary library composition over `length`; it does not require
    /// a separate runtime intrinsic.
    ///
    /// # Example
    ///
    /// Check for an empty array
    ///
    /// ```splitscript
    /// let hasNoFields = fieldNames.isEmpty()
    /// ```
    fn isEmpty() -> bool {
        return self.length() == 0
    }

    /// Reports whether the array contains an equal element.
    ///
    /// Elements are compared from the beginning of the array. The element
    /// type must support equality.
    ///
    /// # Example
    ///
    /// Check a closed route table
    ///
    /// ```splitscript
    /// let route = [2, 4, 7]
    /// let visitsBoss = route.contains(7)
    /// ```
    fn contains(
        /// The element to find.
        value: T,
    ) -> bool where T: Equatable {
        for element in self {
            if element == value {
                return true
            }
        }
        return false
    }

    /// Finds the first index containing an equal element.
    ///
    /// Returns `None` when the value is absent. The index is a `u32`, matching
    /// the array indexing and length APIs, and the element type must support
    /// equality.
    ///
    /// # Example
    ///
    /// Find a checkpoint in a route table
    ///
    /// ```splitscript
    /// let route = [2, 4, 7]
    /// let bossIndex = route.indexOf(7)
    /// ```
    fn indexOf(
        /// The element to find.
        value: T,
    ) -> u32? where T: Equatable {
        let index = 0
        while index < self.length() {
            if self[index] == value {
                return index
            }
            index += 1
        }
        return None
    }

    /// Updates an array element.
    ///
    /// This is the standard-library operation behind `array[index] = value`.
    /// The array and index are evaluated once and the element is updated in
    /// place without structurally invalidating active iteration.
    ///
    /// # Example
    ///
    /// Replace an array element
    ///
    /// ```splitscript
    /// fieldNames.set(0, "health")
    /// ```
    @intrinsic(ArraySet)
    fn set(
        /// The zero-based element index.
        index: u32,
        /// The new element value.
        value: T,
    ) -> None;

    /// Appends an element to a growable array.
    ///
    /// Capacity grows geometrically when needed, while the array value keeps
    /// the same identity so every alias observes the appended element.
    /// Exact `[T; N]` arrays cannot change length and do not support `push`.
    /// Appending through any alias invalidates active iteration of this array.
    ///
    /// # Example
    ///
    /// Append a discovered checkpoint
    ///
    /// ```splitscript
    /// let checkpoints: [u32] = [1, 2]
    /// checkpoints.push(3)
    /// ```
    @intrinsic(ArrayPush)
    fn push(
        /// The element to append.
        value: T,
    ) -> None;

    /// Appends every element from another array.
    ///
    /// The source length is captured before appending, so extending an array
    /// with itself duplicates its original elements exactly once. The receiver
    /// keeps its identity and grows with the same amortized behavior as
    /// `push`. Exact `[T; N]` arrays cannot change length and do not support
    /// `extend`. Extending through any alias invalidates active iteration of
    /// the receiver.
    ///
    /// # Example
    ///
    /// Append discovered checkpoints in bulk
    ///
    /// ```splitscript
    /// checkpoints.extend([4, 7, 9])
    /// ```
    fn extend(
        /// The elements to append, in order.
        values: [T],
    ) -> None {
        let count = values.length()
        let index = 0
        while index < count {
            self.push(values[index])
            index += 1
        }
    }

    /// Removes the element at an index and shifts later elements left.
    ///
    /// The array keeps its identity and capacity, so aliases observe the
    /// removal. An index greater than or equal to `length()` traps, matching
    /// indexed access. Stored references in the vacated final slot are
    /// released for garbage collection. Exact `[T; N]` arrays cannot change
    /// length and do not support `removeAt`.
    ///
    /// # Example
    ///
    /// Consume the first pending checkpoint
    ///
    /// ```splitscript
    /// checkpoints.removeAt(0)
    /// ```
    @intrinsic(ArrayRemoveAt)
    fn removeAt(
        /// The zero-based index to remove.
        index: u32,
    ) -> None;

    /// Removes and returns the final element when one exists.
    ///
    /// An empty array returns `None` without changing its structural version.
    /// Otherwise the array keeps its identity and capacity, aliases observe
    /// the shorter length, and active iteration is invalidated. Exact `[T; N]`
    /// arrays cannot change length and do not support `pop`.
    ///
    /// # Example
    ///
    /// Consume the most recently discovered checkpoint
    ///
    /// ```splitscript
    /// let checkpoint = checkpoints.pop() else return
    /// ```
    fn pop() -> T? {
        let length = self.length()
        let value = if length == 0 {
            None
        } else {
            Some(self[length - 1])
        }
        if length != 0 {
            self.removeAt(length - 1)
        }
        return value
    }

    /// Removes every element from a growable array.
    ///
    /// The array keeps its identity and capacity, so aliases observe the empty
    /// result and later appends can reuse its storage. Stored references are
    /// released for garbage collection. Exact `[T; N]` arrays cannot change
    /// length and do not support `clear`.
    /// Clearing through any alias invalidates active iteration of this array.
    ///
    /// # Example
    ///
    /// Reset discovered checkpoints
    ///
    /// ```splitscript
    /// checkpoints.clear()
    /// ```
    @intrinsic(ArrayClear)
    fn clear() -> None;
}

/// Stores a growable collection of unique values for one script instance.
///
/// A set keeps its allocation and contents across ticks. Mutating operations
/// update the same set value, so a global set can track visited checkpoints
/// without rebuilding a collection on every update.
///
/// # Example
///
/// Track visited rooms
///
/// ```splitscript
/// let visited = Set.new<String>()
/// visited.insert("Atrium")
/// ```
typeConstructor Set<T: Equatable> {
    /// Creates an empty set.
    ///
    /// The returned value retains its contents until explicitly mutated or the
    /// script instance is unloaded.
    ///
    /// # Example
    ///
    /// Create a room set
    ///
    /// ```splitscript
    /// let visited = Set.new<String>()
    /// ```
    @intrinsic(SetNew)
    static fn new<U: Equatable>() -> Set<U>;

    /// Returns the number of stored values.
    ///
    /// Duplicate insertions do not increase the count.
    ///
    /// # Example
    ///
    /// Count visited rooms
    ///
    /// ```splitscript
    /// let roomCount = visited.length()
    /// ```
    @intrinsic(SetLength)
    fn length() -> u32;

    /// Reports whether the set contains no values.
    ///
    /// This composes the source-defined result from `length`.
    ///
    /// # Example
    ///
    /// Check a new route
    ///
    /// ```splitscript
    /// let routeIsNew = visited.isEmpty()
    /// ```
    fn isEmpty() -> bool {
        return self.length() == 0
    }

    /// Reports whether an equal value is present.
    ///
    /// Values are compared using the element type's equality implementation.
    ///
    /// # Example
    ///
    /// Check a visited room
    ///
    /// ```splitscript
    /// let seenAtrium = visited.contains("Atrium")
    /// ```
    @intrinsic(SetContains)
    fn contains(
        /// The value to find.
        value: T,
    ) -> bool;

    /// Inserts a value if it is not already present.
    ///
    /// Returns whether the value was newly inserted.
    /// A successful insertion invalidates active iteration of this set;
    /// inserting an existing value does not.
    ///
    /// # Example
    ///
    /// Record a visited room
    ///
    /// ```splitscript
    /// let firstVisit = visited.insert("Atrium")
    /// ```
    @intrinsic(SetInsert)
    fn insert(
        /// The value to insert.
        value: T,
    ) -> bool;

    /// Removes an equal value if it is present.
    ///
    /// Returns whether a value was removed.
    /// A successful removal invalidates active iteration of this set; removing
    /// a missing value does not.
    ///
    /// # Example
    ///
    /// Forget a visited room
    ///
    /// ```splitscript
    /// let wasVisited = visited.remove("Atrium")
    /// ```
    @intrinsic(SetRemove)
    fn remove(
        /// The value to remove.
        value: T,
    ) -> bool;

    /// Removes every stored value while retaining the set itself.
    ///
    /// Later insertions reuse the same logical set value.
    /// Clearing invalidates active iteration of this set.
    ///
    /// # Example
    ///
    /// Reset a route
    ///
    /// ```splitscript
    /// visited.clear()
    /// ```
    @intrinsic(SetClear)
    fn clear() -> None;
}

/// Represents a value that may be absent.
///
/// The postfix `?` type syntax constructs an Option value.
///
/// # Example
///
/// Store an optional value
///
/// ```splitscript
/// let possibleLevel: u32? = 4
/// ```
@mustUse("Optional values must be inspected or explicitly discarded.")
typeConstructor Option<T> {}

/// Represents a value or an error.
///
/// The postfix `!` type syntax constructs a Result value.
///
/// # Example
///
/// Store a successful result
///
/// ```splitscript
/// let health: u32! = 100
/// ```
@mustUse("Result values must be handled so failures are not silently ignored.")
typeConstructor Result<T> {
    /// Converts a fallible value into an optional value.
    ///
    /// A successful result becomes the present option value. An error becomes
    /// `None`, discarding its diagnostic text. This is useful for state fields
    /// that are deliberately unavailable on some ticks; required fields should
    /// keep their `T!` so a failed read retains the last accepted field value.
    ///
    /// # Example
    ///
    /// Make one process read optional
    ///
    /// ```splitscript
    /// let health: i32? = process.read<i32>(healthAddress).toOption()
    /// ```
    fn toOption() -> T? {
        return match self {
            Ok(value) => Some(value),
            Err(_) => None,
        }
    }
}

extend address {
    /// Applies a signed displacement to an address.
    ///
    /// Arithmetic wraps modulo the 64-bit address space. This preserves the
    /// full unsigned address domain while allowing negative pointer offsets.
    ///
    /// # Example
    ///
    /// Add a field offset
    ///
    /// ```splitscript
    /// let healthAddress = player.offset(0x20)
    /// ```
    fn offset<T: Integer>(
        /// The integer displacement; signed values retain their sign.
        offset: T,
    ) -> address {
        return self.add(offset as u64)
    }

    /// Adds a full-width offset to an address.
    ///
    /// This is useful for unsigned sizes and offsets already represented as
    /// `u64`. Arithmetic wraps modulo the 64-bit address space.
    ///
    /// # Example
    ///
    /// Add a full-width offset
    ///
    /// ```splitscript
    /// let target = module.address.add(sectionOffset)
    /// ```
    @intrinsic(AddressAdd)
    fn add(
        /// The full-width address offset.
        offset: u64,
    ) -> address;

    /// Builds a pointer path rooted at this address.
    ///
    /// Each dereference offset is applied before reading the next native
    /// pointer. The final offset is applied without another dereference.
    ///
    /// # Example
    ///
    /// Describe a player health path
    ///
    /// ```splitscript
    /// let health = module.address.memoryPath([0x100, 0x20], 0x18, pointerSize)
    /// ```
    fn memoryPath(
        /// Signed offsets that each end in a native pointer read.
        dereferences: [i64],
        /// Signed offset applied after the final pointer read.
        finalOffset: i64,
        /// Native pointer width used by the target executable.
        pointerSize: PointerSize,
    ) -> MemoryPath {
        return MemoryPath {
            base: self,
            dereferences: dereferences,
            finalOffset: finalOffset,
            pointerSize: pointerSize
        }
    }
}

/// Stores ordinary immutable UTF-8 text in WebAssembly GC memory.
///
/// String literals, interpolation, process decoders, and timer variables all
/// produce this same type. A decoded string owns its GC storage and is not a
/// view into target-process memory. Decoder bounds such as `utf8(64)` describe
/// the memory operation, not distinct `String` types.
///
/// # Example
///
/// Store owned text
///
/// ```splitscript
/// let character: String = "Toree"
/// ```
@representation(gcArray, u8, mutable, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable)
@capabilities(Equatable, Display)
intrinsic type String {
    /// Returns a string's UTF-8 byte length.
    ///
    /// The result counts UTF-8 bytes in the current string representation.
    ///
    /// # Example
    ///
    /// Measure UTF-8 text
    ///
    /// ```splitscript
    /// let byteLength = levelName.byteLength()
    /// ```
    @intrinsic(StringLength)
    fn byteLength() -> u32;

    /// Reports whether this string contains no UTF-8 bytes.
    ///
    /// `String` itself is never absent. Use ordinary `match` on `String?` when
    /// absence and emptiness should both satisfy a condition.
    ///
    /// # Example
    ///
    /// Ignore an empty checkpoint name
    ///
    /// ```splitscript
    /// let hasCheckpoint = !checkpointName.isEmpty()
    /// ```
    @mustUse("The string emptiness result must be used.")
    fn isEmpty() -> bool {
        return self.byteLength() == 0
    }

    /// Tests whether this string contains an exact substring.
    ///
    /// Matching is case-sensitive over the UTF-8 text. An empty substring is
    /// contained in every string.
    ///
    /// # Example
    ///
    /// Recognize a level-name fragment
    ///
    /// ```splitscript
    /// let isBonusLevel = levelName.contains("Bonus")
    /// ```
    @intrinsic(StringContains)
    fn contains(
        /// The substring to search for.
        substring: String,
    ) -> bool;

    /// Finds the first exact substring and returns its UTF-8 byte offset.
    ///
    /// Returns `None` when the substring is absent. An empty substring is found
    /// at byte offset zero. Searching is allocation-free and case-sensitive.
    ///
    /// # Example
    ///
    /// Find a separator in an ASCII scene identifier
    ///
    /// ```splitscript
    /// let separator = sceneName.indexOf("_") else return
    /// ```
    @intrinsic(StringIndexOf)
    fn indexOf(
        /// The substring to search for.
        substring: String,
    ) -> u32?;

    /// Finds the last exact substring and returns its UTF-8 byte offset.
    ///
    /// Returns `None` when the substring is absent. An empty substring is found
    /// at the string's final byte boundary. Searching is allocation-free and
    /// case-sensitive.
    ///
    /// # Example
    ///
    /// Find the final separator in a path
    ///
    /// ```splitscript
    /// let separator = modulePath.lastIndexOf("/") else return
    /// ```
    @mustUse("The optional byte offset must be used.")
    @intrinsic(StringLastIndexOf)
    fn lastIndexOf(
        /// The substring to search for.
        substring: String,
    ) -> u32?;

    /// Tests whether this string starts with an exact prefix.
    ///
    /// Matching is case-sensitive over the UTF-8 text. Every string starts
    /// with the empty prefix.
    ///
    /// # Example
    ///
    /// Recognize challenge levels
    ///
    /// ```splitscript
    /// let isChallenge = levelName.startsWith("Challenge_")
    /// ```
    @intrinsic(StringStartsWith)
    fn startsWith(
        /// The prefix to compare.
        prefix: String,
    ) -> bool;

    /// Tests whether this string ends with an exact suffix.
    ///
    /// Matching is case-sensitive over the UTF-8 text. Every string ends with
    /// the empty suffix.
    ///
    /// # Example
    ///
    /// Recognize completed scene names
    ///
    /// ```splitscript
    /// let isCompleted = sceneName.endsWith("_Complete")
    /// ```
    @intrinsic(StringEndsWith)
    fn endsWith(
        /// The suffix to compare.
        suffix: String,
    ) -> bool;

    /// Compares two strings while ignoring ASCII letter case.
    ///
    /// Only `A` through `Z` and `a` through `z` are folded. All other UTF-8
    /// bytes must match exactly, so this operation is allocation-free and does
    /// not claim to implement Unicode case folding.
    ///
    /// # Example
    ///
    /// Match a process name with explicit ASCII semantics
    ///
    /// ```splitscript
    /// let isGame = processName.equalsIgnoreAsciiCase("Lunistice.exe")
    /// ```
    @intrinsic(StringEqualsIgnoreAsciiCase)
    fn equalsIgnoreAsciiCase(
        /// The string to compare.
        other: String,
    ) -> bool;

    /// Returns this string with ASCII uppercase letters converted to lowercase.
    ///
    /// Only `A` through `Z` are changed. Every other UTF-8 byte is preserved,
    /// so this operation does not claim to implement Unicode lowercasing. If
    /// the string contains no ASCII uppercase letters, the existing immutable
    /// string is reused without allocating.
    ///
    /// # Example
    ///
    /// Normalize an ASCII map identifier
    ///
    /// ```splitscript
    /// let map = mapName.toAsciiLowerCase()
    /// ```
    @mustUse("Strings are immutable; toAsciiLowerCase returns the normalized string and does not modify its receiver.")
    @intrinsic(StringToAsciiLowerCase)
    fn toAsciiLowerCase() -> String;

    /// Returns this string with ASCII lowercase letters converted to uppercase.
    ///
    /// Only `a` through `z` are changed. Every other UTF-8 byte is preserved,
    /// so this operation does not claim to implement Unicode uppercasing. If
    /// the string contains no ASCII lowercase letters, the existing immutable
    /// string is reused without allocating.
    ///
    /// # Example
    ///
    /// Normalize an ASCII mission identifier
    ///
    /// ```splitscript
    /// let mission = missionName.toAsciiUpperCase()
    /// ```
    @mustUse("Strings are immutable; toAsciiUpperCase returns the normalized string and does not modify its receiver.")
    @intrinsic(StringToAsciiUpperCase)
    fn toAsciiUpperCase() -> String;

    /// Removes ASCII whitespace from both ends of this string.
    ///
    /// ASCII space, tab, line feed, vertical tab, form feed, and carriage
    /// return are removed. Interior bytes and every non-ASCII character are
    /// preserved. If neither end changes, the existing immutable string is
    /// reused without allocating.
    ///
    /// # Example
    ///
    /// Clean a line read from a game log
    ///
    /// ```splitscript
    /// let eventName = line.trimAsciiWhitespace()
    /// ```
    @mustUse("Strings are immutable; trimAsciiWhitespace returns the trimmed string and does not modify its receiver.")
    @intrinsic(StringTrimAsciiWhitespace)
    fn trimAsciiWhitespace() -> String;

    /// Pads the beginning of this string to a minimum Unicode-scalar length.
    ///
    /// The original string is returned unchanged when it already contains at
    /// least `width` Unicode scalar values. Otherwise `fill` is repeated before
    /// it. This measures scalar values, not UTF-8 bytes or terminal columns.
    ///
    /// # Example
    ///
    /// Zero-pad a numeric identifier
    ///
    /// ```splitscript
    /// let identifier = "7".padStart(3, '0')
    /// ```
    @mustUse("Strings are immutable; padStart returns the padded string and does not modify its receiver.")
    @intrinsic(StringPadStart)
    fn padStart(
        /// The minimum number of Unicode scalar values in the result.
        width: u32,
        /// The character repeated before the original string.
        fill: char,
    ) -> String;

    /// Pads the end of this string to a minimum Unicode-scalar length.
    ///
    /// The original string is returned unchanged when it already contains at
    /// least `width` Unicode scalar values. Otherwise `fill` is repeated after
    /// it. This measures scalar values, not UTF-8 bytes or terminal columns.
    ///
    /// # Example
    ///
    /// Space-pad a diagnostic label
    ///
    /// ```splitscript
    /// let label = "Split".padEnd(9, ' ')
    /// ```
    @mustUse("Strings are immutable; padEnd returns the padded string and does not modify its receiver.")
    @intrinsic(StringPadEnd)
    fn padEnd(
        /// The minimum number of Unicode scalar values in the result.
        width: u32,
        /// The character repeated after the original string.
        fill: char,
    ) -> String;

    /// Replaces every exact, non-overlapping occurrence of a string.
    ///
    /// Matches are case-sensitive and selected from left to right. An empty
    /// search string returns an error because insertion between bytes would not
    /// preserve the UTF-8 string invariant. The result is allocated at its exact
    /// final byte length; an unrepresentable length also returns an error.
    ///
    /// # Example
    ///
    /// Normalize a scene-name separator
    ///
    /// ```splitscript
    /// let label = sceneName.replaceAll("_", " ") else sceneName
    /// ```
    @mustUse("Strings are immutable; replaceAll returns a new string and does not modify its receiver.")
    @intrinsic(StringReplaceAll)
    fn replaceAll(
        /// The non-empty string to find.
        search: String,
        /// The string inserted for every match.
        replacement: String,
    ) -> String!;

    /// Splits this string at every exact, non-overlapping delimiter.
    ///
    /// Matching is case-sensitive over UTF-8 text. Empty segments before,
    /// between, and after delimiters are preserved. An empty delimiter returns
    /// an error rather than defining insertion points between UTF-8 bytes.
    ///
    /// # Example
    ///
    /// Parse a structured level identifier
    ///
    /// ```splitscript
    /// let parts = "01_02_0".split("_") else []
    /// let chapter = parts[0]
    /// ```
    @mustUse("Strings are immutable; split returns the resulting string array.")
    @intrinsic(StringSplit)
    fn split(
        /// The non-empty delimiter removed between segments.
        delimiter: String,
    ) -> [String]!;

    /// Parses this string as an inferred numeric type.
    ///
    /// Parsing consumes the entire string and accepts only ASCII decimal text;
    /// surrounding whitespace and digit separators are errors. Integers allow
    /// an optional sign and are checked against the exact target width. Floats
    /// additionally allow a decimal point and `e` or `E` exponent. `NaN`,
    /// `inf`, and `Infinity` are accepted case-insensitively. Finite overflow
    /// produces signed infinity and underflow produces signed zero.
    ///
    /// # Example
    ///
    /// Parse a percentage read from process memory
    ///
    /// ```splitscript
    /// let percentage: f64 = percentageText.parse() else 0.0
    /// ```
    @intrinsic(StringParse)
    fn parse<T: Numeric>() -> T!;

    /// Returns the raw UTF-8 byte at an offset.
    ///
    /// The index uses the same zero-based byte offsets as `byteLength` and
    /// `slice`. Every in-range byte is observable, including a continuation
    /// byte within a multibyte code point. An out-of-range index returns an
    /// error.
    ///
    /// # Example
    ///
    /// Inspect a fixed-format ASCII identifier
    ///
    /// ```splitscript
    /// let separator = "map_01".byteAt(3) else 0
    /// if separator == 0x5f {
    ///     print("Found the separator")
    /// }
    /// ```
    @intrinsic(StringByteAt)
    fn byteAt(
        /// The zero-based UTF-8 byte offset.
        byteIndex: u32,
    ) -> u8!;

    /// Returns the Unicode character beginning at a UTF-8 byte offset.
    ///
    /// The index uses the same zero-based byte offsets as `byteLength` and
    /// `slice`, not JavaScript's UTF-16 code-unit indexes. The index must point
    /// to the first byte of a character. An out-of-range index or a
    /// continuation-byte index returns an error.
    ///
    /// # Example
    ///
    /// Inspect a non-ASCII character
    ///
    /// ```splitscript
    /// let sharpS = "Straße".charAt(4) else '\0'
    /// if sharpS == 'ß' {
    ///     print("Found sharp S")
    /// }
    /// ```
    @intrinsic(StringCharAt)
    fn charAt(
        /// The zero-based UTF-8 byte offset of the character's first byte.
        byteIndex: u32,
    ) -> char!;

    /// Extracts text between two UTF-8 byte offsets.
    ///
    /// The start index is inclusive and the end index is exclusive. Invalid,
    /// reversed, or out-of-range bounds return an error, as do offsets inside a
    /// multibyte code point. The result is newly allocated and can never contain
    /// more UTF-8 bytes than this string.
    ///
    /// # Example
    ///
    /// Extract a level-number component
    ///
    /// ```splitscript
    /// let prefix = "StraÃŸe".slice(0, 6) else "Unknown"
    /// ```
    @intrinsic(StringSlice)
    fn slice(
        /// The inclusive UTF-8 byte offset.
        start: u32,
        /// The exclusive UTF-8 byte offset.
        end: u32,
    ) -> String!;

    /// Concatenates an array of strings.
    ///
    /// A new WebAssembly GC string is allocated.
    ///
    /// # Example
    ///
    /// Join strings
    ///
    /// ```splitscript
    /// let label = String.concat(["Stage ", stageName])
    /// ```
    @intrinsic(StringConcat)
    static fn concat(
        /// The strings to concatenate in order.
        values: [String],
    ) -> String;

    /// Joins an array of strings with one separator between adjacent values.
    ///
    /// Empty and single-element arrays add no separators. The final string is
    /// allocated once after measuring every value and separator.
    ///
    /// # Example
    ///
    /// Format a route identifier
    ///
    /// ```splitscript
    /// let route = String.join(["chapter", "room", "exit"], ".")
    /// ```
    @mustUse("The joined string must be used.")
    @intrinsic(StringJoin)
    static fn join(
        /// The strings to join in order.
        values: [String],
        /// The string inserted between adjacent values.
        separator: String,
    ) -> String;
}

/// Stores a compiled process-memory signature.
///
/// Signature values are created by signature literals and consumed by scanning operations.
///
/// # Example
///
/// Scan for a machine-code marker
///
/// ```splitscript
/// let executable = await process.mainModule()
/// let markerAddress = await executable.scan(sig"48 8B ?? 89")
/// ```
@representation(scalar, i64)
@valueUsage(recordField, enumPayload, localVariable, globalVariable)
intrinsic type Signature {}

/// Identifies a signature selected by a multi-pattern memory scan.
///
/// # Example
///
/// Select a discovered memory layout
///
/// ```splitscript
/// let found = await process.scanMemoryAny([sig"48 8B ??", sig"48 89 ??"])
/// print(found.index)
/// ```
@representation(gcStruct, nullable)
@valueUsage(recordField, enumPayload, localVariable, globalVariable)
struct SignatureMatch {
    /// Address where the signature matched.
    ///
    /// # Example
    ///
    /// Read the matching address
    ///
    /// ```splitscript
    /// let found = await process.scanMemoryAny([sig"48 8B ??"])
    /// let marker = found.address
    /// ```
    address: address,
    /// Zero-based index in the supplied signature array.
    ///
    /// # Example
    ///
    /// Select the associated layout
    ///
    /// ```splitscript
    /// let found = await process.scanMemoryAny([sig"48 8B ??"])
    /// let layoutIndex = found.index
    /// ```
    index: u32,
}

/// Represents a precise span of time.
///
/// Durations carry normalized whole seconds and nanoseconds and are used for
/// LiveSplit game time. The nanosecond component is always between zero and
/// 999,999,999, including for negative durations.
///
/// # Example
///
/// Represent an exact delay
///
/// ```splitscript
/// let delay = Duration.fromWholeSeconds(2)
/// ```
@representation(gcStruct)
@valueUsage(recordField, enumPayload, stateField, localVariable, globalVariable)
@capabilities(Equatable)
struct Duration {
    /// Stores the whole-second component.
    private seconds: i64,

    /// Stores the fractional nanosecond component.
    private nanoseconds: i32,

    /// Constructs a zero-length duration.
    ///
    /// This is the neutral value for accumulated game time.
    ///
    /// # Example
    ///
    /// Initialize accumulated time
    ///
    /// ```splitscript
    /// let accumulated = Duration.zero()
    /// ```
    static fn zero() -> Duration {
        return Duration.fromParts(0, 0)
    }

    /// Constructs a duration from whole seconds.
    ///
    /// The signed value is preserved exactly without a floating-point
    /// conversion.
    ///
    /// # Example
    ///
    /// Convert an integer counter to game time
    ///
    /// ```splitscript
    /// return Duration.fromWholeSeconds(elapsedSeconds)
    /// ```
    static fn fromWholeSeconds(
        /// The signed number of elapsed whole seconds.
        seconds: i64,
    ) -> Duration {
        return Duration.fromParts(seconds, 0)
    }

    /// Constructs a duration from whole milliseconds without floating-point conversion.
    ///
    /// Negative values are preserved and the remainder is represented as
    /// nanoseconds without losing sub-second precision.
    ///
    /// # Example
    ///
    /// Convert milliseconds to game time
    ///
    /// ```splitscript
    /// return Duration.fromWholeMilliseconds(elapsedMilliseconds)
    /// ```
    static fn fromWholeMilliseconds(
        /// The signed number of elapsed milliseconds.
        milliseconds: i64,
    ) -> Duration {
        let seconds = milliseconds / 1_000
        let nanoseconds = ((milliseconds % 1_000) * 1_000_000) as i32
        return Duration.fromParts(seconds, nanoseconds)
    }

    /// Constructs a duration from a signed number of nanoseconds.
    ///
    /// Negative values retain their fractional component without passing
    /// through floating point.
    ///
    /// # Example
    ///
    /// Convert an exact nanosecond counter
    ///
    /// ```splitscript
    /// return Duration.fromNanoseconds(elapsedNanoseconds)
    /// ```
    static fn fromNanoseconds(
        /// The signed number of nanoseconds.
        nanoseconds: i64,
    ) -> Duration {
        let seconds = nanoseconds / 1_000_000_000
        let subsecondNanoseconds = (nanoseconds % 1_000_000_000) as i32
        return Duration.fromParts(seconds, subsecondNanoseconds)
    }

    /// Constructs a duration from floating-point milliseconds.
    ///
    /// Both f32 and f64 inputs are accepted. Use `fromWholeMilliseconds` when
    /// the source value is an integer and must not pass through floating point.
    ///
    /// # Example
    ///
    /// Convert a fractional millisecond counter to game time
    ///
    /// ```splitscript
    /// return Duration.fromMilliseconds(elapsedMilliseconds)
    /// ```
    static fn fromMilliseconds<T: Float>(
        /// Floating-point milliseconds. Both f32 and f64 are accepted.
        milliseconds: T,
    ) -> Duration {
        return Duration.fromSeconds(milliseconds / 1_000)
    }

    /// Constructs a duration from floating-point minutes.
    ///
    /// Both f32 and f64 inputs are accepted. Exact integer counters can be
    /// converted to whole seconds before calling `fromWholeSeconds`.
    ///
    /// # Example
    ///
    /// Convert a route timer measured in minutes
    ///
    /// ```splitscript
    /// return Duration.fromMinutes(elapsedMinutes)
    /// ```
    static fn fromMinutes<T: Float>(
        /// Floating-point minutes. Both f32 and f64 are accepted.
        minutes: T,
    ) -> Duration {
        return Duration.fromSeconds(minutes * 60)
    }

    /// Constructs a duration from floating-point hours.
    ///
    /// Both f32 and f64 inputs are accepted.
    ///
    /// # Example
    ///
    /// Construct a one-hour timeout
    ///
    /// ```splitscript
    /// return Duration.fromHours(1.0)
    /// ```
    static fn fromHours<T: Float>(
        /// Floating-point hours. Both f32 and f64 are accepted.
        hours: T,
    ) -> Duration {
        return Duration.fromSeconds(hours * 3_600)
    }

    /// Constructs a duration from floating-point days.
    ///
    /// Both f32 and f64 inputs are accepted. A day is exactly 86,400 seconds;
    /// calendar and time-zone rules are intentionally not involved.
    ///
    /// # Example
    ///
    /// Construct a multi-day sentinel
    ///
    /// ```splitscript
    /// return Duration.fromDays(2.0)
    /// ```
    static fn fromDays<T: Float>(
        /// Floating-point 24-hour days. Both f32 and f64 are accepted.
        days: T,
    ) -> Duration {
        return Duration.fromSeconds(days * 86_400)
    }

    /// Constructs a duration from frames.
    ///
    /// The conversion preserves whole seconds and nanoseconds.
    ///
    /// # Example
    ///
    /// Convert frames to game time
    ///
    /// ```splitscript
    /// return Duration.fromFrames(frameCount, 60)
    /// ```
    static fn fromFrames(
        /// The elapsed frame count.
        frames: i64,
        /// The frame rate.
        framesPerSecond: i64,
    ) -> Duration {
        let seconds = frames / framesPerSecond
        let nanoseconds = ((frames % framesPerSecond) * 1_000_000_000 / framesPerSecond) as i32
        return Duration.fromParts(seconds, nanoseconds)
    }

    /// Constructs a duration from seconds and nanoseconds.
    ///
    /// The two components become the runtime duration representation.
    ///
    /// # Example
    ///
    /// Construct an exact duration
    ///
    /// ```splitscript
    /// return Duration.fromParts(seconds, nanoseconds)
    /// ```
    static fn fromParts(
        /// Whole seconds.
        seconds: i64,
        /// The fractional nanoseconds.
        nanoseconds: i32,
    ) -> Duration {
        let normalizedSeconds = seconds + (nanoseconds / 1_000_000_000) as i64
        let normalizedNanoseconds = nanoseconds % 1_000_000_000
        if normalizedNanoseconds < 0 {
            return Duration {
                seconds: normalizedSeconds - 1,
                nanoseconds: normalizedNanoseconds + 1_000_000_000,
            }
        }
        return Duration {
            seconds: normalizedSeconds,
            nanoseconds: normalizedNanoseconds,
        }
    }

    /// Constructs a duration from floating-point seconds.
    ///
    /// Finite values are converted to the runtime duration representation; values outside its range are safely clamped.
    ///
    /// # Example
    ///
    /// Convert seconds to game time
    ///
    /// ```splitscript
    /// return Duration.fromSeconds(elapsedSeconds)
    /// ```
    static fn fromSeconds<T: Float>(
        /// Floating-point seconds. Both f32 and f64 are accepted.
        seconds: T,
    ) -> Duration {
        let integralSeconds = seconds.floor()
        let wholeSeconds = integralSeconds as i64
        let nanoseconds = ((seconds - integralSeconds) * 1_000_000_000) as i32
        return Duration.fromParts(wholeSeconds, nanoseconds)
    }

    /// Returns the normalized whole-second component.
    ///
    /// For negative fractional durations this is the mathematical floor. For
    /// example, negative 1.25 seconds has a whole-second component of -2.
    ///
    /// # Example
    ///
    /// Inspect an exact duration
    ///
    /// ```splitscript
    /// let seconds = elapsed.wholeSeconds()
    /// ```
    fn wholeSeconds() -> i64 {
        return self.seconds
    }

    /// Returns the normalized subsecond nanosecond component.
    ///
    /// The result is always between zero and 999,999,999.
    ///
    /// # Example
    ///
    /// Inspect subsecond precision
    ///
    /// ```splitscript
    /// let nanoseconds = elapsed.subsecondNanoseconds()
    /// ```
    fn subsecondNanoseconds() -> i32 {
        return self.nanoseconds
    }

    /// Returns the complete duration as floating-point seconds.
    ///
    /// The f64 result preserves nanosecond precision for ordinary autosplitter
    /// time spans but may round extremely large durations.
    ///
    /// # Example
    ///
    /// Compare elapsed time in seconds
    ///
    /// ```splitscript
    /// if elapsed.totalSeconds() >= 0.5 {
    ///     print("ready")
    /// }
    /// ```
    fn totalSeconds() -> f64 {
        return self.seconds as f64 + self.nanoseconds as f64 / 1_000_000_000
    }

    /// Returns the complete duration as floating-point milliseconds.
    ///
    /// The f64 result may round extremely large durations.
    ///
    /// # Example
    ///
    /// Measure a debounce interval
    ///
    /// ```splitscript
    /// if elapsed.totalMilliseconds() >= 250 {
    ///     print("ready")
    /// }
    /// ```
    fn totalMilliseconds() -> f64 {
        return self.seconds as f64 * 1_000 + self.nanoseconds as f64 / 1_000_000
    }

    /// Adds another duration and normalizes the result.
    ///
    /// The returned nanosecond component preserves the Duration invariant.
    ///
    /// # Example
    ///
    /// Accumulate two measured intervals
    ///
    /// ```splitscript
    /// let total = first.add(second)
    /// ```
    @operator(add)
    fn add(
        /// The duration to add.
        other: Duration,
    ) -> Duration {
        return Duration.fromParts(
            self.seconds + other.seconds,
            self.nanoseconds + other.nanoseconds
        )
    }

    /// Subtracts another duration and normalizes the result.
    ///
    /// Negative results retain their full subsecond precision.
    ///
    /// # Example
    ///
    /// Measure the difference between two durations
    ///
    /// ```splitscript
    /// let difference = current.subtract(previous)
    /// ```
    @operator(subtract)
    fn subtract(
        /// The duration to subtract.
        other: Duration,
    ) -> Duration {
        return Duration.fromParts(
            self.seconds - other.seconds,
            self.nanoseconds - other.nanoseconds
        )
    }

    /// Reports whether this duration is shorter than another duration.
    ///
    /// This method implements the `<` operator using the normalized whole and
    /// fractional components without converting to floating point.
    ///
    /// # Example
    ///
    /// Check whether a delay is still pending
    ///
    /// ```splitscript
    /// return elapsed < delay
    /// ```
    @operator(lessThan)
    fn lessThan(
        /// The duration to compare against.
        other: Duration,
    ) -> bool {
        return self.seconds < other.seconds
            || self.seconds == other.seconds && self.nanoseconds < other.nanoseconds
    }

    /// Reports whether this duration is no longer than another duration.
    ///
    /// This method implements the `<=` operator without converting to floating
    /// point.
    ///
    /// # Example
    ///
    /// Accept a duration at an inclusive limit
    ///
    /// ```splitscript
    /// return elapsed <= limit
    /// ```
    @operator(lessThanOrEqual)
    fn lessThanOrEqual(
        /// The duration to compare against.
        other: Duration,
    ) -> bool {
        return !self.greaterThan(other)
    }

    /// Reports whether this duration is longer than another duration.
    ///
    /// This method implements the `>` operator using the normalized whole and
    /// fractional components without converting to floating point.
    ///
    /// # Example
    ///
    /// Check whether a delayed split is ready
    ///
    /// ```splitscript
    /// return elapsed > delay
    /// ```
    @operator(greaterThan)
    fn greaterThan(
        /// The duration to compare against.
        other: Duration,
    ) -> bool {
        return self.seconds > other.seconds
            || self.seconds == other.seconds && self.nanoseconds > other.nanoseconds
    }

    /// Reports whether this duration is at least another duration.
    ///
    /// This method implements the `>=` operator without converting to floating
    /// point.
    ///
    /// # Example
    ///
    /// Trigger once a delay has elapsed
    ///
    /// ```splitscript
    /// return elapsed >= delay
    /// ```
    @operator(greaterThanOrEqual)
    fn greaterThanOrEqual(
        /// The duration to compare against.
        other: Duration,
    ) -> bool {
        return !self.lessThan(other)
    }
}

/// Identifies one reading of the runtime's monotonic clock.
///
/// Instants are suitable for elapsed-time measurements such as delayed splits
/// and debouncing. They are unrelated to calendar time and have no meaningful
/// absolute value.
///
/// # Example
///
/// Capture a monotonic timestamp
///
/// ```splitscript
/// let detectedAt: Instant = Instant.now()
/// ```
@representation(gcStruct)
@valueUsage(recordField, enumPayload, localVariable, globalVariable)
@capabilities(Equatable)
struct Instant {
    /// Stores the opaque monotonic timestamp in nanoseconds.
    private nanoseconds: i64,

    /// Reads the runtime's monotonic clock.
    ///
    /// Successive readings never move backwards while one runtime instance is
    /// active. The absolute value is intentionally not exposed.
    ///
    /// # Example
    ///
    /// Remember when an event occurred
    ///
    /// ```splitscript
    /// let detectedAt = Instant.now()
    /// ```
    @intrinsic(InstantNow)
    static fn now() -> Instant;

    /// Offsets this instant by a duration.
    ///
    /// This method implements `Instant + Duration`. Results before the
    /// monotonic clock's zero point clamp to zero, and results beyond the
    /// largest representable instant clamp to that maximum. The calculation
    /// preserves nanosecond precision and does not wrap.
    ///
    /// # Example
    ///
    /// Calculate a deadline
    ///
    /// ```splitscript
    /// let deadline = startedAt + Duration.fromMilliseconds(250)
    /// ```
    @mustUse("Instants are immutable; add returns the offset instant and does not modify its receiver.")
    @operator(add)
    fn add(
        /// The signed duration by which to offset the instant.
        duration: Duration,
    ) -> Instant {
        let currentSeconds = self.nanoseconds / 1_000_000_000
        let currentNanoseconds = self.nanoseconds % 1_000_000_000
        let durationSeconds = duration.wholeSeconds()

        if durationSeconds < 0 - currentSeconds - 1 {
            return Instant { nanoseconds: 0 }
        }
        if durationSeconds > 9_223_372_036 - currentSeconds {
            return Instant { nanoseconds: 9_223_372_036_854_775_807 }
        }

        let combinedNanoseconds = currentNanoseconds
            + duration.subsecondNanoseconds() as i64
        let resultSeconds = currentSeconds + durationSeconds
            + combinedNanoseconds / 1_000_000_000
        let resultNanoseconds = combinedNanoseconds % 1_000_000_000

        if resultSeconds < 0 {
            return Instant { nanoseconds: 0 }
        }
        if resultSeconds > 9_223_372_036
            || resultSeconds == 9_223_372_036
                && resultNanoseconds > 854_775_807
        {
            return Instant { nanoseconds: 9_223_372_036_854_775_807 }
        }
        return Instant {
            nanoseconds: resultSeconds * 1_000_000_000 + resultNanoseconds,
        }
    }

    /// Returns the elapsed duration since an earlier instant.
    ///
    /// The result is zero when `earlier` is later than the receiver, matching
    /// the saturating behavior expected for polling and debounce logic.
    ///
    /// # Example
    ///
    /// Measure between two clock readings
    ///
    /// ```splitscript
    /// let elapsed = finishedAt.durationSince(startedAt)
    /// ```
    fn durationSince(
        /// The earlier monotonic clock reading.
        earlier: Instant,
    ) -> Duration {
        if self.nanoseconds <= earlier.nanoseconds {
            return Duration.zero()
        }
        return Duration.fromNanoseconds(self.nanoseconds - earlier.nanoseconds)
    }

    /// Returns the duration elapsed since this instant.
    ///
    /// This is shorthand for reading the clock and calling `durationSince`.
    ///
    /// # Example
    ///
    /// Trigger after a debounce interval
    ///
    /// ```splitscript
    /// if detectedAt.elapsed().totalMilliseconds() >= 250 {
    ///     return true
    /// }
    /// ```
    fn elapsed() -> Duration {
        return Instant.now().durationSince(self)
    }

    /// Reports whether at least the requested duration has elapsed.
    ///
    /// This is the usual operation for delayed splits and debouncing. It reads
    /// the monotonic clock once and compares exact durations.
    ///
    /// # Example
    ///
    /// Wait for a delayed split
    ///
    /// ```splitscript
    /// return detectedAt.hasElapsed(Duration.fromMilliseconds(250))
    /// ```
    fn hasElapsed(
        /// The minimum duration that must have elapsed.
        delay: Duration,
    ) -> bool {
        return self.elapsed() >= delay
    }
}

/// Describes the native pointer width used by a process module.
///
/// Pointer width controls how deep pointer paths decode intermediate addresses.
///
/// # Example
///
/// Select a 64-bit pointer layout
///
/// ```splitscript
/// let pointerWidth = PointerSize.Bit64
/// ```
@representation(enum, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable, globalVariable)
@capabilities(Equatable)
enum PointerSize {
    /// Intermediate pointers contain 32-bit addresses.
    ///
    /// # Example
    ///
    /// Select 32-bit pointer decoding
    ///
    /// ```splitscript
    /// let pointerWidth = PointerSize.Bit32
    /// ```
    Bit32,

    /// Intermediate pointers contain 64-bit addresses.
    ///
    /// # Example
    ///
    /// Select 64-bit pointer decoding explicitly
    ///
    /// ```splitscript
    /// let nativeWidth = PointerSize.Bit64
    /// ```
    Bit64,
}

/// Selects the permissions required by a mapped-memory query.
///
/// The query may return ranges with additional permissions.
///
/// # Example
///
/// Require readable and writable memory
///
/// ```splitscript
/// let requiredAccess = MemoryRangeAccess.ReadWrite
/// ```
@representation(enum, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable, globalVariable)
@capabilities(Equatable)
enum MemoryRangeAccess {
    /// Requires readable memory.
    ///
    /// # Example
    ///
    /// Request readable memory
    ///
    /// ```splitscript
    /// let access = MemoryRangeAccess.Read
    /// ```
    Read,

    /// Requires readable and writable memory.
    ///
    /// # Example
    ///
    /// Request mutable emulated memory
    ///
    /// ```splitscript
    /// let access = MemoryRangeAccess.ReadWrite
    /// ```
    ReadWrite,

    /// Requires readable and executable memory.
    ///
    /// # Example
    ///
    /// Request executable code memory
    ///
    /// ```splitscript
    /// let access = MemoryRangeAccess.ReadExecute
    /// ```
    ReadExecute,
}

/// Describes one mapped process-memory range.
///
/// Values are snapshots of host mapping metadata discovered cooperatively.
///
/// # Example
///
/// Inspect a discovered mapping
///
/// ```splitscript
/// let emulatorRange = await process.findMemoryRange(0x48000, MemoryRangeAccess.ReadWrite)
/// ```
@representation(gcStruct, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable, globalVariable)
struct MemoryRange {
    /// Returns the first mapped address.
    ///
    /// # Example
    ///
    /// Read the mapping base
    ///
    /// ```splitscript
    /// let range = await process.findMemoryRange(0x48000, MemoryRangeAccess.ReadWrite) else return;
    /// let base = range.address
    /// ```
    address: address,

    /// Returns the mapped byte length.
    ///
    /// # Example
    ///
    /// Read the mapping size
    ///
    /// ```splitscript
    /// let range = await process.findMemoryRange(0x48000, MemoryRangeAccess.ReadWrite) else return;
    /// let bytes = range.size
    /// ```
    size: u64,

    /// Reports whether the range is readable.
    ///
    /// # Example
    ///
    /// Inspect read access
    ///
    /// ```splitscript
    /// let range = await process.findMemoryRange(0x48000, MemoryRangeAccess.ReadWrite) else return;
    /// let canRead = range.readable
    /// ```
    readable: bool,

    /// Reports whether the range is writable.
    ///
    /// # Example
    ///
    /// Inspect write access
    ///
    /// ```splitscript
    /// let range = await process.findMemoryRange(0x48000, MemoryRangeAccess.ReadWrite) else return;
    /// let canWrite = range.writable
    /// ```
    writable: bool,

    /// Reports whether the range is executable.
    ///
    /// # Example
    ///
    /// Inspect execute access
    ///
    /// ```splitscript
    /// let range = await process.findMemoryRange(0x48000, MemoryRangeAccess.ReadWrite) else return;
    /// let canExecute = range.executable
    /// ```
    executable: bool,
}

/// Describes a native pointer chain rooted at an address.
///
/// A path keeps version-specific pointer data separate from state polling and
/// resolves every intermediate pointer according to the executable's width.
///
/// # Example
///
/// Build a reusable pointer path
///
/// ```splitscript
/// let healthPath = 0x1000.memoryPath([0x20, 0x18], 0x8, PointerSize.Bit64)
/// ```
@representation(gcStruct, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable, globalVariable)
struct MemoryPath {
    /// Returns the address at which traversal starts.
    ///
    /// # Example
    ///
    /// Inspect a path's starting address
    ///
    /// ```splitscript
    /// let path = 0x1000.memoryPath([0x20], 0x8, PointerSize.Bit64)
    /// let start = path.base
    /// ```
    base: address,

    /// Returns the signed offsets that each end in an intermediate pointer read.
    ///
    /// # Example
    ///
    /// Inspect intermediate dereferences
    ///
    /// ```splitscript
    /// let path = 0x2000.memoryPath([0x30, 0x10], 0x4, PointerSize.Bit32)
    /// let offsets = path.dereferences
    /// ```
    dereferences: [i64],

    /// Returns the signed offset applied after the final pointer read.
    ///
    /// # Example
    ///
    /// Inspect a path's final offset
    ///
    /// ```splitscript
    /// let path = 0x3000.memoryPath([], 0x14, PointerSize.Bit64)
    /// let trailingOffset = path.finalOffset
    /// ```
    finalOffset: i64,

    /// Returns the native pointer width used during traversal.
    ///
    /// # Example
    ///
    /// Inspect a path's pointer width
    ///
    /// ```splitscript
    /// let path = 0x4000.memoryPath([0x40], 0, PointerSize.Bit32)
    /// let width = path.pointerSize
    /// ```
    pointerSize: PointerSize,

    /// Resolves the path against the attached process.
    ///
    /// Failed and null intermediate pointer reads propagate as a Result error.
    ///
    /// # Example
    ///
    /// Resolve a discovered path
    ///
    /// ```splitscript
    /// let healthAddress = health.resolve() else return
    /// ```
    fn resolve() -> address! {
        let current = self.base
        for offset in self.dereferences {
            let pointerAddress = current.offset(offset)
            current = match self.pointerSize {
                PointerSize.Bit32 => process.read<u32>(pointerAddress)? as address,
                PointerSize.Bit64 => process.read<u64>(pointerAddress)? as address
            }
        }
        return Ok(current.offset(self.finalOffset))
    }
}

/// A four-part numeric Windows executable version.
///
/// The components correspond to `major.minor.build.private` in a PE
/// `VS_FIXEDFILEINFO` resource. Keeping the parts typed avoids depending on
/// the inconsistent punctuation of legacy `FileVersionInfo` strings.
///
/// # Example
///
/// Compare a discovered version to a literal
///
/// ```splitscript
/// let supported = v"1.2.3.4" == v"1.2.3.4"
/// ```
@representation(gcStruct, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable, globalVariable)
@capabilities(Equatable, Display)
struct FileVersion {
    /// Major version component.
    ///
    /// # Example
    ///
    /// Read the major version
    ///
    /// ```splitscript
    /// let majorVersion = v"2.5.1.0".major
    /// ```
    major: u16,

    /// Minor version component.
    ///
    /// # Example
    ///
    /// Read the minor version
    ///
    /// ```splitscript
    /// let minorVersion = v"2.5.1.0".minor
    /// ```
    minor: u16,

    /// Build version component.
    ///
    /// # Example
    ///
    /// Read the build version
    ///
    /// ```splitscript
    /// let buildVersion = v"2.5.1.0".build
    /// ```
    build: u16,

    /// Private version component.
    ///
    /// # Example
    ///
    /// Read the private version
    ///
    /// ```splitscript
    /// let privateVersion = v"2.5.1.7".privatePart
    /// ```
    privatePart: u16,

    /// Constructs a numeric Windows file version from its four components.
    ///
    /// The `v"major.minor.build.private"` literal is the concise spelling for
    /// calls with constant components.
    ///
    /// # Example
    ///
    /// Construct a dynamically discovered version
    ///
    /// ```splitscript
    /// let version = FileVersion.fromParts(major, minor, build, privatePart)
    /// ```
    static fn fromParts(
        /// Major version component.
        major: u16,
        /// Minor version component.
        minor: u16,
        /// Build version component.
        build: u16,
        /// Private version component.
        privatePart: u16,
    ) -> FileVersion {
        return FileVersion {
            major: major,
            minor: minor,
            build: build,
            privatePart: privatePart,
        }
    }

    /// Formats the version as `major.minor.build.private`.
    ///
    /// This is the standard-library implementation of `Display`, so casts,
    /// interpolation, `print`, and `setVariable` all use the same spelling.
    ///
    /// # Example
    ///
    /// Format a discovered executable version explicitly
    ///
    /// ```splitscript
    /// let text = version.toString()
    /// ```
    @display
    fn toString() -> String {
        return `{self.major}.{self.minor}.{self.build}.{self.privatePart}`
    }
}

/// Describes a module loaded in the attached process.
///
/// A module exposes its base address and mapped size for bounded memory discovery.
///
/// # Example
///
/// Discover the main executable module
///
/// ```splitscript
/// let executable: Module = await process.mainModule()
/// ```
@representation(gcStruct, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable)
struct Module {
    /// Returns the module base address.
    ///
    /// # Example
    ///
    /// Read a discovered module's base address
    ///
    /// ```splitscript
    /// let executable = await process.mainModule()
    /// let baseAddress = executable.address
    /// ```
    address: address,

    /// Returns the mapped module size.
    ///
    /// # Example
    ///
    /// Read a discovered module's mapped size
    ///
    /// ```splitscript
    /// let executable = await process.mainModule()
    /// let mappedBytes = executable.size
    /// ```
    size: u64,

    /// The host module identity used for metadata queries.
    private name: String,

    /// Returns the module's host-provided filesystem path.
    ///
    /// The path uses the runtime's portable filesystem spelling. It is
    /// metadata only: SplitScript does not grant scripts unrestricted host
    /// filesystem access.
    ///
    /// # Example
    ///
    /// Inspect the executable path
    ///
    /// ```splitscript
    /// let executable = await process.mainModule()
    /// let path = executable.path() else "Unknown"
    /// ```
    @intrinsic(ModulePath)
    fn path() -> String!;

    /// Reads the numeric version from a Windows PE version resource.
    ///
    /// The parser validates the DOS and PE headers, follows the bounded
    /// resource-directory hierarchy, and verifies `VS_FIXEDFILEINFO` before
    /// returning its four numeric components. Missing resources, malformed
    /// images, and failed memory reads are ordinary errors.
    ///
    /// # Example
    ///
    /// Select a known executable version
    ///
    /// ```splitscript
    /// let version = executable.fileVersion() else return
    /// if version == v"1.2.3.4" {
    ///     print("recognized version 1.2.3.4")
    /// }
    /// ```
    fn fileVersion() -> FileVersion! {
        if process.read<u16>(self.address)? != 0x5a4d {
            throw "module does not have a DOS header"
        }

        let peOffset = process.read<u32>(self.address.add(0x3c))?
        let peHeader = self.address.add(peOffset as u64)
        if process.read<u32>(peHeader)? != 0x00004550 {
            throw "module does not have a PE header"
        }

        let optionalHeader = peHeader.add(0x18)
        let optionalMagic = process.read<u16>(optionalHeader)?
        if optionalMagic != 0x010b && optionalMagic != 0x020b {
            throw "module has an unsupported PE optional header"
        }
        let resourceDirectoryOffset: u64 = if optionalMagic == 0x010b {
            0x70
        } else {
            0x80
        }

        let resourceDirectory = process.read<[u32; 2]>(
            optionalHeader.add(resourceDirectoryOffset)
        )?
        let resourceRva = resourceDirectory[0]
        if resourceRva == 0 || resourceDirectory[1] == 0 {
            throw "module does not have a resource directory"
        }
        let resourceBase = self.address.add(resourceRva as u64)

        let typeHeader = process.read<[u16; 8]>(resourceBase)?
        let typeEntryCount = typeHeader[6] + typeHeader[7]
        let foundTypeDirectory: address? = None
        let typeIndex: u16 = 0
        while typeIndex < typeEntryCount {
            let entry = resourceBase.add(0x10 + (typeIndex as u64) * 8)
            let id = process.read<u32>(entry)?
            let offset = process.read<u32>(entry.add(4))?
            if id == 0x10 && offset & 0x8000_0000 != 0 {
                foundTypeDirectory = resourceBase.add((offset & 0x7fff_ffff) as u64)
                break
            }
            typeIndex += 1
        }
        let typeDirectory = foundTypeDirectory else return Err("module has no version resource")

        let nameHeader = process.read<[u16; 8]>(typeDirectory)?
        let nameEntryCount = nameHeader[6] + nameHeader[7]
        let foundLanguageDirectory: address? = None
        let nameIndex: u16 = 0
        while nameIndex < nameEntryCount {
            let entry = typeDirectory.add(0x10 + (nameIndex as u64) * 8)
            let offset = process.read<u32>(entry.add(4))?
            if offset & 0x8000_0000 != 0 {
                foundLanguageDirectory = resourceBase.add((offset & 0x7fff_ffff) as u64)
                break
            }
            nameIndex += 1
        }
        let languageDirectory = foundLanguageDirectory else return Err(
            "module version resource has no name directory"
        )

        let languageHeader = process.read<[u16; 8]>(languageDirectory)?
        let languageEntryCount = languageHeader[6] + languageHeader[7]
        let foundDataEntry: address? = None
        let languageIndex: u16 = 0
        while languageIndex < languageEntryCount {
            let entry = languageDirectory.add(0x10 + (languageIndex as u64) * 8)
            let offset = process.read<u32>(entry.add(4))?
            if offset & 0x8000_0000 == 0 {
                foundDataEntry = resourceBase.add(offset as u64)
                break
            }
            languageIndex += 1
        }
        let dataEntry = foundDataEntry else return Err(
            "module version resource has no language entry"
        )

        let versionRva = process.read<u32>(dataEntry)?
        let fixedInfo = self.address.add(versionRva as u64).add(0x28)
        if process.read<u32>(fixedInfo)? != 0xfeef_04bd {
            throw "module has invalid fixed file information"
        }
        let parts = process.read<[u16; 4]>(fixedInfo.add(8))?
        return FileVersion.fromParts(
            parts[1],
            parts[0],
            parts[3],
            parts[2]
        )
    }

    /// Determines the pointer width of a Windows PE module.
    ///
    /// The DOS, PE, and optional-header signatures are validated before the
    /// PE32 or PE32+ pointer width is returned. Unsupported binary formats and
    /// failed reads are returned as errors.
    ///
    /// # Example
    ///
    /// Inspect a module's pointer width
    ///
    /// ```splitscript
    /// let pointerSize = retry executable.pointerSize()
    /// ```
    fn pointerSize() -> PointerSize! {
        let dosMagic = process.read<u16>(self.address)?
        if dosMagic != 0x5a4d {
            throw "module does not have a DOS header"
        }

        let peOffset = process.read<u32>(self.address.add(0x3c))?
        let peHeader = self.address.add(peOffset as u64)
        let peMagic = process.read<u32>(peHeader)?
        if peMagic != 0x00004550 {
            throw "module does not have a PE header"
        }

        let optionalMagic = process.read<u16>(peHeader.add(0x18))?
        if optionalMagic == 0x010b {
            return Ok(PointerSize.Bit32)
        }
        if optionalMagic == 0x020b {
            return Ok(PointerSize.Bit64)
        }
        throw "module has an unsupported PE optional header"
    }

    /// Scans a module for a signature.
    ///
    /// The module's address and size define the scanned range. Large modules
    /// are scanned cooperatively across ticks so the autosplitter keeps
    /// yielding to the host.
    ///
    /// # Example
    ///
    /// Scan an entire module
    ///
    /// ```splitscript
    /// let marker = await gameAssembly.scan(sig"48 8B ?? 89")
    /// ```
    @intrinsic(ModuleScan)
    fn scan(
        /// The compiled signature pattern.
        signature: Signature,
    ) -> address;

    /// Scans the module for the first of several signatures.
    ///
    /// One signature is checked in one bounded window per update. The result
    /// identifies both the matching address and candidate index.
    ///
    /// # Example
    ///
    /// Select a module-specific layout
    ///
    /// ```splitscript
    /// let layout = await module.scanAny([sig"48 8B ??", sig"A1 ?? ??"])
    /// ```
    @intrinsic(ModuleScanAny)
    fn scanAny(
        /// Candidate patterns in priority order.
        signatures: [Signature],
    ) -> SignatureMatch;

    /// Reads a 32-bit relative address at an offset from this module.
    ///
    /// The encoded displacement is resolved relative to the instruction that
    /// follows it. Read failures are returned to the caller.
    ///
    /// # Example
    ///
    /// Resolve a module-relative address
    ///
    /// ```splitscript
    /// let target = retry gameAssembly.readRelative32(0x400)
    /// ```
    fn readRelative32(
        /// Byte offset from the module base.
        offset: u64,
    ) -> address! {
        return process.readRelative32(self.address.add(offset))
    }
}

/// Describes the current LiveSplit timer state.
///
/// Timer state is an exhaustive enum returned by timer.state().
///
/// # Example
///
/// Match the complete timer state
///
/// ```splitscript
/// let label = match timer.state() {
///     TimerState.NotRunning => "Not running",
///     TimerState.Running => "Running",
///     TimerState.Paused => "Paused",
///     TimerState.Ended => "Ended",
///     TimerState.Unknown => "Unknown"
/// }
/// ```
@representation(enum, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable, globalVariable)
@capabilities(Equatable)
enum TimerState {
    /// The timer has not started.
    ///
    /// # Example
    ///
    /// Detect a timer waiting to start
    ///
    /// ```splitscript
    /// let waiting = timer.state() == TimerState.NotRunning
    /// ```
    NotRunning,

    /// The timer is running.
    ///
    /// # Example
    ///
    /// Detect an active run
    ///
    /// ```splitscript
    /// let active = timer.state() == TimerState.Running
    /// ```
    Running,

    /// The timer is paused.
    ///
    /// # Example
    ///
    /// Detect a paused timer
    ///
    /// ```splitscript
    /// let paused = timer.state() == TimerState.Paused
    /// ```
    Paused,

    /// The timer has ended.
    ///
    /// # Example
    ///
    /// Detect a completed timer
    ///
    /// ```splitscript
    /// let complete = timer.state() == TimerState.Ended
    /// ```
    Ended,

    /// The host returned an unknown timer state.
    ///
    /// # Example
    ///
    /// Handle an unknown host state
    ///
    /// ```splitscript
    /// let unrecognized = timer.state() == TimerState.Unknown
    /// ```
    Unknown,
}

/// Describes an attached Unity IL2CPP runtime.
///
/// The runtime stores resolved metadata roots, its version, and pointer size.
///
/// # Example
///
/// Discover a typed Unity runtime
///
/// ```splitscript
/// let unityRuntime = await Unity.il2cpp(2020)
/// ```
@representation(gcStruct, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable)
struct UnityModule {
    /// Returns the IL2CPP assemblies metadata address.
    ///
    /// # Example
    ///
    /// Inspect the assemblies metadata root
    ///
    /// ```splitscript
    /// let runtime = await Unity.il2cpp(2020)
    /// let assembliesAddress = runtime.assemblies
    /// ```
    assemblies: address,

    /// Returns the IL2CPP type-information table address.
    ///
    /// # Example
    ///
    /// Inspect the type-information table
    ///
    /// ```splitscript
    /// let runtime = await Unity.il2cpp(2020)
    /// let typeInformation = runtime.typeInfoTable
    /// ```
    typeInfoTable: address,

    /// Returns the detected Unity metadata version.
    ///
    /// # Example
    ///
    /// Read the selected Unity layout version
    ///
    /// ```splitscript
    /// let runtime = await Unity.il2cpp(2020)
    /// let metadataVersion = runtime.version
    /// ```
    version: u32,

    /// Returns the attached process pointer size.
    ///
    /// # Example
    ///
    /// Read the Unity process pointer size
    ///
    /// ```splitscript
    /// let runtime = await Unity.il2cpp(2020)
    /// let unityPointerBytes = runtime.pointerSize
    /// ```
    pointerSize: u32,

    /// Finds an IL2CPP image.
    ///
    /// Suspends until the named image is discoverable.
    ///
    /// # Example
    ///
    /// Find a managed assembly
    ///
    /// ```splitscript
    /// let image = await unity.image("Assembly-CSharp")
    /// ```
    @intrinsic(UnityModuleImage)
    fn image(
        /// The managed assembly name.
        name: String,
    ) -> UnityImage;
}

/// Describes a Unity assembly image.
///
/// An image retains its owning Unity runtime for subsequent class lookup.
///
/// # Example
///
/// Discover a typed Unity image
///
/// ```splitscript
/// let runtime = await Unity.il2cpp(2020)
/// let assemblyImage = await runtime.image("Assembly-CSharp")
/// ```
@representation(gcStruct, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable)
struct UnityImage {
    /// Returns the Unity image address.
    ///
    /// # Example
    ///
    /// Inspect a Unity image address
    ///
    /// ```splitscript
    /// let runtime = await Unity.il2cpp(2020)
    /// let image = await runtime.image("Assembly-CSharp")
    /// let imageAddress = image.address
    /// ```
    address: address,

    /// Retains the owning Unity runtime.
    private module: UnityModule,

    /// Finds a class in an IL2CPP image.
    ///
    /// Suspends until the named class is discoverable.
    ///
    /// # Example
    ///
    /// Find a managed class
    ///
    /// ```splitscript
    /// let gameManager = await image.class("GameManager")
    /// ```
    @intrinsic(UnityImageClass)
    fn class(
        /// The managed class name.
        name: String,
    ) -> UnityClass;
}

/// Describes a Unity runtime class.
///
/// A class retains its owning Unity runtime for field and static-data discovery.
///
/// # Example
///
/// Discover a typed Unity class
///
/// ```splitscript
/// let runtime = await Unity.il2cpp(2020)
/// let image = await runtime.image("Assembly-CSharp")
/// let playerClass = await image.class("Player")
/// ```
@representation(gcStruct, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable)
struct UnityClass {
    /// Returns the Unity class address.
    ///
    /// # Example
    ///
    /// Inspect a Unity class address
    ///
    /// ```splitscript
    /// let runtime = await Unity.il2cpp(2020)
    /// let image = await runtime.image("Assembly-CSharp")
    /// let player = await image.class("Player")
    /// let classAddress = player.address
    /// ```
    address: address,

    /// Retains the owning Unity runtime.
    private module: UnityModule,

    /// Finds a managed field offset.
    ///
    /// Searches the class hierarchy and recognizes backing fields.
    ///
    /// # Example
    ///
    /// Find a field offset
    ///
    /// ```splitscript
    /// let healthOffset = await gameManager.field("health")
    /// ```
    @intrinsic(UnityClassField)
    fn field(
        /// The managed field name.
        name: String,
    ) -> u32;

    /// Finds the first matching field.
    ///
    /// Returns both the field offset and selected candidate index.
    ///
    /// # Example
    ///
    /// Try multiple field names
    ///
    /// ```splitscript
    /// let levelField = await gameManager.fieldAny(["currentLevel", "level"])
    /// ```
    @intrinsic(UnityClassFieldAny)
    fn fieldAny(
        /// Candidate field names in priority order.
        names: [String],
    ) -> UnityField;

    /// Finds a class's static-field table.
    ///
    /// Suspends until the static storage pointer is non-null.
    ///
    /// # Example
    ///
    /// Find static storage
    ///
    /// ```splitscript
    /// let staticTable = await gameManager.staticTable()
    /// ```
    @intrinsic(UnityClassStaticTable)
    fn staticTable() -> address;

    /// Finds a static singleton instance.
    ///
    /// Combines field discovery, static-table lookup, and a non-null pointer read.
    ///
    /// # Example
    ///
    /// Find a singleton instance
    ///
    /// ```splitscript
    /// let instance = await gameManager.staticInstance(["Instance", "_instance"])
    /// ```
    @intrinsic(UnityClassStaticInstance)
    fn staticInstance(
        /// Candidate singleton field names.
        names: [String],
    ) -> address;
}

/// Describes a Unity runtime field.
///
/// A field exposes its byte offset and metadata index.
///
/// # Example
///
/// Discover a typed Unity field
///
/// ```splitscript
/// let runtime = await Unity.il2cpp(2020)
/// let image = await runtime.image("Assembly-CSharp")
/// let player = await image.class("Player")
/// let healthField = await player.fieldAny(["health", "_health"])
/// ```
@representation(gcStruct, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable)
struct UnityField {
    /// Returns the instance-field byte offset.
    ///
    /// # Example
    ///
    /// Read a discovered field offset
    ///
    /// ```splitscript
    /// let runtime = await Unity.il2cpp(2020)
    /// let image = await runtime.image("Assembly-CSharp")
    /// let player = await image.class("Player")
    /// let field = await player.fieldAny(["health", "_health"])
    /// let healthOffset = field.offset
    /// ```
    offset: u32,

    /// Returns the metadata field index.
    ///
    /// # Example
    ///
    /// Read a discovered field index
    ///
    /// ```splitscript
    /// let runtime = await Unity.il2cpp(2020)
    /// let image = await runtime.image("Assembly-CSharp")
    /// let player = await image.class("Player")
    /// let field = await player.fieldAny(["level", "_level"])
    /// let levelFieldIndex = field.index
    /// ```
    index: u32,
}

/// Retains a discovered GBA emulator memory mapping.
///
/// The runtime-private mapping identifies the emulator backend and translates EWRAM and IWRAM addresses before each read.
///
/// # Example
///
/// Use the attached GBA memory provider
///
/// ```splitscript state GBA
/// let emulator: GbaEmulator = gba
/// ```
@representation(gcStruct, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable)
struct GbaEmulator {
    /// Identifies the emulator-specific memory layout.
    private backend: u32,

    /// Stores the discovered EWRAM base when it is stable.
    private ewram: address,

    /// Stores the discovered IWRAM base when it is stable.
    private iwram: address,

    /// Stores backend-specific discovery state.
    private aux1: address,

    /// Stores backend-specific discovery state.
    private aux2: address,

    /// Stores backend-specific discovery state.
    private aux3: address,

    /// Discovers the emulator's GBA memory mapping.
    ///
    /// `state GBA` invokes this automatically after attaching to one of the
    /// provider's supported processes.
    ///
    /// # Example
    ///
    /// Discover a GBA emulator mapping explicitly
    ///
    /// ```splitscript state GBA
    /// let emulator = await GbaEmulator.discover()
    /// ```
    static fn discover() -> GbaEmulator {
        let processName = process.name()

        if processName == "mGBA.exe" || processName == "mGBA" || processName == "EmuHawk.exe" {
            while true {
                let range = await process.findMemoryRange(
                    0x48000,
                    MemoryRangeAccess.ReadWrite,
                )
                while true {
                    let mapping = range else break
                    return GbaEmulator {
                        backend: 1,
                        ewram: mapping.address,
                        iwram: mapping.address.offset(0x40000),
                        aux1: 0,
                        aux2: 0,
                        aux3: 0,
                    }
                }
                await nextTick()
            }
        }

        if processName == "NO$GBA.EXE" {
            let matched = await process.scanMemory(sig"FF 35 ?? ?? ?? ?? 55")
            let basePointer = retry process.read<u32>(matched.offset(2))
            return GbaEmulator {
                backend: 4,
                ewram: 0,
                iwram: 0,
                aux1: basePointer as address,
                aux2: 0,
                aux3: 0,
            }
        }

        if processName == "visualboyadvance-m.exe" || processName == "VisualBoyAdvance.exe" {
            let emulatorModule = await process.mainModule()
            let found = await emulatorModule.scanAny([
                sig"48 8B 05 ?? ?? ?? ?? 81 E3 FF FF 03 00",
                sig"A1 ?? ?? ?? ?? 81 ?? FF FF 03 00",
                sig"81 E6 FF FF 03 00 8B 15 ?? ?? ?? ??",
            ])
            if found.index == 0 {
                let ewramInstruction = found.address.offset(3)
                let ewramPointer = retry process.readRelative32(ewramInstruction)
                let ewramOpcode = retry process.read<u8>(ewramInstruction.offset(10))
                if ewramOpcode == 0x48 {
                    ewramPointer = retry process.read<address>(ewramPointer)
                }

                let iwramMatch = await emulatorModule.scan(
                    sig"48 8B 05 ?? ?? ?? ?? 81 E3 FF 7F 00 00",
                )
                let iwramInstruction = iwramMatch.offset(3)
                let iwramPointer = retry process.readRelative32(iwramInstruction)
                let iwramOpcode = retry process.read<u8>(iwramInstruction.offset(10))
                if iwramOpcode == 0x48 {
                    iwramPointer = retry process.read<address>(iwramPointer)
                }
                return GbaEmulator {
                    backend: 3,
                    ewram: 0,
                    iwram: 0,
                    aux1: ewramPointer,
                    aux2: iwramPointer,
                    aux3: 0,
                }
            } else if found.index == 1 {
                let ewramPointer = retry process.read<u32>(found.address.offset(1))
                let iwramMatch = await emulatorModule.scan(
                    sig"A1 ?? ?? ?? ?? 81 ?? FF 7F 00 00",
                )
                let iwramPointer = retry process.read<u32>(iwramMatch.offset(1))
                return GbaEmulator {
                    backend: 2,
                    ewram: 0,
                    iwram: 0,
                    aux1: ewramPointer as address,
                    aux2: iwramPointer as address,
                    aux3: 0,
                }
            } else {
                let ewramPointer = retry process.read<u32>(found.address.offset(8))
                return GbaEmulator {
                    backend: 2,
                    ewram: 0,
                    iwram: 0,
                    aux1: ewramPointer as address,
                    aux2: (ewramPointer as address).offset(4),
                    aux3: 0,
                }
            }
        }

        if processName == "retroarch.exe" {
            let range = await process.findMemoryRange(
                0x48000,
                MemoryRangeAccess.ReadWrite,
            )
            while true {
                let mapping = range else break
                return GbaEmulator {
                    backend: 1,
                    ewram: mapping.address,
                    iwram: mapping.address.offset(0x40000),
                    aux1: 0,
                    aux2: 0,
                    aux3: 0,
                }
            }

            let found = await process.scanMemoryAny([
                sig"48 8B 05 ?? ?? ?? ?? 81 E1 FF FF 03 00",
                sig"A1 ?? ?? ?? ?? 81 ?? FF FF 03 00",
                sig"48 8B 15 ?? ?? ?? ?? 8B 42 40",
                sig"A3 ?? ?? ?? ?? F7 C5 02 00 00 00",
            ])
            if found.index >= 2 {
                let basePointer = if found.index == 2 {
                    retry process.readRelative32(found.address.offset(3))
                } else {
                    retry process.read<u32>(found.address.offset(1)) as address
                }
                let base: address = 0
                if found.index == 2 {
                    base = retry process.read<address>(basePointer)
                } else {
                    base = basePointer
                }
                let ewramMatch = await process.scanMemory(sig"25 FF FF 03 00 88 94 03")
                let ewramOffset = retry process.read<i32>(ewramMatch.offset(8))
                let iwramMatch = await process.scanMemory(sig"25 FE 7F 00 00 66 89 94 03")
                let iwramOffset = retry process.read<i32>(iwramMatch.offset(9))
                return GbaEmulator {
                    backend: 1,
                    ewram: base.offset(ewramOffset as i64),
                    iwram: base.offset(iwramOffset as i64),
                    aux1: 0,
                    aux2: 0,
                    aux3: 0,
                }
            }

            let ewramPointer: address = 0
            if found.index == 0 {
                let instruction = found.address.offset(3)
                let pointer = retry process.readRelative32(instruction)
                let opcode = retry process.read<u8>(instruction.offset(10))
                if opcode == 0x48 {
                    pointer = retry process.read<address>(pointer)
                }
                ewramPointer = pointer
            } else {
                ewramPointer = retry process.read<u32>(found.address.offset(1)) as address
            }
            let iwramMatch = if found.index == 0 {
                await process.scanMemory(
                    sig"48 8B 05 ?? ?? ?? ?? 81 E1 FF 7F 00 00",
                )
            } else {
                await process.scanMemory(sig"A1 ?? ?? ?? ?? 81 ?? FF 7F 00 00")
            }
            let iwramPointer: address = 0
            if found.index == 0 {
                let instruction = iwramMatch.offset(3)
                let pointer = retry process.readRelative32(instruction)
                let opcode = retry process.read<u8>(instruction.offset(10))
                if opcode == 0x48 {
                    pointer = retry process.read<address>(pointer)
                }
                iwramPointer = pointer
            } else {
                iwramPointer = retry process.read<u32>(iwramMatch.offset(1)) as address
            }
            return GbaEmulator {
                backend: if found.index == 0 { 3 } else { 2 },
                ewram: 0,
                iwram: 0,
                aux1: ewramPointer,
                aux2: iwramPointer,
                aux3: 0,
            }
        }

        if processName == "mednafen.exe" {
            let emulatorModule = await process.mainModule()
            let found = await emulatorModule.scanAny([
                sig"48 8B 05 ?? ?? ?? ?? 81 E1 FF FF 03 00",
                sig"A1 ?? ?? ?? ?? 81 ?? FF FF 03 00",
            ])
            let ewramPointer: address = 0
            if found.index == 0 {
                let instruction = found.address.offset(3)
                let pointer = retry process.readRelative32(instruction)
                let opcode = retry process.read<u8>(instruction.offset(10))
                if opcode == 0x48 {
                    pointer = retry process.read<address>(pointer)
                }
                ewramPointer = pointer
            } else {
                ewramPointer = retry process.read<u32>(found.address.offset(1)) as address
            }
            let iwramMatch = if found.index == 0 {
                await emulatorModule.scan(
                    sig"48 8B 05 ?? ?? ?? ?? 81 E1 FF 7F 00 00",
                )
            } else {
                await emulatorModule.scan(sig"A1 ?? ?? ?? ?? 81 ?? FF 7F 00 00")
            }
            let iwramPointer: address = 0
            if found.index == 0 {
                let instruction = iwramMatch.offset(3)
                let pointer = retry process.readRelative32(instruction)
                let opcode = retry process.read<u8>(instruction.offset(10))
                if opcode == 0x48 {
                    pointer = retry process.read<address>(pointer)
                }
                iwramPointer = pointer
            } else {
                iwramPointer = retry process.read<u32>(iwramMatch.offset(1)) as address
            }
            return GbaEmulator {
                backend: if found.index == 0 { 3 } else { 2 },
                ewram: 0,
                iwram: 0,
                aux1: ewramPointer,
                aux2: iwramPointer,
                aux3: 0,
            }
        }

        await process.closed()
        return GbaEmulator {
            backend: 0,
            ewram: 0,
            iwram: 0,
            aux1: 0,
            aux2: 0,
            aux3: 0,
        }
    }

    /// Reads a typed value from emulated GBA memory.
    ///
    /// The expected MemoryReadable type determines the byte layout. Valid reads lie entirely within EWRAM (0x02000000..0x02040000) or IWRAM (0x03000000..0x03008000).
    ///
    /// # Example
    ///
    /// Read an emulated value
    ///
    /// ```splitscript
    /// let room: u8 = gba.read(0x03000010) else 0
    /// ```
    @intrinsic(GbaEmulatorRead)
    fn read<T: MemoryReadable>(
        /// The original GBA hardware address.
        address: u32,
    ) -> T!;
}

/// Exercises the generic standard-library record pipeline.
///
/// This declaration exists only in tests and deliberately has no intrinsic implementation.
///
/// # Example
///
/// Read a probe record
///
/// ```splitscript
/// let probe: CatalogRecordProbe = process.read(0x100) else return
/// ```
@testOnly
@representation(gcStruct, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable)
@capabilities(Equatable, MemoryReadable)
struct CatalogRecordProbe {
    /// Returns the probe value.
    ///
    /// # Example
    ///
    /// Inspect a probe value
    ///
    /// ```splitscript
    /// let probeValue = probe.value
    /// ```
    value: u32,

    /// Builds the constructed-field test fixture.
    ///
    /// Preserves both constructed values through an ordinary source-defined
    /// standard-library body.
    ///
    /// # Example
    ///
    /// Build a constructed-field fixture
    ///
    /// ```splitscript
    /// let values = probe.constructed([3, 5], Some(8))
    /// ```
    fn constructed(
        /// Values stored by the fixture.
        values: [u64; 2],
        /// Optional fallback stored by the fixture.
        fallback: u32?,
    ) -> CatalogConstructedFieldProbe {
        return CatalogConstructedFieldProbe {
            values: values,
            fallback: fallback
        }
    }

    /// Preserves an exact two-element array through generic inference.
    ///
    /// Returns the same pair without widening it to an unsized array.
    ///
    /// # Example
    ///
    /// Keep a pair
    ///
    /// ```splitscript
    /// let pair = probe.fixedPair([3, 5])
    /// ```
    fn fixedPair<T>(
        /// Values stored in the pair.
        values: [T; 2],
    ) -> [T; 2] {
        return values
    }
}

/// Exercises constructed field types in standard-library records.
///
/// This declaration exists only in tests and verifies that catalog records use
/// the same array and wrapper type machinery as ordinary source records.
///
/// # Example
///
/// Store a constructed-field probe
///
/// ```splitscript
/// let fixture: CatalogConstructedFieldProbe = probe
/// ```
@testOnly
@representation(gcStruct, nullable)
@valueUsage(recordField, enumPayload, stateField, localVariable)
struct CatalogConstructedFieldProbe {
    /// Returns the stored values.
    ///
    /// # Example
    ///
    /// Inspect fixed values
    ///
    /// ```splitscript
    /// let fixedValues = fixture.values
    /// ```
    values: [u64; 2],

    /// Returns the optional fallback value.
    ///
    /// # Example
    ///
    /// Inspect an optional fallback
    ///
    /// ```splitscript
    /// let optionalFallback = fixture.fallback
    /// ```
    fallback: u32?,
}

/// Exercises fixed-array fields in structural process-memory layouts.
///
/// This declaration exists only in tests and verifies that catalog records
/// preserve an exact array length while deriving `MemoryReadable`.
///
/// # Example
///
/// Read a fixed-memory probe
///
/// ```splitscript
/// let memoryProbe: CatalogFixedMemoryProbe = process.read(0x200) else return
/// ```
@testOnly
@representation(gcStruct, nullable)
@valueUsage(localVariable)
@capabilities(MemoryReadable)
struct CatalogFixedMemoryProbe {
    /// Returns three adjacent native-endian values.
    ///
    /// # Example
    ///
    /// Inspect adjacent values
    ///
    /// ```splitscript
    /// let adjacentValues = memoryProbe.values
    /// ```
    values: [u16; 3],
}

/// Exercises derived suspension metadata for catalog-owned source bodies.
///
/// This declaration exists only in tests and verifies direct and transitive
/// suspension without adding an authored `async` marker.
///
/// # Example
///
/// Name the suspension fixture
///
/// ```splitscript
/// let fixtureName = "CatalogSuspensionProbe"
/// ```
@testOnly
@representation(gcStruct, nullable)
@valueUsage()
struct CatalogSuspensionProbe {
    /// Keeps the test fixture structurally representable.
    private marker: u8,

    /// Suspends through a trusted leaf operation.
    ///
    /// The body is classified from its resolved call rather than an authored
    /// async annotation.
    ///
    /// # Example
    ///
    /// Await the direct helper
    ///
    /// ```splitscript
    /// await CatalogSuspensionProbe.waitOneTick()
    /// ```
    static fn waitOneTick() -> None {
        await nextTick()
    }

    /// Suspends transitively through another source-defined helper.
    ///
    /// The callee's derived operation metadata propagates through the ordinary
    /// function call graph.
    ///
    /// # Example
    ///
    /// Await the transitive helper
    ///
    /// ```splitscript
    /// await CatalogSuspensionProbe.waitThroughHelper()
    /// ```
    static fn waitThroughHelper() -> None {
        await CatalogSuspensionProbe.waitOneTick()
    }
}
