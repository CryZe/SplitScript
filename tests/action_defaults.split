state "game.exe" {}

settings {
    "Enabled" => enabled: true
}

let explicitNull = false

setup {
    print(settings.enabled)
    setTickRate(42.0)
}

whileAttached {
    explicitNull = !explicitNull
}

start {}
split {}
reset {}
isLoading {
    if (explicitNull) {
        return None
    }
}
gameTime {
    if (explicitNull) {
        return None
    }
}
