state "game.exe" {}

let tick = 0

whileAttached {
    tick += 1
    if tick == 1 {
        let values: [u32] = []
        let alias = values
        values.push(10)
        values.push(20)
        values.push(30)
        values.push(40)
        values.push(50)
        alias.push(60)
        values.clear()
        alias.push(70)
        values.extend([80, 90])
        alias.extend(alias)
        let names = ["old", "stale"]
        let namesAlias = names
        names.clear()
        namesAlias.push("fresh")
        names.extend(["new", "more"])
        setVariable(
            "Array Push",
            `{values.length()},{alias.length()},{alias[3]},{values[5]},{names.length()},{namesAlias[2]}`,
        )
    }
}
