state "game.exe" {}

let tick = 0

whileAttached {
    tick += 1
    if tick == 1 {
        let values: [u32] = []
        let alias = values
        values.push(10)
        values.push(20)
        values.push(30)
        values.push(40)
        values.push(50)
        alias.push(60)
        values.clear()
        alias.push(70)
        values.extend([80, 90])
        alias.extend(alias)
        alias.removeAt(1)
        values.removeAt(3)
        alias.push(100)
        let names = ["old", "stale"]
        let namesAlias = names
        names.clear()
        namesAlias.push("fresh")
        names.extend(["new", "more"])
        namesAlias.removeAt(1)
        setVariable(
            "Array Push",
            `{values.length()},{alias.length()},{alias[1]},{values[3]},{values[4]},{names.length()},{namesAlias[1]}`,
        )
    }
}
