state "game.exe" {}

let tick = 0

whileAttached {
    tick += 1
    if tick == 1 {
        let values: [u32] = []
        let alias = values
        values.push(10)
        values.push(20)
        values.push(30)
        values.push(40)
        values.push(50)
        alias.push(60)
        values.clear()
        alias.push(70)
        values.extend([80, 90])
        alias.extend(alias)
        alias.removeAt(1)
        values.removeAt(3)
        alias.push(100)
        let last = values.pop() else 0
        alias.push(110)
        let removedFirst = values.remove(70)
        let removedMissing = alias.remove(999)
        values.push(120)
        let names = ["old", "stale"]
        let namesAlias = names
        names.clear()
        namesAlias.push("fresh")
        names.extend(["new", "more"])
        namesAlias.removeAt(1)
        let lastName = names.pop() else "missing"
        let removedName = namesAlias.remove("fresh")
        let removedMissingName = names.remove("missing")
        namesAlias.push("again")
        let empty: [u32] = []
        let missing = empty.pop()
        setVariable(
            "Array Push",
            `{values.length()},{alias.length()},{last},{values[0]},{values[1]},{values[3]},{values[4]},{removedFirst},{removedMissing},{names.length()},{lastName},{names[0]},{removedName},{removedMissingName},{missing == None}`,
        )
    }
}
