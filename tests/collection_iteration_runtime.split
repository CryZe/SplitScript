state "game.exe" {}

let tick = 0
let visited = Set.new<u32>()

whileAttached {
    tick += 1
    if tick == 1 {
        let values: [u32] = [1]
        let alias = values
        for value in values {
            alias.push(value + 1)
        }
    } else if tick == 2 {
        visited.clear()
        let _initialInsert = visited.insert(1)
        let alias = visited
        for value in visited {
            let _newInsert = alias.insert(value + 1)
        }
    } else if tick == 3 {
        visited.clear()
        let _secondInitialInsert = visited.insert(1)
        for value in visited {
            let _duplicateInsert = visited.insert(value)
            let _missingRemove = visited.remove(99)
        }

        let values: [u32] = [1]
        for value in values {
            values[0] = value + 1
        }
        setVariable("Collection Iteration", `{visited.length()},{values[0]}`)
    } else if tick == 4 {
        let values: [u32] = [1]
        let alias = values
        for _value in values {
            alias.clear()
        }
    }
}
