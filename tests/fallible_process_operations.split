state "game.exe" {
    nativeMap at 0x7000 as utf8(16);
    nativeWide at 0x7300 as utf16le(16);
}

fn addressState(value: address!) -> String {
    return match value {
        Ok(_) => "ok",
        Err(_) => "error",
    }
}

fn stringState(value: String!) -> String {
    return match value {
        Ok(_) => "ok",
        Err(_) => "error",
    }
}

whileAttached {
    let followed = process.follow(0x1000, [0i64]) else 0 as address
    let relative = process.readRelative32(0x3000) else 0 as address
    let managed = process.readManagedString(0x5000, 16) else "missing"
    let native = process.readUtf8(0x7000, 16) else "missing"
    let followFailure = addressState(process.follow(0x2000, [0i64]))
    let relativeFailure = addressState(process.readRelative32(0x4000))
    let stringFailure = stringState(process.readManagedString(0x6000, 16))
    let utf8Failure = stringState(process.readUtf8(0x7100, 16))
    let excessiveUtf8 = stringState(process.readUtf8(0x7200, 5_000))
    let nativeWide = process.readUtf16Le(0x7300, 16) else "missing"
    let replacementWide = process.readUtf16Le(0x7400, 4) else "missing"
    let utf16Failure = stringState(process.readUtf16Le(0x7500, 16))
    let excessiveUtf16 = stringState(process.readUtf16Le(0x7600, 2_049))
    setVariable(
        "Fallible Process Operations",
        `{followed},{relative},{managed},{followFailure},{relativeFailure},{stringFailure},{current.nativeMap},{native},{utf8Failure},{excessiveUtf8},{current.nativeWide},{nativeWide},{replacementWide},{utf16Failure},{excessiveUtf16}`,
    )
}
