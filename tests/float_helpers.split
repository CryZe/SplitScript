state "game.exe" {}

whileAttached {
    let passed = 0
    let sample32: f32 = -1.25
    let whole32: f32 = 2

    if sample32.abs() == 1.25
        && sample32.floor() == -2
        && sample32.ceil() == -1
        && whole32 == 2.0
    {
        passed += 1
    }

    let positiveHalf: f64 = 2.5
    let negativeHalf: f64 = -2.5
    if positiveHalf.round() == 2
        && negativeHalf.round() == -2
        && 3.5.round() == 4
        && (-3.5).round() == -4
        && 2.49.round() == 2
        && (-2.49).round() == -2
    {
        passed += 2
    }

    if 1.25.roundTo(1) == 1.2
        && (-1.25).roundTo(1) == -1.2
        && 12.375.roundTo(2) == 12.38
    {
        passed += 4
    }

    let zero: f64 = 0
    let nan = zero / zero
    let infinity = 1.0 / zero
    let exactInteger: f64 = 9_007_199_254_740_992
    if nan.isNaN()
        && !nan.isFinite()
        && !infinity.isNaN()
        && !infinity.isFinite()
        && infinity.roundTo(0) == infinity
        && nan.roundTo(0).isNaN()
        && sample32.isFinite()
        && exactInteger.isFinite()
    {
        passed += 8
    }

    let smallest32 = f32.fromBits(0x00000001)
    let negativeZero32 = f32.fromBits(0x80000000)
    let payloadNaN32 = f32.fromBits(0x7fc01234)
    let smallest64 = f64.fromBits(0x0000000000000001u64)
    let negativeZero64 = f64.fromBits(0x8000000000000000u64)
    let payloadNaN64 = f64.fromBits(0x7ff8000000001234u64)
    if smallest32 != 0
        && smallest32.toBits() == 0x00000001
        && negativeZero32 == 0
        && negativeZero32.toBits() == 0x80000000
        && payloadNaN32.isNaN()
        && payloadNaN32.toBits() == 0x7fc01234
        && smallest64 != 0
        && smallest64.toBits() == 0x0000000000000001u64
        && negativeZero64 == 0
        && negativeZero64.toBits() == 0x8000000000000000u64
        && payloadNaN64.isNaN()
        && payloadNaN64.toBits() == 0x7ff8000000001234u64
    {
        passed += 16
    }

    setVariable("Float Helpers", passed)
}
