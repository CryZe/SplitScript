state "game.exe" {}

let evaluations = 0

fn values() -> [i32; 5] {
    evaluations += 1
    return [1, 2, 3, 4, 5]
}

fn selectedSum(values: [i32]) -> i32 {
    let total = 0
    for value in values {
        if value == 2 {
            continue
        }
        if value == 5 {
            break
        }
        total += value
    }
    return total
}

onAttach {
    for name in ["first", "skip", "last"] {
        await nextTick()
        if name == "skip" {
            continue
        }
        print(name)
        if name == "last" {
            break
        }
    }
    print("async done")
}

whileAttached {
    let route = [1, 2, 3, 4, 5]
    let presentIndex = route.indexOf(4) else 99
    let missingIndex = route.indexOf(9) else 99
    setVariable(
        "For Loop",
        `{selectedSum(values())},{evaluations},{route.contains(4)},{route.contains(9)},{presentIndex},{missingIndex}`,
    )
}
