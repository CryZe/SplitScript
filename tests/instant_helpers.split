let detectedAt: Instant? = None

state "game.exe" {}

whileAttached {
    if detectedAt == None {
        detectedAt = Instant.now()
        return
    }

    let startedAt = detectedAt else return
    let finishedAt = Instant.now()
    let measured = finishedAt.durationSince(startedAt)
    let backwards = startedAt.durationSince(finishedAt)
    let quarterSecond = Duration.fromMilliseconds(250)
    let halfSecond = Duration.fromMilliseconds(500)
    let deadline: Instant = startedAt + quarterSecond
    let clampedLow = startedAt + Duration.fromWholeSeconds(-2)
    let nearMaximum = Instant.now()
    let clampedHigh = nearMaximum + Duration.fromNanoseconds(200)

    if startedAt != finishedAt
        && measured > Duration.zero()
        && measured >= quarterSecond
        && measured <= quarterSecond
        && backwards < measured
        && backwards == Duration.zero()
        && deadline.durationSince(startedAt) == quarterSecond
        && startedAt.durationSince(clampedLow) == Duration.fromWholeSeconds(1)
        && clampedHigh.durationSince(nearMaximum) == Duration.fromNanoseconds(100)
        && startedAt.hasElapsed(halfSecond)
    {
        setVariable("Instant Helpers", "ok")
    }
}
