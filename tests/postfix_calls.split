state "game.exe" {}

record Counter {
    value: u32,
}

let counterCalls = 0
let processCalls = 0

fn Counter.add(amount: u32) -> u32 {
    return self.value + amount
}

fn counter() -> Counter {
    counterCalls += 1
    return Counter {
        value: 40,
    }
}

fn optionalCounter() -> Counter? {
    return Counter {
        value: 38,
    }
}

fn attachedProcess() {
    processCalls += 1
    return process
}

whileAttached {
    let fromCall = counter().add(2)
    let fromLiteral = Counter {
        value: 41,
    }.add(1)
    let fromMatch = (match true {
        true => Counter {
            value: 39,
        },
        false => Counter {
            value: 0,
        },
    }).add(3)
    let fromFallback = (optionalCounter() else Counter {
        value: 0,
    }).add(4)
    let fromExplicitType = attachedProcess().read<u32>(0x100) else 0

    setVariable(
        "Postfix Calls",
        `{fromCall},{counterCalls},{fromLiteral},{fromMatch},{fromFallback},{fromExplicitType},{processCalls}`,
    )
}
