record LevelTimeParts {
    minutes: f32,
    seconds: f32,
    hundredths: f32,
}

state "game.exe" {
    first: i32 = process.read(0x1000);
    second: i32 = process.read(0x2000);
    combined: i32 = process.read(0x4000)? + process.read(0x5000)?;
    parts: LevelTimeParts = process.read(0x6000);
    optional: i32? = process.read<i32>(0x7000).toOption();
}

fn optionalText(value: i32?) -> String {
    return match value {
        Some(value) => value as String,
        None => "None",
    }
}

whileAttached {
    let probe: i32 = process.read(0x3000) else - 1
    setVariable(
        "Snapshot",
        `{old.first},{old.second},{old.combined},{old.parts.minutes as u32},{old.parts.seconds as u32},{old.parts.hundredths as u32},{optionalText(old.optional)}->{current.first},{current.second},{current.combined},{current.parts.minutes as u32},{current.parts.seconds as u32},{current.parts.hundredths as u32},{optionalText(current.optional)}:{probe}`,
    )
}
