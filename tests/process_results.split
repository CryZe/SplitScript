record LevelTimeParts {
    minutes: f32,
    seconds: f32,
    hundredths: f32,
}

state "game.exe" {
    first = process.read(0x1000);
    second = process.read(0x2000);
    combined = process.read(0x4000)? + process.read(0x5000)?;
    parts: LevelTimeParts = process.read(0x6000);
}

whileAttached {
    let probe: i32 = process.read(0x3000) else - 1
    setVariable(
        "Snapshot",
        `{old.first},{old.second},{old.combined},{old.parts.minutes as u32},{old.parts.seconds as u32},{old.parts.hundredths as u32}->{current.first},{current.second},{current.combined},{current.parts.minutes as u32},{current.parts.seconds as u32},{current.parts.hundredths as u32}:{probe}`,
    )
}
