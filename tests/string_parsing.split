state "game.exe" {
    dynamicText at 0x100 as utf8(1024);
    dynamicExpected: f64 at 0x500;
    dynamicValid: bool at 0x508;
    dynamicRadixUnsigned: u64 at 0x510;
    dynamicRadixSigned: i64 at 0x518;
    dynamicRadix: u32 at 0x520;
    dynamicRadixUsesSigned: bool at 0x524;
}

fn failed(value) {
    return match value {
        Ok(_) => false,
        Err(_) => true,
    }
}

whileAttached {
    let matches = 0

    let inferredInteger = "42".parse() else 0
    if inferredInteger == 42
        && ("+127".parse<i8>() else 0) == 127
        && ("-128".parse<i8>() else 0) == (-128i16 as i8)
    {
        matches += 1
    }

    let signedMinimum: i64 = "-9223372036854775808".parse() else 0
    if signedMinimum == (-9223372036854775807i64 - 1i64)
        && failed("128".parse<i8>())
        && failed("-129".parse<i8>())
        && failed("4294967296".parse<u32>())
    {
        matches += 2
    }

    let unsignedMaximum: u64 = "18446744073709551615".parse() else 0
    if unsignedMaximum == 18446744073709551615u64
        && failed("18446744073709551616".parse<u64>())
        && failed("-1".parse<u64>())
    {
        matches += 4
    }

    if failed("".parse<i32>())
        && failed("+".parse<i32>())
        && failed(" 1".parse<i32>())
        && failed("1 ".parse<i32>())
        && failed("1_000".parse<i32>())
        && failed("１２".parse<i32>())
        && failed("1.0".parse<i32>())
    {
        matches += 8
    }

    let percentage: f64 = "100.25".parse() else 0.0
    let exponent: f32 = "+1.25e2".parse() else 0.0
    let leadingDot: f64 = ".25".parse() else 0.0
    let trailingDot: f64 = "1.".parse() else 0.0
    let negative: f64 = "-0.5".parse() else 0.0
    if percentage == 100.25
        && exponent == 125.0
        && leadingDot == 0.25
        && trailingDot == 1.0
        && negative == -0.5
    {
        matches += 16
    }

    let nan = "NaN".parse<f64>() else 0.0
    let infinity = "+inFiNiTy".parse<f64>() else 0.0
    let overflow = "1.7976931348623159e308".parse<f64>() else 0.0
    let negativeInfinity = "-inf".parse<f32>() else 0.0
    let negativeZero = "-0".parse<f64>() else 1.0
    let negativeInfinity64 = "-Infinity".parse<f64>() else 0.0
    if nan != nan
        && infinity == overflow
        && negativeInfinity < 0.0
        && 1.0 / negativeZero == negativeInfinity64
        && failed("1e".parse<f64>())
        && failed("1.2.3".parse<f64>())
    {
        matches += 32
    }

    let underflow: f64 = "1e-9999".parse() else 1.0
    if underflow == 0.0 {
        matches += 64
    }

    let addressValue: address = "4294967296".parse() else 0
    if addressValue == 0x100000000 {
        matches += 128
    }

    // Exact halfway cases must use ties-to-even rather than intermediate
    // floating-point multiplication and double rounding.
    let halfway64: f64 = "1.00000000000000011102230246251565404236316680908203125".parse()
        else 0.0
    let aboveHalfway64: f64 =
        "1.00000000000000011102230246251565404236316680908203126".parse() else 0.0
    let halfway32: f32 = "1.000000059604644775390625".parse() else 0.0
    let aboveHalfway32: f32 = "1.000000059604644775390626".parse() else 0.0
    let minimumSubnormal32: f32 = "1.401298464324817e-45".parse() else 0.0
    let belowMinimumSubnormal32: f32 = "7.006492321624085e-46".parse() else 1.0
    let aboveMinimumSubnormal32: f32 = "7.006492321624086e-46".parse() else 0.0
    if halfway64 != 1.0
        || aboveHalfway64 != 1.0000000000000002
        || halfway32 != 1.0
        || aboveHalfway32 != 1.00000011920928955078125
        || minimumSubnormal32 != 1.401298464324817e-45
        || belowMinimumSubnormal32 != 0.0
        || aboveMinimumSubnormal32 != 1.401298464324817e-45
    {
        setVariable("String Parsing", -1)
        return
    }

    let dynamicMatches = match current.dynamicText.parse<f64>() {
        Ok(value) =>
        current.dynamicValid
            && if current.dynamicExpected != current.dynamicExpected {
                value != value
            } else {
                value == current.dynamicExpected
            },
        Err(_) => !current.dynamicValid,
    }
    setVariable("String Parsing Dynamic", dynamicMatches)

    let dynamicRadixResult = if current.dynamicRadixUsesSigned {
        current.dynamicRadixSigned.toString(current.dynamicRadix)
    } else {
        current.dynamicRadixUnsigned.toString(current.dynamicRadix)
    }
    let dynamicRadixText = match dynamicRadixResult {
        Ok(value) => value,
        Err(_) => "error",
    }
    setVariable("Integer Radix Dynamic", dynamicRadixText)

    let radixZero = 0u8.toString(2) else "error"
    let radixBinary = 255u8.toString(2) else "error"
    let radixHex = 255u16.toString(16) else "error"
    let radixNegative = (-128i16 as i8).toString(16) else "error"
    let radixMinimum = (-9223372036854775807i64 - 1i64).toString(16) else "error"
    let radixMaximum = 18446744073709551615u64.toString(36) else "error"
    let radixAddress = (0x1234 as address).toString(16) else "error"
    let radixUppercase = (0xabcdefu32.toString(16) else "error").toAsciiUpperCase()
    let radixErrors = failed(1u32.toString(1)) && failed(1u32.toString(37))
    setVariable(
        "Integer Radix",
        String.join(
            [
                radixZero,
                radixBinary,
                radixHex,
                radixNegative,
                radixMinimum,
                radixMaximum,
                radixAddress,
                radixUppercase,
                42 as String,
                radixErrors as String,
            ],
            ",",
        ),
    )

    setVariable("String Parsing", matches)
}
