state "game.exe" {}

whileAttached {
    let text = "Straße_Complete"
    let matches = 0

    if text.contains("raße") {
        matches += 1
    }
    if text.startsWith("Straße") {
        matches += 2
    }
    if text.endsWith("_Complete") {
        matches += 4
    }
    if text.contains("") && text.startsWith("") && text.endsWith("") {
        matches += 8
    }
    if !text.contains("STRASSE")
        && !text.startsWith("traße")
        && !text.endsWith("Complete!")
    {
        matches += 16
    }
    if !"short".contains("a longer value")
        && !"short".startsWith("a longer value")
        && !"short".endsWith("a longer value")
    {
        matches += 32
    }
    if (text.slice(1, 7) else "") == "traße" {
        matches += 64
    }
    if (text.slice(4, 4) else "missing") == "" {
        matches += 128
    }
    let reversedFailed = match text.slice(6, 5) {
        Ok(_) => false,
        Err(_) => true,
    }
    let outOfRangeFailed = match text.slice(0, 100) {
        Ok(_) => false,
        Err(_) => true,
    }
    if reversedFailed && outOfRangeFailed {
        matches += 256
    }
    let invalidStartBoundary = match text.slice(5, 7) {
        Ok(_) => false,
        Err(_) => true,
    }
    let invalidEndBoundary = match text.slice(1, 5) {
        Ok(_) => false,
        Err(_) => true,
    }
    if invalidStartBoundary && invalidEndBoundary {
        matches += 512
    }
    if "lUnIsTiCe.ExE".equalsIgnoreAsciiCase("LUNISTICE.EXE")
        && "CAFé".equalsIgnoreAsciiCase("café")
        && !"Straße".equalsIgnoreAsciiCase("STRASSE")
        && !"game.exe".equalsIgnoreAsciiCase("game-demo.exe")
    {
        matches += 1024
    }
    let emptySearchFailed = match "abc".replaceAll("", "-") {
        Ok(_) => false,
        Err(_) => true,
    }
    if ("cat cat".replaceAll("cat", "dog") else "") == "dog dog"
        && ("Straße Straße".replaceAll("ße", "X") else "") == "StraX StraX"
        && ("aaa".replaceAll("a", "🙂") else "") == "🙂🙂🙂"
        && ("aaa".replaceAll("aa", "b") else "") == "ba"
        && ("unchanged".replaceAll("missing", "value") else "") == "unchanged"
        && emptySearchFailed
    {
        matches += 2048
    }
    if "LUnIStIcE.ExE".toAsciiLowerCase() == "lunistice.exe"
        && "Straße CAFé".toAsciiLowerCase() == "straße café"
        && "already lower".toAsciiLowerCase() == "already lower"
    {
        matches += 4096
    }
    let levelParts = "01_02_0.dds".split(".") else []
    let identifiers = levelParts[0].split("_") else []
    let emptyParts = "_a__".split("_") else []
    let unicodeParts = "a🙂b🙂".split("🙂") else []
    let unchangedParts = "unchanged".split("_") else []
    let emptyDelimiterFailed = match "abc".split("") {
        Ok(_) => false,
        Err(_) => true,
    }
    if levelParts.length() == 2
        && levelParts[0] == "01_02_0"
        && levelParts[1] == "dds"
        && identifiers.length() == 3
        && identifiers[0] == "01"
        && identifiers[1] == "02"
        && identifiers[2] == "0"
        && emptyParts.length() == 4
        && emptyParts[0] == ""
        && emptyParts[1] == "a"
        && emptyParts[2] == ""
        && emptyParts[3] == ""
        && unicodeParts.length() == 3
        && unicodeParts[0] == "a"
        && unicodeParts[1] == "b"
        && unicodeParts[2] == ""
        && unchangedParts.length() == 1
        && unchangedParts[0] == "unchanged"
        && emptyDelimiterFailed
    {
        matches += 8192
    }

    setVariable("String Predicates", matches)
}
