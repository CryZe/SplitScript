state "game.exe" {}

whileAttached {
    let text = "Straße_Complete"
    let matches = 0

    if text.contains("raße") {
        matches += 1
    }
    if text.startsWith("Straße") {
        matches += 2
    }
    if text.endsWith("_Complete") {
        matches += 4
    }
    if text.contains("") && text.startsWith("") && text.endsWith("") {
        matches += 8
    }
    let missingIndex = match text.indexOf("Missing") {
        Some(_) => false,
        None => true,
    }
    if (text.indexOf("_") else 99) == 7
        && (text.indexOf("") else 99) == 0
        && missingIndex
    {
        matches += 32768
    }
    if !text.contains("STRASSE")
        && !text.startsWith("traße")
        && !text.endsWith("Complete!")
    {
        matches += 16
    }
    if !"short".contains("a longer value")
        && !"short".startsWith("a longer value")
        && !"short".endsWith("a longer value")
    {
        matches += 32
    }
    if (text.slice(1, 7) else "") == "traße" {
        matches += 64
    }
    if (text.slice(4, 4) else "missing") == "" {
        matches += 128
    }
    let reversedFailed = match text.slice(6, 5) {
        Ok(_) => false,
        Err(_) => true,
    }
    let outOfRangeFailed = match text.slice(0, 100) {
        Ok(_) => false,
        Err(_) => true,
    }
    if reversedFailed && outOfRangeFailed {
        matches += 256
    }
    let invalidStartBoundary = match text.slice(5, 7) {
        Ok(_) => false,
        Err(_) => true,
    }
    let invalidEndBoundary = match text.slice(1, 5) {
        Ok(_) => false,
        Err(_) => true,
    }
    if invalidStartBoundary && invalidEndBoundary {
        matches += 512
    }
    if "lUnIsTiCe.ExE".equalsIgnoreAsciiCase("LUNISTICE.EXE")
        && "CAFé".equalsIgnoreAsciiCase("café")
        && !"Straße".equalsIgnoreAsciiCase("STRASSE")
        && !"game.exe".equalsIgnoreAsciiCase("game-demo.exe")
    {
        matches += 1024
    }
    let emptySearchFailed = match "abc".replaceAll("", "-") {
        Ok(_) => false,
        Err(_) => true,
    }
    if ("cat cat".replaceAll("cat", "dog") else "") == "dog dog"
        && ("Straße Straße".replaceAll("ße", "X") else "") == "StraX StraX"
        && ("aaa".replaceAll("a", "🙂") else "") == "🙂🙂🙂"
        && ("aaa".replaceAll("aa", "b") else "") == "ba"
        && ("unchanged".replaceAll("missing", "value") else "") == "unchanged"
        && emptySearchFailed
    {
        matches += 2048
    }
    if "LUnIStIcE.ExE".toAsciiLowerCase() == "lunistice.exe"
        && "Straße CAFé".toAsciiLowerCase() == "straße café"
        && "already lower".toAsciiLowerCase() == "already lower"
    {
        matches += 4096
    }
    if "lUnIsTiCe.ExE".toAsciiUpperCase() == "LUNISTICE.EXE"
        && "already upper".toAsciiUpperCase() == "ALREADY UPPER"
        && "ALREADY UPPER".toAsciiUpperCase() == "ALREADY UPPER"
        && "café".toAsciiUpperCase() == "CAFé"
    {
        matches += 65536
    }
    let asciiWhitespace = String.concat([
        " \t\n",
        '\u{000b}' as String,
        '\u{000c}' as String,
        "\rMap_A \r\n",
    ])
    let nonBreakingSpace = '\u{00a0}' as String
    let nonAsciiPadded = String.concat([nonBreakingSpace, "Map", nonBreakingSpace])
    if asciiWhitespace.trimAsciiWhitespace() == "Map_A"
        && "already clean".trimAsciiWhitespace() == "already clean"
        && nonAsciiPadded.trimAsciiWhitespace() == nonAsciiPadded
        && " \t\r\n".trimAsciiWhitespace() == ""
    {
        matches += 131072
    }
    if "".isEmpty() && !"Map_A".isEmpty() {
        matches += 262144
    }
    let everyUnicodeWhitespace = String.concat([
        '\u{0009}' as String,
        '\u{000a}' as String,
        '\u{000b}' as String,
        '\u{000c}' as String,
        '\u{000d}' as String,
        '\u{0020}' as String,
        '\u{0085}' as String,
        '\u{00a0}' as String,
        '\u{1680}' as String,
        '\u{2000}' as String,
        '\u{2001}' as String,
        '\u{2002}' as String,
        '\u{2003}' as String,
        '\u{2004}' as String,
        '\u{2005}' as String,
        '\u{2006}' as String,
        '\u{2007}' as String,
        '\u{2008}' as String,
        '\u{2009}' as String,
        '\u{200a}' as String,
        '\u{2028}' as String,
        '\u{2029}' as String,
        '\u{202f}' as String,
        '\u{205f}' as String,
        '\u{3000}' as String,
    ])
    let mixedWhitespace = String.concat(["\t", '\u{00a0}' as String, "\n"])
    let whitespaceAroundText = String.concat([
        " ",
        '\u{2000}' as String,
        "x",
        '\u{3000}' as String,
    ])
    if "".isBlank()
        && everyUnicodeWhitespace.isBlank()
        && mixedWhitespace.isBlank()
        && !"not blank".isBlank()
        && !whitespaceAroundText.isBlank()
        && !('\u{0008}' as String).isBlank()
        && !('\u{000e}' as String).isBlank()
        && !('\u{001f}' as String).isBlank()
        && !('\u{0021}' as String).isBlank()
        && !('\u{0084}' as String).isBlank()
        && !('\u{0086}' as String).isBlank()
        && !('\u{009f}' as String).isBlank()
        && !('\u{00a1}' as String).isBlank()
        && !('\u{167f}' as String).isBlank()
        && !('\u{1681}' as String).isBlank()
        && !('\u{1fff}' as String).isBlank()
        && !('\u{200b}' as String).isBlank()
        && !('\u{2027}' as String).isBlank()
        && !('\u{202a}' as String).isBlank()
        && !('\u{202e}' as String).isBlank()
        && !('\u{2030}' as String).isBlank()
        && !('\u{205e}' as String).isBlank()
        && !('\u{2060}' as String).isBlank()
        && !('\u{2fff}' as String).isBlank()
        && !('\u{3001}' as String).isBlank()
    {
        matches += 4194304
    }
    if String.join(["chapter", "room", "exit"], ".") == "chapter.room.exit"
        && String.join([], "-") == ""
        && String.join(["only"], "-") == "only"
        && String.join(["a", "", "b"], "🙂") == "a🙂🙂b"
        && String.concat(["a", "b", "c"]) == "abc"
    {
        matches += 524288
    }
    let missingLastIndex = match "chapter/room/exit".lastIndexOf("missing") {
        Some(_) => false,
        None => true,
    }
    if ("chapter/room/exit".lastIndexOf("/") else 99) == 12
        && ("bananana".lastIndexOf("ana") else 99) == 5
        && ("Aé🙂".lastIndexOf("") else 99) == 7
        && ("é🙂é".lastIndexOf("é") else 99) == 6
        && missingLastIndex
    {
        matches += 1048576
    }
    if "7".padStart(3, '0') == "007"
        && "route".padEnd(7, ' ') == "route  "
        && "already wide".padStart(3, '0') == "already wide"
        && "é".padStart(3, '🙂') == "🙂🙂é"
        && "🙂".padEnd(3, 'é') == "🙂éé"
    {
        matches += 2097152
    }
    let levelParts = "01_02_0.dds".split(".") else []
    let identifiers = levelParts[0].split("_") else []
    let emptyParts = "_a__".split("_") else []
    let unicodeParts = "a🙂b🙂".split("🙂") else []
    let unchangedParts = "unchanged".split("_") else []
    let emptyDelimiterFailed = match "abc".split("") {
        Ok(_) => false,
        Err(_) => true,
    }
    if levelParts.length() == 2
        && levelParts[0] == "01_02_0"
        && levelParts[1] == "dds"
        && identifiers.length() == 3
        && identifiers[0] == "01"
        && identifiers[1] == "02"
        && identifiers[2] == "0"
        && emptyParts.length() == 4
        && emptyParts[0] == ""
        && emptyParts[1] == "a"
        && emptyParts[2] == ""
        && emptyParts[3] == ""
        && unicodeParts.length() == 3
        && unicodeParts[0] == "a"
        && unicodeParts[1] == "b"
        && unicodeParts[2] == ""
        && unchangedParts.length() == 1
        && unchangedParts[0] == "unchanged"
        && emptyDelimiterFailed
    {
        matches += 8192
    }
    let utf8 = "Aé🙂"
    let byteOutOfRange = match utf8.byteAt(7) {
        Ok(_) => false,
        Err(_) => true,
    }
    let continuationRejected = match utf8.charAt(2) {
        Ok(_) => false,
        Err(_) => true,
    }
    let endRejected = match utf8.charAt(7) {
        Ok(_) => false,
        Err(_) => true,
    }
    if utf8.byteLength() == 7
        && (utf8.byteAt(0) else 0) == 0x41
        && (utf8.byteAt(1) else 0) == 0xc3
        && (utf8.byteAt(2) else 0) == 0xa9
        && (utf8.byteAt(6) else 0) == 0x82
        && (utf8.charAt(0) else '\0') == 'A'
        && (utf8.charAt(1) else '\0') == 'é'
        && (utf8.charAt(3) else '\0') == '🙂'
        && ((utf8.charAt(3) else '\0') as u32) == 0x01f642
        && ('A' as String) == "A"
        && ((utf8.charAt(1) else '\0') as String) == "é"
        && ('€' as String) == "€"
        && ('\u{1f642}' as String) == "🙂"
        && `A character: {utf8.charAt(3) else '\0'}` == "A character: 🙂"
        && match utf8.charAt(1) else '\0' {
            'é' => true,
            _ => false,
        }
        && byteOutOfRange
        && continuationRejected
        && endRejected
    {
        matches += 16384
    }

    setVariable("String Predicates", matches)
}
