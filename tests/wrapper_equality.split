struct Wrapped {
    optional: i32?,
    result: i32!,
}

state "game.exe" {}

whileAttached {
    let score = 0

    let noneA: i32? = None
    let noneB: i32? = None
    let someA: i32? = 7
    let someB: i32? = 7
    let someOther: i32? = 8

    if noneA == noneB {
        score += 1
    }
    if noneA != someA {
        score += 1
    }
    if someA == someB {
        score += 1
    }
    if someA != someOther {
        score += 1
    }

    let successA: i32! = 7
    let successB: i32! = 7
    let successOther: i32! = 8
    let errorA: i32! = Err("boom")
    let errorB: i32! = Err("boom")
    let errorOther: i32! = Err("different")

    if successA == successB {
        score += 1
    }
    if successA != successOther {
        score += 1
    }
    if successA != errorA {
        score += 1
    }
    if errorA == errorB {
        score += 1
    }
    if errorA != errorOther {
        score += 1
    }

    let wrappedA = Wrapped {
        optional: someA, result: errorA
    }
    let wrappedB = Wrapped {
        optional: someB, result: errorB
    }
    let wrappedOther = Wrapped {
        optional: someOther, result: errorB
    }
    if wrappedA == wrappedB {
        score += 1
    }
    if wrappedA != wrappedOther {
        score += 1
    }

    setVariable("Wrapper Equality", score as String)
}
